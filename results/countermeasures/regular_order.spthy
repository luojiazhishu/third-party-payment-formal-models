lemma MS_PS_Response_Injective_Agreement [heuristic={default}]:
  all-traces
  "∀ ms ps r #i.
    (MS_Commit( 'MSAuthPS', ms, ps, r ) @ #i) ⇒
    (∃ #j.
      ((PS_Running( 'MSAuthPS', ps, ms, r ) @ #j) ∧ (#j < #i)) ∧
      (¬(∃ ms2 ps2 #i2.
          (MS_Commit( 'MSAuthPS', ms2, ps2, r ) @ #i2) ∧ (¬(#i2 = #i)))))"
/*
guarded formula characterizing all counter-examples:
"∃ ms ps r #i.
  (MS_Commit( 'MSAuthPS', ms, ps, r ) @ #i)
 ∧
  ∀ #j.
   (PS_Running( 'MSAuthPS', ps, ms, r ) @ #j)
  ⇒
   ((¬(#j < #i)) ∨
    (∃ ms2 ps2 #i2.
      (MS_Commit( 'MSAuthPS', ms2, ps2, r ) @ #i2) ∧ ¬(#i2 = #i)))"
*/
simplify
solve( MS_State( 'sendprepayid', ~session,
                 <$ms_id, $mf_id, $ps_id, $u_id, ~m_sk>
       ) ▶₃ #i )
  case MSSendPrepayidMF_case_1
  solve( SIn( 'MS-PS', ~session, $ps_id, $ms_id,
              <<~order_id, ~trade_id, amount>, sign(<~order_id, ~trade_id, amount>, x)>
         ) ▶₁ #i )
    case SecureChannelSendRecv
    solve( SOut( 'MS-PS', ~session, $ps_id, $ms_id,
                 <<~order_id, ~trade_id, amount>, sign(<~order_id, ~trade_id, amount>, x)>
           ) ▶₀ #vr.9 )
      case PSVerifyPasswordAndConfirmUMS_case_1
      solve( MS_State( 'sendprepayid', ~session.1,
                       <$ms_id.2, $mf_id.1, $ps_id.1, $u_id.2, ~m_sk.2>
             ) ▶₃ #i2 )
        case MSSendPrepayidMF_case_1
        solve( !PS_PubKey( pk(~p_sk) ) ▶₀ #i )
          case CreatePS
          solve( SOut( 'MF-PS', ~session, $mf_id, $ps_id,
                       <~prepay_id.3, $ms_id, sign(<~prepay_id.3, $ms_id>, ~m_sk), 
                        sign(<~prepay_id.3, $ms_id>, x.1)>
                 ) ▶₀ #vr.13 )
            case MFCallPS_case_1
            solve( SOut( 'MS-PS', ~session, $ms_id, $ps_id,
                         <pk(x.1), $ms_id, ~order_id.3, amount.1, description.3, 
                          sign(<$ms_id, ~order_id.3, amount.1, description.3>, ~m_sk)>
                   ) ▶₀ #vr.17 )
              case MSProcessOrderMF
              solve( SOut( 'MF-MS', ~session, $ms_id, $mf_id,
                           <~prepay_id.3, $ms_id, sign(<~prepay_id.3, $ms_id>, ~m_sk), 
                            sign(<~prepay_id.3, $ms_id>, ~ua_sk)>
                     ) ▶₀ #vr.26 )
                case MSSendPrepayidMF
                solve( SIn( 'MS-PS', ~session.1, $ps_id.1, $ms_id.1,
                            <<~order_id, ~trade_id, amount>, sign(<~order_id, ~trade_id, amount>, x)>
                       ) ▶₁ #i2 )
                  case SecureChannelSendRecv
                  solve( SOut( 'MS-PS', ~session.1, $ps_id.1, $ms_id.1,
                               <<~order_id, ~trade_id, amount>, sign(<~order_id, ~trade_id, amount>, x)>
                         ) ▶₀ #vr.29 )
                    case PSVerifyPasswordAndConfirmUMS
                    by contradiction /* from formulas */
                  qed
                next
                  case breakChannelIntegrity
                  by contradiction /* from formulas */
                qed
              next
                case breakChannelConfidentiality
                solve( SOut( 'MF-MS', ~session, $ms_id, $mf_id,
                             <~prepay_id.2, $ms_id, sign(<~prepay_id.2, $ms_id>, ~m_sk), 
                              sign(<~prepay_id.2, $ms_id>, ~ua_sk)>
                       ) ▶₀ #vr.29 )
                  case MSSendPrepayidMF
                  solve( SIn( 'MS-PS', ~session.1, $ps_id.1, $ms_id.1,
                              <<~order_id, ~trade_id, amount>, sign(<~order_id, ~trade_id, amount>, x)>
                         ) ▶₁ #i2 )
                    case SecureChannelSendRecv
                    solve( SOut( 'MS-PS', ~session.1, $ps_id.1, $ms_id.1,
                                 <<~order_id, ~trade_id, amount>, sign(<~order_id, ~trade_id, amount>, x)>
                           ) ▶₀ #vr.30 )
                      case PSVerifyPasswordAndConfirmUMS
                      by contradiction /* from formulas */
                    qed
                  next
                    case breakChannelIntegrity
                    by contradiction /* from formulas */
                  qed
                qed
              qed
            qed
          next
            case MFCallPS_case_2
            solve( !KU( sign(<~prepay_id.3, $ms_id>, ~m_sk) ) @ #vk.15 )
              case OrderCreateOracle
              solve( SOut( 'MS-PS', ~session, $ms_id, $ps_id,
                           <pk(x.1), $ms_id, ~order_id.3, amount.1, description.3, 
                            sign(<$ms_id, ~order_id.3, amount.1, description.3>, ~m_sk)>
                     ) ▶₀ #vr.16 )
                case MSProcessOrderMF
                solve( !KU( sign(<~prepay_id.2, $ms_id>, ~ua_sk) ) @ #vk.16 )
                  case breakChannelConfidentiality_case_1
                  solve( SOut( 'MF-MS', ~session.2, $ms_id, $dst,

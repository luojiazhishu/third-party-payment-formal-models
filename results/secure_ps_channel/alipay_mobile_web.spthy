    (∃ #j.
      ((PS_Running( 'MSAuthPS', ps, ms, r ) @ #j) ∧ (#j < #i)) ∧
      (¬(∃ ms2 ps2 #i2.
          (MS_Commit( 'MSAuthPS', ms2, ps2, r ) @ #i2) ∧ (¬(#i2 = #i)))))"
/*
guarded formula characterizing all counter-examples:
"∃ ms ps r #i.
  (MS_Commit( 'MSAuthPS', ms, ps, r ) @ #i)
 ∧
  ∀ #j.
   (PS_Running( 'MSAuthPS', ps, ms, r ) @ #j)

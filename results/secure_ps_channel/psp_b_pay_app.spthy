theory PSP_B_Pay_APP_Model begin

// Function signature and definition of the equational theory E

functions: calc_amt/1, fst/1, gen_desc/1, h/1, pair/2, pk/1, sdec/2,
           senc/2, sign/2, snd/1, true/0, verify/3
equations:
    fst(<x.1, x.2>) = x.1,
    sdec(senc(x.1, x.2), x.2) = x.1,
    snd(<x.1, x.2>) = x.2,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true

tactic: default
presort: S
prio: {id}
  regex".*Commit.*"
prio: {id}
  regex".*!KU\(.*m_sk.*"
prio: {id}
  regex".*m_sk.*"
prio: {id}
  regex".*_State.*"
prio: {id}
  regex".*sign.*"
prio: {id}
  regex".*BPS_PubKey.*"
prio: {id}
  regex".*SOut\(.*U-.*"
prio: {id}
  regex".*SOut\(.*-BPS.*"
prio: {id}
  regex".*SIn\(.*U-.*"
prio: {id}
  regex".*SIn\(.*-BPS.*"


tactic: typing
presort: S
prio: {id}
  regex".*!KU\(\s*sign.*"
prio: {id}
  regex".*SOURCE_.*"
prio: {id}
  regex".*BPS_PubKey.*"
prio: {id}
  regex".*SOut\(.*U-.*"
prio: {id}
  regex".*SOut\(.*-BPS.*"
prio: {id}
  regex".*SIn\(.*U-.*"
prio: {id}
  regex".*SIn\(.*-BPS.*"
prio: {id}
  regex".*_State.*"
deprio: {id}
  regex".*SOut*"
deprio: {id}
  regex".*SIn*"



heuristic: S







restriction OnlyOnceV:
  "∀ x #i #j. ((OnlyOnceV( x ) @ #i) ∧ (OnlyOnceV( x ) @ #j)) ⇒ (#i = #j)"
  // safety formula

restriction Equality:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

restriction Inequality:
  "∀ x #i. (Neq( x, x ) @ #i) ⇒ (⊥)"
  // safety formula

restriction InsecureChannel:
  "∀ ch_id #i. (InsecureChannel( ch_id ) @ #i) ⇒ (ch_id = 'MA-MS')"
  // safety formula

rule (modulo E) SecureChannelSendRecv[color=#f0f5e5]:
   [ SOut( ch_id, ~session, $src, $dst, msg ) ]
  --[ Neq( $src, $dst ) ]->
   [ SIn( ch_id, ~session, $src, $dst, msg ) ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) breakChannelConfidentiality[color=#fccb16]:
   [ SOut( ch_id, ~session, $src, $dst, msg ) ]
  --[
  OnlyOnceV( <$src, $dst, msg> ), BreakChannelCon( ch_id ),
  InsecureChannel( ch_id ),
  SOURCE_IN_FACT_BkChaCon( ch_id, ~session, $src, $dst, msg )
  ]->
   [ SOut( ch_id, ~session, $src, $dst, msg ), Out( <$src, $dst, msg> ) ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) breakChannelIntegrity[color=#f25a47]:
   [ In( <ch_id, ~session, $src, $dst, msg> ) ]
  --[
  BreakChannelInt( ch_id ), InsecureChannel( ch_id ),
  SOURCE_OUT_FACT_BkChaInt( ch_id, ~session, $src, $dst, msg )
  ]->
   [ SIn( ch_id, ~session, $src, $dst, msg ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) OrderCreateOracle[color=#f9d27d]:
   [
   Fr( ~nonce ), Fr( ~prepay_id ), Fr( ~out_trade_no ),
   In( <amount, description> ),
   !MerchantCreated( <$ms_id, ~app_id, ~mch_id, $notify_url, ~m_sk> )
   ]
  -->
   [
   Out( <~out_trade_no, ~app_id, ~mch_id, ~prepay_id, ~nonce, 
         sign(<~app_id, ~nonce, ~prepay_id>, ~m_sk)>
   ),
   !MS_Database( $ms_id, $attacker, ~prepay_id, amount, description,
                 ~out_trade_no
   ),
   !BPS_Database( $bps_id, ~prepay_id, amount, description, ~out_trade_no )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) PaymentQueryOracle[color=#f9d27d]:
   [
   In( ~prepay_id ),
   !BPS_Database( $bps_id, ~prepay_id, amount, description, ~out_trade_no )
   ]
  -->
   [ Out( <amount, description> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) CreateBPS[color=#c4c3f3]:
   [ Fr( ~w_sk ), Fr( ~key_APIv3 ) ]
  --[ OnlyOnceV( 'BPS' ) ]->
   [
   !BPS_PriKey( ~w_sk ), !BPS_PubKey( pk(~w_sk) ),
   !BPS_APIv3Key( ~key_APIv3 )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) CreateMA[color=#f3c3c7]:
   [ ]
  --[ OnlyOnceV( <'MA', $ma_id> ) ]->
   [ MA_State( 'created', 'null', $ma_id ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) CreateU[color=#c5f3c3]:
   [ Fr( ~password ) ]
  --[ OnlyOnceV( 'U' ) ]->
   [
   !UserRegistered( <$u_id, h(~password)> ),
   !UserPassword( <$u_id, ~password> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) CreateMS[color=#f3ccc3]:
   [ Fr( ~app_id ), Fr( ~mch_id ), Fr( ~m_sk ) ]
  --[ OnlyOnceV( <'MS', $ms_id> ) ]->
   [
   !MerchantCreated( <$ms_id, ~app_id, ~mch_id, $notify_url, ~m_sk> ),
   !MerchantRegistered( <$ms_id, ~app_id, ~mch_id, pk(~m_sk)> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) NewPaymentSession[color=#d0deaa]:
   [
   Fr( ~session ), !BPS_PriKey( ~w_sk ),
   !UserPassword( <$u_id, ~password> ),
   !MerchantCreated( <$ms_id, ~app_id, ~mch_id, $notify_url, ~m_sk> ),
   MA_State( 'created', 'null', $ma_id )
   ]
  --[ Start( ~session, $u_id, $ma_id, $ms_id, $bps_id ) ]->
   [
   U_State( 'init', ~session, <$u_id, $ma_id, $bps_id, $ms_id, ~password> ),
   MA_State( 'init', ~session, <$ma_id, $u_id, $ms_id, $bps_id> ),
   MS_State( 'init', ~session,
             <$ms_id, $ma_id, $bps_id, $u_id, $notify_url, ~app_id, ~mch_id, ~m_sk>
   ),
   BPS_State( 'init', ~session, <$bps_id, $u_id, $ma_id, $ms_id, ~w_sk> ),
   Out( ~session )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) UOpenAndOrderMA[role="U"]:
   [
   Fr( ~goods ),
   U_State( 'init', ~session, <$u_id, $ma_id, $bps_id, $ms_id, ~password> )
   ]
  -->
   [
   U_State( 'ordered', ~session,
            <$u_id, $ma_id, $bps_id, $ms_id, ~password, ~goods>
   ),
   SOut( 'U-MA', ~session, $u_id, $ma_id, <'OpenAppAndOrder', ~goods> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) MAOrderMS[role="MA"]:
   [
   SIn( 'U-MA', ~session, $u_id, $ma_id, <'OpenAppAndOrder', ~goods> ),
   MA_State( 'init', ~session, <$ma_id, $u_id, $ms_id, $bps_id> )
   ]
  --[ SOURCE_OUT_FACT_BkChaCon( 'MA-MS', ~session, $ma_id, $ms_id, ~goods )
  ]->
   [
   SOut( 'MA-MS', ~session, $ma_id, $ms_id, ~goods ),
   MA_State( 'ordered', ~session, <$ma_id, $u_id, $ms_id, $bps_id> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) MSProcessOrderBPS[role="MS"]:
   [
   SIn( 'MA-MS', ~session, $ma_id, $ms_id, ~goods ),
   MS_State( 'init', ~session,
             <$ms_id, $ma_id, $bps_id, $u_id, $notify_url, ~app_id, ~mch_id, ~m_sk>
   ),
   Fr( ~out_trade_no ), Fr( ~nonce )
   ]
  --[
  SOURCE_OUT_FACT_BkChaCon( 'MS-BPS', ~session, $ms_id, $bps_id,
                            <
                             <~mch_id, ~nonce, 
                              sign(<~nonce, ~app_id, ~mch_id, gen_desc(~goods), ~out_trade_no, 
                                    $notify_url, calc_amt(~goods)>,
                                   ~m_sk)
                             >, 
                             ~app_id, ~mch_id, gen_desc(~goods), ~out_trade_no, $notify_url, 
                             calc_amt(~goods)>
  ),
  SOURCE_OUT_FACT_M_SIGN( 'MS-BPS', ~session, $ms_id, $bps_id,
                          <
                           <~mch_id, ~nonce, 
                            sign(<~nonce, ~app_id, ~mch_id, gen_desc(~goods), ~out_trade_no, 
                                  $notify_url, calc_amt(~goods)>,
                                 ~m_sk)
                           >, 
                           ~app_id, ~mch_id, gen_desc(~goods), ~out_trade_no, $notify_url, 
                           calc_amt(~goods)>
  ),
  MS_Running( 'PSAuthMS', $ms_id, $bps_id,
              <~app_id, ~mch_id, gen_desc(~goods), ~out_trade_no, $notify_url, 
               calc_amt(~goods)>
  )
  ]->
   [
   SOut( 'MS-BPS', ~session, $ms_id, $bps_id,
         <
          <~mch_id, ~nonce, 
           sign(<~nonce, ~app_id, ~mch_id, gen_desc(~goods), ~out_trade_no, 
                 $notify_url, calc_amt(~goods)>,
                ~m_sk)
          >, 
          ~app_id, ~mch_id, gen_desc(~goods), ~out_trade_no, $notify_url, 
          calc_amt(~goods)>
   ),
   MS_State( 'OrderProcessed', ~session,
             <$ms_id, $ma_id, $bps_id, $u_id, $notify_url, ~app_id, ~mch_id, ~m_sk, 
              ~out_trade_no, ~goods>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) BPSSendPrepayidMS[role="BPS"]:
   [
   SIn( 'MS-BPS', ~session, $ms_id, $bps_id,
        <<~mch_id, ~nonce, m_sig>, ~app_id, ~mch_id, description, ~out_trade_no, 
         $notify_url, amount>
   ),
   BPS_State( 'init', ~session, <$bps_id, $u_id, $ma_id, $ms_id, ~w_sk> ),
   !MerchantRegistered( <$ms_id, ~app_id, ~mch_id, m_pk> ), Fr( ~prepay_id )
   ]
  --[
  Eq( verify(m_sig,
             <~nonce, ~app_id, ~mch_id, description, ~out_trade_no, $notify_url, 
              amount>,
             m_pk),
      true
  ),
  PS_Commit( 'PSAuthMS', $bps_id, $ms_id,
             <~app_id, ~mch_id, description, ~out_trade_no, $notify_url, amount>
  ),
  SOURCE_IN_FACT_M_SIGN( 'MS-BPS', ~session, $ms_id, $bps_id,
                         <<~mch_id, ~nonce, m_sig>, ~app_id, ~mch_id, description, ~out_trade_no, 
                          $notify_url, amount>
  )
  ]->
   [
   SOut( 'MS-BPS', ~session, $bps_id, $ms_id, ~prepay_id ),
   !BPS_Database( $bps_id, ~prepay_id, amount, description, ~out_trade_no ),
   BPS_State( 'sendprepayid', ~session,
              <$bps_id, $u_id, $ma_id, $ms_id, ~w_sk>
   )
   ]

  /*
  rule (modulo AC) BPSSendPrepayidMS[role="BPS"]:
     [
     SIn( 'MS-BPS', ~session, $ms_id, $bps_id,
          <<~mch_id, ~nonce, m_sig>, ~app_id, ~mch_id, description, ~out_trade_no, 
           $notify_url, amount>
     ),
     BPS_State( 'init', ~session, <$bps_id, $u_id, $ma_id, $ms_id, ~w_sk> ),
     !MerchantRegistered( <$ms_id, ~app_id, ~mch_id, m_pk> ), Fr( ~prepay_id )
     ]
    --[
    Eq( z, true ),
    PS_Commit( 'PSAuthMS', $bps_id, $ms_id,
               <~app_id, ~mch_id, description, ~out_trade_no, $notify_url, amount>
    ),
    SOURCE_IN_FACT_M_SIGN( 'MS-BPS', ~session, $ms_id, $bps_id,
                           <<~mch_id, ~nonce, m_sig>, ~app_id, ~mch_id, description, ~out_trade_no, 
                            $notify_url, amount>
    )
    ]->
     [
     SOut( 'MS-BPS', ~session, $bps_id, $ms_id, ~prepay_id ),
     !BPS_Database( $bps_id, ~prepay_id, amount, description, ~out_trade_no ),
     BPS_State( 'sendprepayid', ~session,
                <$bps_id, $u_id, $ma_id, $ms_id, ~w_sk>
     )
     ]
    variants (modulo AC)
    1. $notify_url
             = $notify_url.34
       ~app_id
             = ~app_id.36
       ~mch_id
             = ~mch_id.37
       ~nonce
             = ~nonce.38
       ~out_trade_no
             = ~out_trade_no.39
       amount
             = amount.43
       description
             = description.44
       m_pk  = m_pk.45
       m_sig = m_sig.46
       z     = verify(m_sig.46,
                      <~nonce.38, ~app_id.36, ~mch_id.37, description.44, ~out_trade_no.39, 
                       $notify_url.34, amount.43>,
                      m_pk.45)
    
    2. $notify_url
             = $notify_url.87
       ~app_id
             = ~app_id.89
       ~mch_id
             = ~mch_id.90
       ~nonce
             = ~nonce.91
       ~out_trade_no
             = ~out_trade_no.92
       amount
             = amount.96
       description
             = description.97
       m_pk  = pk(x.169)
       m_sig = sign(<~nonce.91, ~app_id.89, ~mch_id.90, description.97, 
                     ~out_trade_no.92, $notify_url.87, amount.96>,
                    x.169)
       z     = true
  */

rule (modulo E) MSSendPrepayidMA[role="MS"]:
   [
   SIn( 'MS-BPS', ~session, $bps_id, $ms_id, ~prepay_id ),
   MS_State( 'OrderProcessed', ~session,
             <$ms_id, $ma_id, $bps_id, $u_id, $notify_url, ~app_id, ~mch_id, ~m_sk, 
              ~out_trade_no, ~goods>
   ),
   Fr( ~nonce )
   ]
  --[
  SOURCE_OUT_FACT_BkChaCon( 'MA-MS', ~session, $ms_id, $ma_id,
                            <~out_trade_no, ~app_id, ~mch_id, ~prepay_id, ~nonce, 
                             sign(<~app_id, ~nonce, ~prepay_id>, ~m_sk)>
  ),
  MS_Running( 'UAuthMS', $ms_id, $u_id, ~prepay_id ),
  SOURCE_OUT_FACT_M_SIGN_2( 'MA-MS', ~session, $ms_id, $ma_id,
                            <~out_trade_no, ~app_id, ~mch_id, ~prepay_id, ~nonce, 
                             sign(<~app_id, ~nonce, ~prepay_id>, ~m_sk)>
  )
  ]->
   [
   SOut( 'MA-MS', ~session, $ms_id, $ma_id,
         <~out_trade_no, ~app_id, ~mch_id, ~prepay_id, ~nonce, 
          sign(<~app_id, ~nonce, ~prepay_id>, ~m_sk)>
   ),
   !MS_Database( $ms_id, $u_id, ~prepay_id, calc_amt(~goods),
                 gen_desc(~goods), ~out_trade_no
   ),
   MS_State( 'sendprepayid', ~session,
             <$ms_id, $ma_id, $bps_id, $u_id, $notify_url, ~app_id, ~mch_id, ~m_sk>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) MACallBPS[role="MA"]:
   [
   SIn( 'MA-MS', ~session, $ms_id, $ma_id,
        <~out_trade_no, ~app_id, ~mch_id, ~prepay_id, ~nonce, m_sig>
   ),
   MA_State( 'ordered', ~session, <$ma_id, $u_id, $ms_id, $bps_id> )
   ]
  --[
  Finish( 'MA', ~session, $ma_id ),
  SOURCE_OUT_FACT_BkChaCon( 'MA-BPS', ~session, $ma_id, $bps_id,
                            <~app_id, ~mch_id, ~prepay_id, ~nonce, m_sig>
  ),
  SOURCE_IN_FACT_M_SIGN_2( 'MA-MS', ~session, $ms_id, $ma_id,
                           <~out_trade_no, ~app_id, ~mch_id, ~prepay_id, ~nonce, m_sig>
  )
  ]->
   [
   SOut( 'MA-BPS', ~session, $ma_id, $bps_id,
         <~app_id, ~mch_id, ~prepay_id, ~nonce, m_sig>
   ),
   MA_State( 'called', ~session, <$ma_id, $u_id, $ms_id, $bps_id> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) BPSVerifyPaymentMA[role="BPS"]:
   [
   SIn( 'MA-BPS', ~session, $ma_id, $bps_id,
        <~app_id, ~mch_id, ~prepay_id, ~nonce, m_sig>
   ),
   !BPS_Database( $bps_id, ~prepay_id, amount, description, ~out_trade_no ),
   BPS_State( 'sendprepayid', ~session,
              <$bps_id, $u_id, $ma_id, $ms_id, ~w_sk>
   ),
   !MerchantRegistered( <$ms_id, ~app_id, ~mch_id, m_pk> )
   ]
  --[ Eq( verify(m_sig, <~app_id, ~nonce, ~prepay_id>, m_pk), true ) ]->
   [
   SOut( 'U-BPS', ~session, $bps_id, $u_id,
         <'SReqPwd', amount, description, ~prepay_id>
   ),
   BPS_State( 'waitpwd', ~session,
              <$bps_id, $u_id, $ma_id, $ms_id, ~w_sk, ~prepay_id, ~out_trade_no, 
               amount, description>
   )
   ]

  /*
  rule (modulo AC) BPSVerifyPaymentMA[role="BPS"]:
     [
     SIn( 'MA-BPS', ~session, $ma_id, $bps_id,
          <~app_id, ~mch_id, ~prepay_id, ~nonce, m_sig>
     ),
     !BPS_Database( $bps_id, ~prepay_id, amount, description, ~out_trade_no ),
     BPS_State( 'sendprepayid', ~session,
                <$bps_id, $u_id, $ma_id, $ms_id, ~w_sk>
     ),
     !MerchantRegistered( <$ms_id, ~app_id, ~mch_id, m_pk> )
     ]
    --[ Eq( z, true ) ]->
     [
     SOut( 'U-BPS', ~session, $bps_id, $u_id,
           <'SReqPwd', amount, description, ~prepay_id>
     ),
     BPS_State( 'waitpwd', ~session,
                <$bps_id, $u_id, $ma_id, $ms_id, ~w_sk, ~prepay_id, ~out_trade_no, 
                 amount, description>
     )
     ]
    variants (modulo AC)
    1. ~app_id
             = ~app_id.33
       ~nonce
             = ~nonce.35
       ~prepay_id
             = ~prepay_id.37
       m_pk  = m_pk.42
       m_sig = m_sig.43
       z     = verify(m_sig.43, <~app_id.33, ~nonce.35, ~prepay_id.37>, m_pk.42)
    
    2. ~app_id
             = ~app_id.100
       ~nonce
             = ~nonce.102
       ~prepay_id
             = ~prepay_id.104
       m_pk  = pk(x.194)
       m_sig = sign(<~app_id.100, ~nonce.102, ~prepay_id.104>, x.194)
       z     = true
  */

rule (modulo E) USubmitPasswordBPS[role="U"]:
   [
   U_State( 'ordered', ~session,
            <$u_id, $ma_id, $bps_id, $ms_id, ~password, ~goods>
   ),
   SIn( 'U-BPS', ~session, $bps_id, $u_id,
        <'SReqPwd', calc_amt(~goods), gen_desc(~goods), ~prepay_id>
   ),
   !UserPassword( <$u_id, ~password> )
   ]
  --[
  UserInputPwd( $u_id, ~password, ~session ),
  U_Commit( 'UAuthMS', $u_id, $ms_id, ~prepay_id )
  ]->
   [
   SOut( 'U-BPS', ~session, $u_id, $bps_id, ~password ),
   U_State( 'pwdsubmitted', ~session,
            <$u_id, $ma_id, $bps_id, $ms_id, ~password, ~goods>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) BPSVerifyPasswordAndConfirmUMS[role="BPS"]:
   [
   SIn( 'U-BPS', ~session, $u_id, $bps_id, ~password ),
   BPS_State( 'waitpwd', ~session,
              <$bps_id, $u_id, $ma_id, $ms_id, ~w_sk, ~prepay_id, ~out_trade_no, 
               amount, description>
   ),
   !UserRegistered( <$u_id, h(~password)> ),
   !MerchantRegistered( <$ms_id, ~app_id, ~mch_id, m_pk> ),
   !BPS_APIv3Key( ~key_APIv3 ), Fr( ~transaction_id ), Fr( ~nonce_enc ),
   Fr( ~summary ), Fr( ~id ), Fr( ~nonce_sig )
   ]
  --[
  PS_Running( 'MSAuthPS', $bps_id, $ms_id,
              <~id, 
               senc(<~app_id, ~mch_id, ~out_trade_no, ~transaction_id, amount, 
                     ~nonce_enc>,
                    ~key_APIv3), 
               ~nonce_enc, ~summary>
  ),
  PS_Running( 'UAuthPS', $bps_id, $u_id, <amount, description> ),
  PaymentComplete( $u_id, h(~password), ~session )
  ]->
   [
   SOut( 'U-BPS', ~session, $bps_id, $u_id,
         <'PaymentSuccessful', amount, description>
   ),
   SOut( 'MS-BPS', ~session, $bps_id, $notify_url,
         <
          <~id, 
           senc(<~app_id, ~mch_id, ~out_trade_no, ~transaction_id, amount, 
                 ~nonce_enc>,
                ~key_APIv3), 
           ~nonce_enc, ~summary>, 
          sign(<
                <~id, 
                 senc(<~app_id, ~mch_id, ~out_trade_no, ~transaction_id, amount, 
                       ~nonce_enc>,
                      ~key_APIv3), 
                 ~nonce_enc, ~summary>, 
                ~nonce_sig>,
               ~w_sk), 
          ~nonce_sig>
   ),
   BPS_State( 'paysuccess', ~session,
              <$bps_id, $u_id, $ma_id, $ms_id, ~w_sk, ~prepay_id>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) UReceiveNotification[role="U"]:
   [
   SIn( 'U-BPS', ~session, $bps_id, $u_id,
        <'PaymentSuccessful', calc_amt(~goods), gen_desc(~goods)>
   ),
   U_State( 'pwdsubmitted', ~session,
            <$u_id, $ma_id, $bps_id, $ms_id, ~password, ~goods>
   )
   ]
  --[
  Finish( 'U', ~session, $u_id ),
  U_Commit( 'UAuthPS', $u_id, $bps_id, <calc_amt(~goods), gen_desc(~goods)>
  )
  ]->
   [
   U_State( 'completed', ~session,
            <$u_id, $ma_id, $bps_id, $ms_id, ~password, ~goods>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) MSReceiveNotification[role="MS"]:
   [
   MS_State( 'sendprepayid', ~session,
             <$ms_id, $ma_id, $bps_id, $u_id, $notify_url, ~app_id, ~mch_id, ~m_sk>
   ),
   !MS_Database( $ms_id, $user, ~prepay_id, amount, description,
                 ~out_trade_no
   ),
   SIn( 'MS-BPS', ~session, $bps_id, $notify_url,
        <
         <~id, 
          senc(<~app_id, ~mch_id, ~out_trade_no, ~transaction_id, amount, 
                ~nonce_enc>,
               ~key_APIv3), 
          ~nonce_enc, ~summary>, 
         res_sign, ~nonce_sig>
   ),
   !BPS_APIv3Key( ~key_APIv3 ), !BPS_PubKey( w_pk )
   ]
  --[
  Eq( verify(res_sign,
             <
              <~id, 
               senc(<~app_id, ~mch_id, ~out_trade_no, ~transaction_id, amount, 
                     ~nonce_enc>,
                    ~key_APIv3), 
               ~nonce_enc, ~summary>, 
              ~nonce_sig>,
             w_pk),
      true
  ),
  Finish( 'MS', ~session, $ms_id ),
  MS_Commit( 'MSAuthPS', $ms_id, $bps_id,
             <~id, 
              senc(<~app_id, ~mch_id, ~out_trade_no, ~transaction_id, amount, 
                    ~nonce_enc>,
                   ~key_APIv3), 
              ~nonce_enc, ~summary>
  )
  ]->
   [
   SOut( 'MS-BPS', ~session, $notify_url, $bps_id, 'Successful' ),
   MS_State( 'completed', ~session,
             <$ms_id, $ma_id, $bps_id, $u_id, $notify_url, ~app_id, ~mch_id, ~m_sk>
   )
   ]

  /*
  rule (modulo AC) MSReceiveNotification[role="MS"]:
     [
     MS_State( 'sendprepayid', ~session,
               <$ms_id, $ma_id, $bps_id, $u_id, $notify_url, ~app_id, ~mch_id, ~m_sk>
     ),
     !MS_Database( $ms_id, $user, ~prepay_id, amount, description,
                   ~out_trade_no
     ),
     SIn( 'MS-BPS', ~session, $bps_id, $notify_url,
          <
           <~id, 
            senc(<~app_id, ~mch_id, ~out_trade_no, ~transaction_id, amount, 
                  ~nonce_enc>,
                 ~key_APIv3), 
            ~nonce_enc, ~summary>, 
           res_sign, ~nonce_sig>
     ),
     !BPS_APIv3Key( ~key_APIv3 ), !BPS_PubKey( w_pk )
     ]
    --[
    Eq( z, true ), Finish( 'MS', ~session, $ms_id ),
    MS_Commit( 'MSAuthPS', $ms_id, $bps_id,
               <~id, 
                senc(<~app_id, ~mch_id, ~out_trade_no, ~transaction_id, amount, 
                      ~nonce_enc>,
                     ~key_APIv3), 
                ~nonce_enc, ~summary>
    )
    ]->
     [
     SOut( 'MS-BPS', ~session, $notify_url, $bps_id, 'Successful' ),
     MS_State( 'completed', ~session,
               <$ms_id, $ma_id, $bps_id, $u_id, $notify_url, ~app_id, ~mch_id, ~m_sk>
     )
     ]
    variants (modulo AC)
    1. ~app_id
             = ~app_id.44
       ~id   = ~id.45
       ~key_APIv3
             = ~key_APIv3.46
       ~mch_id
             = ~mch_id.48
       ~nonce_enc
             = ~nonce_enc.49
       ~nonce_sig
             = ~nonce_sig.50
       ~out_trade_no
             = ~out_trade_no.51
       ~summary
             = ~summary.54
       ~transaction_id
             = ~transaction_id.55
       amount
             = amount.56
       res_sign
             = res_sign.58
       w_pk  = w_pk.59
       z     = verify(res_sign.58,
                      <
                       <~id.45, 
                        senc(<~app_id.44, ~mch_id.48, ~out_trade_no.51, ~transaction_id.55, 
                              amount.56, ~nonce_enc.49>,
                             ~key_APIv3.46), 
                        ~nonce_enc.49, ~summary.54>, 
                       ~nonce_sig.50>,
                      w_pk.59)
    
    2. ~app_id
             = ~app_id.158
       ~id   = ~id.159
       ~key_APIv3
             = ~key_APIv3.160
       ~mch_id
             = ~mch_id.162
       ~nonce_enc
             = ~nonce_enc.163
       ~nonce_sig
             = ~nonce_sig.164
       ~out_trade_no
             = ~out_trade_no.165
       ~summary
             = ~summary.168
       ~transaction_id
             = ~transaction_id.169
       amount
             = amount.170
       res_sign
             = sign(<
                     <~id.159, 
                      senc(<~app_id.158, ~mch_id.162, ~out_trade_no.165, ~transaction_id.169, 
                            amount.170, ~nonce_enc.163>,
                           ~key_APIv3.160), 
                      ~nonce_enc.163, ~summary.168>, 
                     ~nonce_sig.164>,
                    x.308)
       w_pk  = pk(x.308)
       z     = true
  */

rule (modulo E) BPSReceiveSuccess[role="BPS"]:
   [
   BPS_State( 'paysuccess', ~session,
              <$bps_id, $u_id, $ma_id, $ms_id, ~w_sk, ~prepay_id>
   ),
   SIn( 'MS-BPS', ~session, $notify_url, $bps_id, 'Successful' )
   ]
  --[ Finish( 'BPS', ~session, $bps_id ) ]->
   [
   BPS_State( 'completed', ~session,
              <$bps_id, $u_id, $ma_id, $ms_id, ~w_sk, ~prepay_id>
   )
   ]

  /* has exactly the trivial AC variant */

lemma typing [sources, heuristic={typing}]:
  all-traces
  "((∀ m1 m2 m3 m4 m5 #i.
      (SOURCE_IN_FACT_BkChaCon( m1, m2, m3, m4, m5 ) @ #i) ⇒
      (∃ #j.
        (SOURCE_OUT_FACT_BkChaCon( m1, m2, m3, m4, m5 ) @ #j) ∧ (#j < #i))) ∧
    (∀ m1 m2 m3 m4 m5 #i.
      (SOURCE_IN_FACT_M_SIGN( m1, m2, m3, m4, m5 ) @ #i) ⇒
      ((∃ #j.
         (SOURCE_OUT_FACT_M_SIGN( m1, m2, m3, m4, m5 ) @ #j) ∧ (#j < #i)) ∨
       (∃ #j.
         (SOURCE_OUT_FACT_BkChaInt( m1, m2, m3, m4, m5 ) @ #j) ∧ (#j < #i))))) ∧
   (∀ m1 m2 m3 m4 m5 #i.
     (SOURCE_IN_FACT_M_SIGN_2( m1, m2, m3, m4, m5 ) @ #i) ⇒
     ((∃ #j.
        (SOURCE_OUT_FACT_M_SIGN_2( m1, m2, m3, m4, m5 ) @ #j) ∧ (#j < #i)) ∨
      (∃ #j.
        (SOURCE_OUT_FACT_BkChaInt( m1, m2, m3, m4, m5 ) @ #j) ∧ (#j < #i))))"
/*
guarded formula characterizing all counter-examples:
"((∃ m1 m2 m3 m4 m5 #i.
    (SOURCE_IN_FACT_BkChaCon( m1, m2, m3, m4, m5 ) @ #i)
   ∧
    ∀ #j.
     (SOURCE_OUT_FACT_BkChaCon( m1, m2, m3, m4, m5 ) @ #j) ⇒ ¬(#j < #i)) ∨
  (∃ m1 m2 m3 m4 m5 #i.
    (SOURCE_IN_FACT_M_SIGN( m1, m2, m3, m4, m5 ) @ #i)
   ∧
    (∀ #j.
      (SOURCE_OUT_FACT_M_SIGN( m1, m2, m3, m4, m5 ) @ #j) ⇒ ¬(#j < #i)) ∧
    (∀ #j.
      (SOURCE_OUT_FACT_BkChaInt( m1, m2, m3, m4, m5 ) @ #j) ⇒ ¬(#j < #i))) ∨
  (∃ m1 m2 m3 m4 m5 #i.
    (SOURCE_IN_FACT_M_SIGN_2( m1, m2, m3, m4, m5 ) @ #i)
   ∧
    (∀ #j.
      (SOURCE_OUT_FACT_M_SIGN_2( m1, m2, m3, m4, m5 ) @ #j) ⇒ ¬(#j < #i)) ∧
    (∀ #j.
      (SOURCE_OUT_FACT_BkChaInt( m1, m2, m3, m4, m5 ) @ #j) ⇒ ¬(#j < #i))))"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  simplify
  solve( (∃ m1 m2 m3 m4 m5 #i.
           (SOURCE_IN_FACT_BkChaCon( m1, m2, m3, m4, m5 ) @ #i)
          ∧
           ∀ #j.
            (SOURCE_OUT_FACT_BkChaCon( m1, m2, m3, m4, m5 ) @ #j) ⇒ ¬(#j < #i))  ∥
         (∃ m1 m2 m3 m4 m5 #i.
           (SOURCE_IN_FACT_M_SIGN( m1, m2, m3, m4, m5 ) @ #i)
          ∧
           (∀ #j.
             (SOURCE_OUT_FACT_M_SIGN( m1, m2, m3, m4, m5 ) @ #j) ⇒ ¬(#j < #i)) ∧
           (∀ #j.
             (SOURCE_OUT_FACT_BkChaInt( m1, m2, m3, m4, m5 ) @ #j) ⇒ ¬(#j < #i)))  ∥
         (∃ m1 m2 m3 m4 m5 #i.
           (SOURCE_IN_FACT_M_SIGN_2( m1, m2, m3, m4, m5 ) @ #i)
          ∧
           (∀ #j.
             (SOURCE_OUT_FACT_M_SIGN_2( m1, m2, m3, m4, m5 ) @ #j) ⇒ ¬(#j < #i)) ∧
           (∀ #j.
             (SOURCE_OUT_FACT_BkChaInt( m1, m2, m3, m4, m5 ) @ #j) ⇒ ¬(#j < #i))) )
    case case_1
    solve( (last(#i))  ∥
           (∃ #j.
             (SOURCE_OUT_FACT_BkChaCon( 'MA-MS', ~session, $src, $dst, m5 ) @ #j)
            ∧
             (¬(last(#j))) ∧ (#j < #i)) )
      case case_1
      solve( SOut( 'MA-MS', ~session, $src, $dst, m5 ) ▶₀ #i )
        case MAOrderMS
        by contradiction /* from formulas */
      next
        case MSSendPrepayidMA_case_1
        by contradiction /* from formulas */
      next
        case MSSendPrepayidMA_case_2
        by contradiction /* from formulas */
      next
        case breakChannelConfidentiality
        by contradiction /* cyclic */
      qed
    next
      case case_2
      by contradiction /* from formulas */
    qed
  next
    case case_2
    solve( (last(#i))  ∥
           (∃ #j.
             (SOURCE_OUT_FACT_M_SIGN( 'MS-BPS', ~session, $ms_id, $bps_id,
                                      <
                                       <~mch_id, ~nonce, 
                                        sign(<~nonce, ~app_id, ~mch_id, description, ~out_trade_no, 
                                              $notify_url, amount>,
                                             x)
                                       >, 
                                       ~app_id, ~mch_id, description, ~out_trade_no, $notify_url, amount>
              ) @ #j)
            ∧
             (¬(last(#j))) ∧ (#j < #i))  ∥
           (∃ #j.
             (SOURCE_OUT_FACT_BkChaInt( 'MS-BPS', ~session, $ms_id, $bps_id,
                                        <
                                         <~mch_id, ~nonce, 
                                          sign(<~nonce, ~app_id, ~mch_id, description, ~out_trade_no, 
                                                $notify_url, amount>,
                                               x)
                                         >, 
                                         ~app_id, ~mch_id, description, ~out_trade_no, $notify_url, amount>
              ) @ #j)
            ∧
             (¬(last(#j))) ∧ (#j < #i)) )
      case case_1
      solve( SIn( 'MS-BPS', ~session, $ms_id, $bps_id,
                  <
                   <~mch_id, ~nonce, 
                    sign(<~nonce, ~app_id, ~mch_id, description, ~out_trade_no, $notify_url, 
                          amount>,
                         x)
                   >, 
                   ~app_id, ~mch_id, description, ~out_trade_no, $notify_url, amount>
             ) ▶₀ #i )
        case SecureChannelSendRecv
        solve( SOut( 'MS-BPS', ~session, $ms_id, $bps_id,
                     <
                      <~mch_id, ~nonce, 
                       sign(<~nonce, ~app_id, ~mch_id, description, ~out_trade_no, $notify_url, 
                             amount>,
                            x)
                      >, 
                      ~app_id, ~mch_id, description, ~out_trade_no, $notify_url, amount>
               ) ▶₀ #vr )
          case MSProcessOrderBPS_case_1
          by contradiction /* from formulas */
        next
          case MSProcessOrderBPS_case_2
          by contradiction /* from formulas */
        qed
      qed
    next
      case case_2
      by contradiction /* from formulas */
    qed
  next
    case case_3
    solve( (last(#i))  ∥
           (∃ #j.
             (SOURCE_OUT_FACT_M_SIGN_2( 'MA-MS', ~session, $ms_id, $ma_id,
                                        <~out_trade_no, ~app_id, ~mch_id, ~prepay_id, ~nonce, m_sig>
              ) @ #j)
            ∧
             (¬(last(#j))) ∧ (#j < #i))  ∥
           (∃ #j.
             (SOURCE_OUT_FACT_BkChaInt( 'MA-MS', ~session, $ms_id, $ma_id,
                                        <~out_trade_no, ~app_id, ~mch_id, ~prepay_id, ~nonce, m_sig>
              ) @ #j)
            ∧
             (¬(last(#j))) ∧ (#j < #i)) )
      case case_1
      solve( MA_State( 'ordered', ~session, <$ma_id, $u_id, $ms_id, $bps_id>
             ) ▶₁ #i )
        case MAOrderMS
        solve( SOut( 'U-MA', ~session, $u_id, $ma_id, <'OpenAppAndOrder', ~goods>
               ) ▶₀ #vr.1 )
          case UOpenAndOrderMA
          solve( SIn( 'MA-MS', ~session, $ms_id, $ma_id,
                      <~out_trade_no, ~app_id, ~mch_id, ~prepay_id, ~nonce, m_sig>
                 ) ▶₀ #i )
            case SecureChannelSendRecv
            solve( SOut( 'MA-MS', ~session, $ms_id, $ma_id,
                         <~out_trade_no, ~app_id, ~mch_id, ~prepay_id, ~nonce, m_sig>
                   ) ▶₀ #vr.8 )
              case MSSendPrepayidMA_case_1
              by contradiction /* from formulas */
            next
              case MSSendPrepayidMA_case_2
              by contradiction /* from formulas */
            next
              case breakChannelConfidentiality
              solve( SOURCE_OUT_FACT_BkChaCon( 'MA-MS', ~session, $ms_id, $ma_id,
                                               <~out_trade_no, ~app_id, ~mch_id, ~prepay_id, ~nonce, m_sig>
                     ) @ #j )
                case MSSendPrepayidMA
                by contradiction /* from formulas */
              qed
            qed
          next
            case breakChannelIntegrity
            by contradiction /* from formulas */
          qed
        qed
      qed
    next
      case case_2
      by contradiction /* from formulas */
    next
      case case_3
      by contradiction /* from formulas */
    qed
  qed
qed

lemma executable [heuristic={default}]:
  exists-trace
  "∃ u_id ma_id ms_id bps_id session #i #j #k #l #m.
    ((((Start( session, u_id, ma_id, ms_id, bps_id ) @ #m) ∧
       (Finish( 'U', session, u_id ) @ #i)) ∧
      (Finish( 'MA', session, ma_id ) @ #j)) ∧
     (Finish( 'MS', session, ms_id ) @ #k)) ∧
    (Finish( 'BPS', session, bps_id ) @ #l)"
/*
guarded formula characterizing all satisfying traces:
"∃ u_id ma_id ms_id bps_id session #i #j #k #l #m.
  (Start( session, u_id, ma_id, ms_id, bps_id ) @ #m) ∧
  (Finish( 'U', session, u_id ) @ #i) ∧
  (Finish( 'MA', session, ma_id ) @ #j) ∧
  (Finish( 'MS', session, ms_id ) @ #k) ∧
  (Finish( 'BPS', session, bps_id ) @ #l)"
*/
simplify
solve( !MerchantCreated( <$ms_id, ~app_id, ~mch_id, $notify_url, ~m_sk>
       ) ▶₃ #m )
  case CreateMS
  solve( MA_State( 'created', 'null', $ma_id ) ▶₄ #m )
    case CreateMA
    solve( !BPS_PriKey( ~w_sk ) ▶₁ #m )
      case CreateBPS
      solve( !UserPassword( <$u_id, ~password> ) ▶₂ #m )
        case CreateU
        solve( Finish( 'U', ~session, $u_id ) @ #i )
          case UReceiveNotification
          solve( U_State( 'pwdsubmitted', ~session,
                          <$u_id, $ma_id, $bps_id, $ms_id, ~password, ~goods>
                 ) ▶₁ #i )
            case USubmitPasswordBPS
            solve( SOut( 'U-BPS', ~session, $bps_id, $u_id,
                         <'SReqPwd', calc_amt(~goods), gen_desc(~goods), ~prepay_id>
                   ) ▶₀ #vr.6 )
              case BPSVerifyPaymentMA_case_2
              solve( SOut( 'MA-BPS', ~session, $ma_id, $bps_id,
                           <~app_id, ~mch_id, ~prepay_id, ~nonce, 
                            sign(<~app_id, ~nonce, ~prepay_id>, ~m_sk)>
                     ) ▶₀ #vr.8 )
                case MACallBPS_case_1
                solve( SOut( 'MS-BPS', ~session.1, $ms_id.1, $bps_id,
                             <
                              <~mch_id.1, ~nonce.1, 
                               sign(<~nonce.1, ~app_id.1, ~mch_id.1, gen_desc(~goods), ~out_trade_no, 
                                     $notify_url.1, calc_amt(~goods)>,
                                    ~m_sk.1)
                              >, 
                              ~app_id.1, ~mch_id.1, gen_desc(~goods), ~out_trade_no, $notify_url.1, 
                              calc_amt(~goods)>
                       ) ▶₀ #vr.11 )
                  case MSProcessOrderBPS_case_1
                  solve( SOut( 'MS-BPS', ~session, $ms_id, $bps_id,
                               <
                                <~mch_id, ~nonce.2, 
                                 sign(<~nonce.2, ~app_id, ~mch_id, description, ~out_trade_no.1, 
                                       $notify_url.2, amount>,
                                      ~m_sk)
                                >, 
                                ~app_id, ~mch_id, description, ~out_trade_no.1, $notify_url.2, amount>
                         ) ▶₀ #vr.14 )
                    case MSProcessOrderBPS_case_1
                    solve( SOut( 'MA-MS', ~session, $ms_id, $ma_id,
                                 <~out_trade_no.2, ~app_id, ~mch_id, ~prepay_id, ~nonce, 
                                  sign(<~app_id, ~nonce, ~prepay_id>, ~m_sk)>
                           ) ▶₀ #vr.17 )
                      case MSSendPrepayidMA
                      solve( SOut( 'U-MA', ~session, $u_id, $ma_id,
                                   <'OpenAppAndOrder', ~goods.2>
                             ) ▶₀ #vr.19 )
                        case UOpenAndOrderMA
                        solve( SOut( 'MS-BPS', ~session, $bps_id, $ms_id, ~prepay_id
                               ) ▶₀ #vr.25 )
                          case BPSSendPrepayidMS
                          solve( SIn( 'U-BPS', ~session, $bps_id, $u_id,
                                      <'PaymentSuccessful', calc_amt(~goods), gen_desc(~goods)>
                                 ) ▶₀ #i )
                            case SecureChannelSendRecv
                            solve( SOut( 'U-BPS', ~session, $bps_id, $u_id,
                                         <'PaymentSuccessful', calc_amt(~goods), gen_desc(~goods)>
                                   ) ▶₀ #vr.19 )
                              case BPSVerifyPasswordAndConfirmUMS
                              solve( SOut( 'U-BPS', ~session, $u_id, $bps_id, ~password ) ▶₀ #vr.21 )
                                case USubmitPasswordBPS
                                solve( Finish( 'MA', ~session, $ma_id ) @ #j )
                                  case MACallBPS
                                  solve( MA_State( 'ordered', ~session,
                                                   <$ma_id, $u_id.1, $ms_id.1, $bps_id.1>
                                         ) ▶₁ #j )
                                    case MAOrderMS
                                    solve( Finish( 'MS', ~session, $ms_id ) @ #k )
                                      case MSReceiveNotification
                                      solve( MS_State( 'sendprepayid', ~session,
                                                       <$ms_id, $ma_id.1, $bps_id.1, $u_id.1, $notify_url, 
                                                        ~app_id.1, ~mch_id.1, ~m_sk.1>
                                             ) ▶₀ #k )
                                        case MSSendPrepayidMA
                                        solve( SIn( 'MS-BPS', ~session, $bps_id, $notify_url,
                                                    <
                                                     <~id, 
                                                      senc(<~app_id, ~mch_id, ~out_trade_no.1, 
                                                            ~transaction_id, amount, ~nonce_enc>,
                                                           ~key_APIv3), 
                                                      ~nonce_enc, ~summary>, 
                                                     sign(<
                                                           <~id, 
                                                            senc(<~app_id, ~mch_id, ~out_trade_no.1, 
                                                                  ~transaction_id, amount, ~nonce_enc>,
                                                                 ~key_APIv3), 
                                                            ~nonce_enc, ~summary>, 
                                                           ~nonce_sig>,
                                                          x), 
                                                     ~nonce_sig>
                                               ) ▶₂ #k )
                                          case SecureChannelSendRecv
                                          solve( SOut( 'MS-BPS', ~session, $bps_id, $notify_url,
                                                       <
                                                        <~id, 
                                                         senc(<~app_id, ~mch_id, ~out_trade_no.1, 
                                                               ~transaction_id, amount, ~nonce_enc>,
                                                              ~key_APIv3), 
                                                         ~nonce_enc, ~summary>, 
                                                        sign(<
                                                              <~id, 
                                                               senc(<~app_id, ~mch_id, ~out_trade_no.1, 
                                                                     ~transaction_id, amount, ~nonce_enc>,
                                                                    ~key_APIv3), 
                                                               ~nonce_enc, ~summary>, 
                                                              ~nonce_sig>,
                                                             x), 
                                                        ~nonce_sig>
                                                 ) ▶₀ #vr.21 )
                                            case BPSVerifyPasswordAndConfirmUMS
                                            solve( !BPS_PubKey( pk(~w_sk) ) ▶₄ #k )
                                              case CreateBPS
                                              solve( !MS_Database( $ms_id, $user, ~prepay_id.1,
                                                                   calc_amt(~goods), description,
                                                                   ~out_trade_no
                                                     ) ▶₁ #k )
                                                case MSSendPrepayidMA
                                                solve( !BPS_APIv3Key( ~key_APIv3 ) ▶₃ #k )
                                                  case CreateBPS
                                                  solve( Finish( 'BPS', ~session, $bps_id ) @ #l )
                                                    case BPSReceiveSuccess
                                                    solve( BPS_State( 'paysuccess', ~session,
                                                                      <$bps_id, $u_id.1, $ma_id.1, $ms_id.1, 
                                                                       ~w_sk.1, ~prepay_id.1>
                                                           ) ▶₀ #l )
                                                      case BPSVerifyPasswordAndConfirmUMS
                                                      solve( SIn( 'MS-BPS', ~session, $notify_url.1, $bps_id,
                                                                  'Successful'
                                                             ) ▶₁ #l )
                                                        case SecureChannelSendRecv
                                                        solve( SOut( 'MS-BPS', ~session, $notify_url.1,
                                                                     $bps_id, 'Successful'
                                                               ) ▶₀ #vr.22 )
                                                          case MSReceiveNotification

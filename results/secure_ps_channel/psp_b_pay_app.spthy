lemma No_Payment_Without_Password_Input [heuristic={default}]:
  all-traces
  "∀ u p s #i.
    (PaymentComplete( u, h(p), s ) @ #i) ⇒
    (∃ #j.
      ((UserInputPwd( u, p, s ) @ #j) ∧ (#j < #i)) ∧
      (¬(∃ u2 p2 #i2.
          (PaymentComplete( u2, h(p2), s ) @ #i2) ∧ (¬(#i2 = #i)))))"
/*
guarded formula characterizing all counter-examples:
"∃ u p s #i.
  (PaymentComplete( u, h(p), s ) @ #i)
 ∧
  ∀ #j.
   (UserInputPwd( u, p, s ) @ #j)
  ⇒
   ((¬(#j < #i)) ∨
    (∃ u2 p2 #i2. (PaymentComplete( u2, h(p2), s ) @ #i2) ∧ ¬(#i2 = #i)))"
*/
simplify
solve( BPS_State( 'waitpwd', ~session,
                  <$bps_id, $u_id, $ma_id, $ms_id, ~w_sk, ~prepay_id, ~out_trade_no, 
                   amount, description>
       ) ▶₁ #i )
  case BPSVerifyPaymentMA_case_1
  solve( SOut( 'MA-BPS', ~session, $ma_id, $bps_id,
               <~app_id.1, ~mch_id.1, ~prepay_id, ~nonce, 
                sign(<~app_id.1, ~nonce, ~prepay_id>, ~m_sk)>
         ) ▶₀ #vr.1 )
    case MACallBPS_case_1
    solve( SOut( 'MS-BPS', ~session, $ms_id, $bps_id,
                 <
                  <~mch_id.1, ~nonce.2, 
                   sign(<~nonce.2, ~app_id.1, ~mch_id.1, description.1, ~out_trade_no.1, 
                         $notify_url.2, amount.1>,
                        ~m_sk)
                  >, 
                  ~app_id.1, ~mch_id.1, description.1, ~out_trade_no.1, $notify_url.2, 
                  amount.1>
           ) ▶₀ #vr.6 )
      case MSProcessOrderBPS_case_1
      solve( SOut( 'MA-MS', ~session, $ms_id, $ma_id,
                   <~out_trade_no.2, ~app_id.1, ~mch_id.1, ~prepay_id, ~nonce, 
                    sign(<~app_id.1, ~nonce, ~prepay_id>, ~m_sk)>
             ) ▶₀ #vr.12 )
        case MSSendPrepayidMA
        solve( SOut( 'U-MA', ~session, $u_id, $ma_id,
                     <'OpenAppAndOrder', ~goods.1>
               ) ▶₀ #vr.14 )
          case UOpenAndOrderMA
          by solve( SOut( 'MS-BPS', ~session, $bps_id, $ms_id, ~prepay_id
                    ) ▶₀ #vr.18 )
        qed
      next
        case breakChannelConfidentiality
        solve( SOut( 'MA-MS', ~session, $ms_id, $ma_id,
                     <~out_trade_no.1, ~app_id.1, ~mch_id.1, ~prepay_id, ~nonce, 
                      sign(<~app_id.1, ~nonce, ~prepay_id>, ~m_sk)>
               ) ▶₀ #vr.17 )
          case MSSendPrepayidMA
          solve( SOut( 'U-MA', ~session, $u_id, $ma_id,
                       <'OpenAppAndOrder', ~goods.1>
                 ) ▶₀ #vr.14 )
            case UOpenAndOrderMA
            by solve( SOut( 'MS-BPS', ~session, $bps_id, $ms_id, ~prepay_id
                      ) ▶₀ #vr.18 )
          qed
        qed
      qed
    next
      case MSProcessOrderBPS_case_2
      solve( SOut( 'MA-MS', ~session, $ms_id, $ma_id,
                   <~out_trade_no.2, ~app_id.1, ~mch_id.1, ~prepay_id, ~nonce, 
                    sign(<~app_id.1, ~nonce, ~prepay_id>, ~m_sk)>
             ) ▶₀ #vr.12 )
        case MSSendPrepayidMA
        solve( SOut( 'U-MA', ~session, $u_id, $ma_id,
                     <'OpenAppAndOrder', ~goods.1>
               ) ▶₀ #vr.14 )
          case UOpenAndOrderMA
          by solve( SOut( 'MS-BPS', ~session, $bps_id, $ms_id, ~prepay_id
                    ) ▶₀ #vr.18 )
        qed
      next
        case breakChannelConfidentiality
        solve( SOut( 'MA-MS', ~session, $ms_id, $ma_id,
                     <~out_trade_no.1, ~app_id.1, ~mch_id.1, ~prepay_id, ~nonce, 
                      sign(<~app_id.1, ~nonce, ~prepay_id>, ~m_sk)>
               ) ▶₀ #vr.17 )
          case MSSendPrepayidMA
          solve( SOut( 'U-MA', ~session, $u_id, $ma_id,
                       <'OpenAppAndOrder', ~goods.1>
                 ) ▶₀ #vr.14 )
            case UOpenAndOrderMA
            by solve( SOut( 'MS-BPS', ~session, $bps_id, $ms_id, ~prepay_id
                      ) ▶₀ #vr.18 )
          qed
        qed
      qed
    qed
  next
    case MACallBPS_case_2
    solve( !KU( sign(<~app_id.1, ~nonce, ~prepay_id>, ~m_sk) ) @ #vk.21 )
      case OrderCreateOracle
      solve( SOut( 'MS-BPS', ~session, $ms_id, $bps_id,
                   <
                    <~mch_id.1, ~nonce.1, 
                     sign(<~nonce.1, ~app_id.1, ~mch_id.1, description.1, ~out_trade_no.1, 
                           $notify_url.2, amount.1>,
                          ~m_sk)
                    >, 
                    ~app_id.1, ~mch_id.1, description.1, ~out_trade_no.1, $notify_url.2, 
                    amount.1>
             ) ▶₀ #vr.5 )
        case MSProcessOrderBPS_case_1
        solve( SOut( 'U-MA', ~session, $u_id, $ma_id,
                     <'OpenAppAndOrder', ~goods.1>
               ) ▶₀ #vr.13 )
          case UOpenAndOrderMA
          solve( SIn( 'U-BPS', ~session, $u_id, $bps_id, ~password ) ▶₀ #i )
            case SecureChannelSendRecv
            solve( SOut( 'U-BPS', ~session, $u_id, $bps_id, ~password ) ▶₀ #vr.22 )
              case USubmitPasswordBPS
              solve( BPS_State( 'waitpwd', ~session,
                                <$bps_id.1, $u_id.1, $ma_id.1, $ms_id.1, ~w_sk.1, ~prepay_id.3, 
                                 ~out_trade_no.3, amount.1, description.1>
                     ) ▶₁ #i2 )
                case BPSVerifyPaymentMA
                by contradiction /* from formulas */
              qed
            qed
          qed
        qed
      next
        case MSProcessOrderBPS_case_2
        solve( SOut( 'U-MA', ~session, $u_id, $ma_id,
                     <'OpenAppAndOrder', ~goods.1>
               ) ▶₀ #vr.13 )
          case UOpenAndOrderMA
          solve( SIn( 'U-BPS', ~session, $u_id, $bps_id, ~password ) ▶₀ #i )
            case SecureChannelSendRecv
            solve( SOut( 'U-BPS', ~session, $u_id, $bps_id, ~password ) ▶₀ #vr.22 )
              case USubmitPasswordBPS
              solve( BPS_State( 'waitpwd', ~session,
                                <$bps_id.1, $u_id.1, $ma_id.1, $ms_id.1, ~w_sk.1, ~prepay_id.3, 
                                 ~out_trade_no.3, amount.1, description.1>
                     ) ▶₁ #i2 )
                case BPSVerifyPaymentMA
                by contradiction /* from formulas */
              qed
            qed
          qed
        qed
      qed
    next
      case breakChannelConfidentiality_case_1
      solve( SOut( 'MS-BPS', ~session, $ms_id, $bps_id,
                   <
                    <~mch_id.1, ~nonce.2, 
                     sign(<~nonce.2, ~app_id.1, ~mch_id.1, description.1, ~out_trade_no.1, 
                           $notify_url.2, amount.1>,
                          ~m_sk)
                    >, 
                    ~app_id.1, ~mch_id.1, description.1, ~out_trade_no.1, $notify_url.2, 
                    amount.1>
             ) ▶₀ #vr.6 )
        case MSProcessOrderBPS_case_1
        solve( SOut( 'MA-MS', ~session.1, $ms_id, $dst,
                     <~out_trade_no.1, ~app_id.1, ~mch_id.1, ~prepay_id, ~nonce, 
                      sign(<~app_id.1, ~nonce, ~prepay_id>, ~m_sk)>
               ) ▶₀ #vr.15 )
          case MSSendPrepayidMA
          solve( SOut( 'U-MA', ~session, $u_id, $ma_id,
                       <'OpenAppAndOrder', ~goods.2>
                 ) ▶₀ #vr.14 )
            case UOpenAndOrderMA
            by solve( SOut( 'MS-BPS', ~session.1, $bps_id.1, $ms_id, ~prepay_id
                      ) ▶₀ #vr.23 )
          qed
        next
          case breakChannelConfidentiality
          by contradiction /* cyclic */
        qed
      next
        case MSProcessOrderBPS_case_2
        solve( SOut( 'MA-MS', ~session.1, $ms_id, $dst,
                     <~out_trade_no.1, ~app_id.1, ~mch_id.1, ~prepay_id, ~nonce, 
                      sign(<~app_id.1, ~nonce, ~prepay_id>, ~m_sk)>
               ) ▶₀ #vr.15 )
          case MSSendPrepayidMA
          solve( SOut( 'U-MA', ~session, $u_id, $ma_id,
                       <'OpenAppAndOrder', ~goods.2>
                 ) ▶₀ #vr.14 )
            case UOpenAndOrderMA
            by solve( SOut( 'MS-BPS', ~session.1, $bps_id.1, $ms_id, ~prepay_id
                      ) ▶₀ #vr.23 )
          qed
        next
          case breakChannelConfidentiality
          by contradiction /* cyclic */
        qed
      qed
    next
      case breakChannelConfidentiality_case_2
      solve( SOut( 'MS-BPS', ~session, $ms_id, $bps_id,
                   <
                    <~mch_id.1, ~nonce.2, 
                     sign(<~nonce.2, ~app_id.1, ~mch_id.1, description.1, ~out_trade_no.1, 
                           $notify_url.2, amount.1>,
                          ~m_sk)
                    >, 
                    ~app_id.1, ~mch_id.1, description.1, ~out_trade_no.1, $notify_url.2, 
                    amount.1>
             ) ▶₀ #vr.6 )
        case MSProcessOrderBPS_case_1
        solve( SOut( 'MA-MS', ~session.1, $ms_id, $dst,

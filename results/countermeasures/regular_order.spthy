lemma No_Payment_Without_Password_Input [heuristic={default}]:
  all-traces
  "∀ u p s #i.
    (PaymentComplete( u, h(p), s ) @ #i) ⇒
    (∃ #j.
      ((UserInputPwd( u, p, s ) @ #j) ∧ (#j < #i)) ∧
      (¬(∃ u2 p2 #i2.
          (PaymentComplete( u2, h(p2), s ) @ #i2) ∧ (¬(#i2 = #i)))))"
/*
guarded formula characterizing all counter-examples:
"∃ u p s #i.
  (PaymentComplete( u, h(p), s ) @ #i)
 ∧
  ∀ #j.
   (UserInputPwd( u, p, s ) @ #j)
  ⇒
   ((¬(#j < #i)) ∨
    (∃ u2 p2 #i2. (PaymentComplete( u2, h(p2), s ) @ #i2) ∧ ¬(#i2 = #i)))"
*/
simplify
solve( PS_State( 'waitpwd', ~session,
                 <$ps_id, $u_id, $mf_id, $ms_id, ~p_sk, ua_pk, ~prepay_id, ~order_id, 
                  amount, description>
       ) ▶₁ #i )
  case PSVerifyPaymentMF_case_1
  solve( SOut( 'MF-PS', ~session, $mf_id, $ps_id,
               <~prepay_id, $ms_id, sign(<~prepay_id, $ms_id>, ~m_sk), 
                sign(<~prepay_id, $ms_id>, x)>
         ) ▶₀ #vr.1 )
    case MFCallPS_case_1
    solve( SOut( 'MS-PS', ~session, $ms_id, $ps_id,
                 <pk(x), $ms_id, ~order_id.1, amount.1, description.1, 
                  sign(<$ms_id, ~order_id.1, amount.1, description.1>, ~m_sk)>
           ) ▶₀ #vr.6 )
      case MSProcessOrderMF_case_1
      solve( SOut( 'MF-MS', ~session, $ms_id, $mf_id,
                   <~prepay_id, $ms_id, sign(<~prepay_id, $ms_id>, ~m_sk), 
                    sign(<~prepay_id, $ms_id>, ~ua_sk)>
             ) ▶₀ #vr.12 )
        case MSSendPrepayidMF
        solve( SOut( 'U-MF', ~session, $u_id, $mf_id,
                     <'OpenAppAndOrder', ~goods.1>
               ) ▶₀ #vr.14 )
          case UOpenAndOrderMF
          by solve( SOut( 'MS-PS', ~session, $ps_id, $ms_id, ~prepay_id
                    ) ▶₀ #vr.18 )
        qed
      next
        case breakChannelConfidentiality
        solve( SOut( 'MF-MS', ~session, $ms_id, $mf_id,
                     <~prepay_id, $ms_id, sign(<~prepay_id, $ms_id>, ~m_sk), 
                      sign(<~prepay_id, $ms_id>, ~ua_sk)>
               ) ▶₀ #vr.17 )
          case MSSendPrepayidMF
          solve( SOut( 'U-MF', ~session, $u_id, $mf_id,
                       <'OpenAppAndOrder', ~goods.1>
                 ) ▶₀ #vr.14 )
            case UOpenAndOrderMF
            by solve( SOut( 'MS-PS', ~session, $ps_id, $ms_id, ~prepay_id
                      ) ▶₀ #vr.18 )
          qed
        qed
      qed
    next
      case MSProcessOrderMF_case_2
      solve( SOut( 'MF-MS', ~session, $ms_id, $mf_id,
                   <~prepay_id, $ms_id, sign(<~prepay_id, $ms_id>, ~m_sk), 
                    sign(<~prepay_id, $ms_id>, ~ua_sk)>
             ) ▶₀ #vr.12 )
        case MSSendPrepayidMF
        solve( SOut( 'U-MF', ~session, $u_id, $mf_id,
                     <'OpenAppAndOrder', ~goods.1>
               ) ▶₀ #vr.14 )
          case UOpenAndOrderMF
          by solve( SOut( 'MS-PS', ~session, $ps_id, $ms_id, ~prepay_id
                    ) ▶₀ #vr.18 )
        qed
      next
        case breakChannelConfidentiality
        solve( SOut( 'MF-MS', ~session, $ms_id, $mf_id,
                     <~prepay_id, $ms_id, sign(<~prepay_id, $ms_id>, ~m_sk), 
                      sign(<~prepay_id, $ms_id>, ~ua_sk)>
               ) ▶₀ #vr.17 )
          case MSSendPrepayidMF
          solve( SOut( 'U-MF', ~session, $u_id, $mf_id,
                       <'OpenAppAndOrder', ~goods.1>
                 ) ▶₀ #vr.14 )
            case UOpenAndOrderMF
            by solve( SOut( 'MS-PS', ~session, $ps_id, $ms_id, ~prepay_id
                      ) ▶₀ #vr.18 )
          qed
        qed
      qed
    qed
  next
    case MFCallPS_case_2
    solve( !KU( sign(<~prepay_id, $ms_id>, ~m_sk) ) @ #vk.15 )
      case OrderCreateOracle
      solve( SOut( 'MS-PS', ~session, $ms_id, $ps_id,
                   <pk(x), $ms_id, ~order_id.1, amount.1, description.1, 
                    sign(<$ms_id, ~order_id.1, amount.1, description.1>, ~m_sk)>
             ) ▶₀ #vr.5 )
        case MSProcessOrderMF_case_1
        solve( !KU( sign(<~prepay_id, $ms_id>, ~ua_sk) ) @ #vk.16 )
          case breakChannelConfidentiality_case_1
          solve( SOut( 'MF-MS', ~session.1, $ms_id, $dst,
                       <~prepay_id, $ms_id, sign(<~prepay_id, $ms_id>, ~m_sk), 
                        sign(<~prepay_id, $ms_id>, ~ua_sk)>
                 ) ▶₀ #vr.18 )
            case MSSendPrepayidMF
            solve( SOut( 'U-MF', ~session, $u_id, $mf_id,
                         <'OpenAppAndOrder', ~goods.2>
                   ) ▶₀ #vr.13 )
              case UOpenAndOrderMF
              by solve( SOut( 'MS-PS', ~session.1, $ps_id.1, $ms_id, ~prepay_id
                        ) ▶₀ #vr.24 )
            qed
          next
            case breakChannelConfidentiality
            by contradiction /* cyclic */
          qed
        next
          case breakChannelConfidentiality_case_2
          solve( SOut( 'MF-MS', ~session.1, $ms_id, $dst,
                       <~prepay_id, $ms_id, sign(<~prepay_id, $ms_id>, ~m_sk), 
                        sign(<~prepay_id, $ms_id>, ~ua_sk)>
                 ) ▶₀ #vr.18 )
            case MSSendPrepayidMF
            solve( SOut( 'U-MF', ~session, $u_id, $mf_id,
                         <'OpenAppAndOrder', ~goods.2>
                   ) ▶₀ #vr.13 )
              case UOpenAndOrderMF

lemma No_Payment_Without_Password_Input [heuristic={default}]:
  all-traces
  "∀ u p s #i.
    (PaymentComplete( u, h(p), s ) @ #i) ⇒
    (∃ #j.
      ((UserInputPwd( u, p, s ) @ #j) ∧ (#j < #i)) ∧
      (¬(∃ u2 p2 #i2.
          (PaymentComplete( u2, h(p2), s ) @ #i2) ∧ (¬(#i2 = #i)))))"
/*
guarded formula characterizing all counter-examples:
"∃ u p s #i.
  (PaymentComplete( u, h(p), s ) @ #i)
 ∧
  ∀ #j.
   (UserInputPwd( u, p, s ) @ #j)
  ⇒
   ((¬(#j < #i)) ∨
    (∃ u2 p2 #i2. (PaymentComplete( u2, h(p2), s ) @ #i2) ∧ ¬(#i2 = #i)))"
*/
simplify
solve( PS_State( 'waitpwd', ~session,
                 <$ps_id, $u_id, $mf_id, $ms_id, ~p_sk, ua_pk, ~prepay_id, ~order_id, 
                  amount, description>
       ) ▶₁ #i )
  case PSWaitpwd_case_1
  solve( SOut( 'MF-PS', ~session, $mf_id, $ps_id,
               <~prepay_id, $ms_id, ua_pk, sign(<~prepay_id, $ms_id, ua_pk>, ~m_sk)>
         ) ▶₀ #vr.3 )
    case MFCallPS_case_1
    solve( SOut( 'MS-PS', ~session, $ms_id, $ps_id,
                 <ua_pk, $ms_id, ~order_id.1, amount.1, description.1, 
                  sign(<ua_pk, $ms_id, ~order_id.1, amount.1, description.1>, ~m_sk)>
           ) ▶₀ #vr.9 )
      case MSProcessOrderMF_case_1
      solve( SOut( 'MF-MS', ~session, $ms_id, $mf_id,
                   <~prepay_id, $ms_id, pk(~ua_sk), 
                    sign(<~prepay_id, $ms_id, pk(~ua_sk)>, ~m_sk)>
             ) ▶₀ #vr.18 )
        case MSSendPrepayidMF
        solve( SOut( 'U-PS', ~session, $u_id, $ps_id, 'Confirmed' ) ▶₀ #vr.2 )
          case UTrustPS
          solve( SOut( 'U-MF', ~session, $u_id, $mf_id,
                       <'OpenAppAndOrder', ~goods.2>
                 ) ▶₀ #vr.20 )
            case UOpenAndOrderMF
            solve( SOut( 'U-PS', ~session, $ps_id, $u_id,
                         'Do you trust this transaction?'
                   ) ▶₀ #vr.27 )
              case PSVerifyPaymentMF
              by solve( SOut( 'MS-PS', ~session, $ps_id, $ms_id, ~prepay_id
                        ) ▶₀ #vr.24 )
            qed
          qed
        qed
      next
        case breakChannelConfidentiality
        solve( SOut( 'MF-MS', ~session, $ms_id, $mf_id,
                     <~prepay_id, $ms_id, pk(~ua_sk), 
                      sign(<~prepay_id, $ms_id, pk(~ua_sk)>, ~m_sk)>
               ) ▶₀ #vr.23 )
          case MSSendPrepayidMF
          solve( SOut( 'U-PS', ~session, $u_id, $ps_id, 'Confirmed' ) ▶₀ #vr.2 )
            case UTrustPS
            solve( SOut( 'U-MF', ~session, $u_id, $mf_id,
                         <'OpenAppAndOrder', ~goods.2>
                   ) ▶₀ #vr.20 )
              case UOpenAndOrderMF
              solve( SOut( 'U-PS', ~session, $ps_id, $u_id,
                           'Do you trust this transaction?'
                     ) ▶₀ #vr.27 )
                case PSVerifyPaymentMF
                by solve( SOut( 'MS-PS', ~session, $ps_id, $ms_id, ~prepay_id
                          ) ▶₀ #vr.24 )
              qed
            qed
          qed
        qed
      qed
    next
      case MSProcessOrderMF_case_2
      solve( SOut( 'MF-MS', ~session, $ms_id, $mf_id,
                   <~prepay_id, $ms_id, pk(~ua_sk), 
                    sign(<~prepay_id, $ms_id, pk(~ua_sk)>, ~m_sk)>
             ) ▶₀ #vr.18 )
        case MSSendPrepayidMF
        solve( SOut( 'U-PS', ~session, $u_id, $ps_id, 'Confirmed' ) ▶₀ #vr.2 )
          case UTrustPS
          solve( SOut( 'U-MF', ~session, $u_id, $mf_id,
                       <'OpenAppAndOrder', ~goods.2>
                 ) ▶₀ #vr.20 )
            case UOpenAndOrderMF
            solve( SOut( 'U-PS', ~session, $ps_id, $u_id,
                         'Do you trust this transaction?'
                   ) ▶₀ #vr.27 )
              case PSVerifyPaymentMF
              by solve( SOut( 'MS-PS', ~session, $ps_id, $ms_id, ~prepay_id
                        ) ▶₀ #vr.24 )
            qed
          qed
        qed
      next
        case breakChannelConfidentiality
        solve( SOut( 'MF-MS', ~session, $ms_id, $mf_id,
                     <~prepay_id, $ms_id, pk(~ua_sk), 
                      sign(<~prepay_id, $ms_id, pk(~ua_sk)>, ~m_sk)>
               ) ▶₀ #vr.23 )
          case MSSendPrepayidMF
          solve( SOut( 'U-PS', ~session, $u_id, $ps_id, 'Confirmed' ) ▶₀ #vr.2 )
            case UTrustPS
            solve( SOut( 'U-MF', ~session, $u_id, $mf_id,
                         <'OpenAppAndOrder', ~goods.2>
                   ) ▶₀ #vr.20 )
              case UOpenAndOrderMF
              solve( SOut( 'U-PS', ~session, $ps_id, $u_id,
                           'Do you trust this transaction?'
                     ) ▶₀ #vr.27 )
                case PSVerifyPaymentMF
                by solve( SOut( 'MS-PS', ~session, $ps_id, $ms_id, ~prepay_id
                          ) ▶₀ #vr.24 )
              qed
            qed
          qed
        qed
      qed
    qed
  next
    case MFCallPS_case_2
    solve( !KU( sign(<~prepay_id, $ms_id, ua_pk>, ~m_sk) ) @ #vk.16 )
      case OrderCreateOracle
      solve( !KU( pk(~ua_sk) ) @ #vk.16 )
        case OrderCreateOracle
        solve( SOut( 'MS-PS', ~session, $ms_id, $ps_id,
                     <pk(~ua_sk), $ms_id, ~order_id.1, amount.1, description.1, 
                      sign(<pk(~ua_sk), $ms_id, ~order_id.1, amount.1, description.1>, ~m_sk)>
               ) ▶₀ #vr.8 )
          case MSProcessOrderMF
          solve( SOut( 'U-PS', ~session, $u_id, $ps_id, 'Confirmed' ) ▶₀ #vr.2 )
            case UTrustPS
            solve( SOut( 'U-MF', ~session, $u_id, $mf_id,
                         <'OpenAppAndOrder', ~goods.1>
                   ) ▶₀ #vr.17 )
              case UOpenAndOrderMF
              solve( SOut( 'U-PS', ~session, $ps_id, $u_id,
                           'Do you trust this transaction?'
                     ) ▶₀ #vr.27 )
                case PSVerifyPaymentMF
                solve( SIn( 'U-PS', ~session, $u_id, $ps_id, ~password ) ▶₀ #i )
                  case SecureChannelSendRecv
                  solve( SOut( 'U-PS', ~session, $u_id, $ps_id, ~password ) ▶₀ #vr.28 )
                    case USubmitPasswordPS
                    solve( PS_State( 'waitpwd', ~session,
                                     <$ps_id.2, $u_id.1, $mf_id.1, $ms_id.1, ~p_sk.1, ua_pk, ~prepay_id.3, 
                                      ~order_id.3, amount.2, description.2>
                           ) ▶₁ #i2 )
                      case PSWaitpwd
                      by contradiction /* from formulas */
                    qed
                  qed

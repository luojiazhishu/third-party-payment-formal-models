lemma No_Payment_Without_Password_Input [heuristic={default}]:
  all-traces
  "∀ u p s #i.
    (PaymentComplete( u, h(p), s ) @ #i) ⇒
    (∃ #j.
      ((UserInputPwd( u, p, s ) @ #j) ∧ (#j < #i)) ∧
      (¬(∃ u2 p2 #i2.
          (PaymentComplete( u2, h(p2), s ) @ #i2) ∧ (¬(#i2 = #i)))))"
/*
guarded formula characterizing all counter-examples:
"∃ u p s #i.
  (PaymentComplete( u, h(p), s ) @ #i)
 ∧
  ∀ #j.
   (UserInputPwd( u, p, s ) @ #j)
  ⇒
   ((¬(#j < #i)) ∨
    (∃ u2 p2 #i2. (PaymentComplete( u2, h(p2), s ) @ #i2) ∧ ¬(#i2 = #i)))"
*/
simplify
solve( APS_State( 'waitpwd', ~session,
                  <$aps_id, $apa_id, $ms_id, ~a_sk, ~app_id, 
                   <~out_trade_no, total_amount, subject>, $notify_url, m_sig>
       ) ▶₂ #i )
  case APSVerifyPaymentAPA
  solve( SOut( 'APA-APS', ~session, $apa_id, $aps_id,
               <~app_id, <~out_trade_no, total_amount, subject>, $notify_url, 
                sign(<~app_id, <~out_trade_no, total_amount, subject>, $notify_url>,
                     ~m_sk)
               >
         ) ▶₀ #vr.1 )
    case APASendPaymentAPS_case_1
    solve( SOut( 'MA-APA', ~session, $ma_id, $apa_id,
                 <~app_id, <~out_trade_no, total_amount, subject>, $notify_url, 
                  sign(<~app_id, <~out_trade_no, total_amount, subject>, $notify_url>,
                       ~m_sk)
                 >
           ) ▶₀ #vr.9 )
      case MACallAPA
      solve( SOut( 'MA-MS', ~session, $ms_id, $ma_id,
                   <~app_id, <~out_trade_no, total_amount, subject>, $notify_url, 
                    sign(<~app_id, <~out_trade_no, total_amount, subject>, $notify_url>,
                         ~m_sk)
                   >
             ) ▶₀ #vr.11 )
        case MSProcessOrderMA
        solve( SOut( 'U-MA', ~session, $u_id.1, $ma_id,
                     <'OpenAppAndOrder', ~goods.1>
               ) ▶₀ #vr.13 )
          case UOpenAndOrderMA
          solve( SIn( 'APA-APS', ~session, $apa_id, $aps_id, h(p) ) ▶₁ #i )
            case SecureChannelSendRecv
            solve( SOut( 'APA-APS', ~session, $apa_id, $aps_id, h(p) ) ▶₀ #vr.17 )
              case APASubmitPasswordAPS
              solve( SOut( 'U-APA', ~session, $u_id.1, $apa_id, ~password ) ▶₀ #vr.19 )

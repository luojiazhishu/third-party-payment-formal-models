theory Alipay_Mobile_Web_Model begin

// Function signature and definition of the equational theory E

functions: calc_amt/1, fst/1, gen_desc/1, h/1, pair/2, pk/1, sign/2,
           snd/1, true/0, verify/3
equations:
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true

tactic: default
presort: S
prio: {id}
  regex".*Commit.*"
prio: {id}
  regex".*!KU\(.*m_sk.*"
prio: {id}
  regex".*m_sk.*"
prio: {id}
  regex".*_State.*"
prio: {id}
  regex".*sign.*"
prio: {id}
  regex".*APS_PubKey.*"
prio: {id}
  regex".*SOut\(.*U-.*"
prio: {id}
  regex".*SOut\(.*-APS.*"
prio: {id}
  regex".*SIn\(.*U-.*"
prio: {id}
  regex".*SIn\(.*-APS.*"


tactic: typing
presort: S
prio: {id}
  regex".*!KU\(\s*sign.*"
prio: {id}
  regex".*SOURCE_.*"
prio: {id}
  regex".*APS_PubKey.*"
prio: {id}
  regex".*SOut\(.*U-.*"
prio: {id}
  regex".*SOut\(.*-APS.*"
prio: {id}
  regex".*SIn\(.*U-.*"
prio: {id}
  regex".*SIn\(.*-APS.*"
prio: {id}
  regex".*_State.*"
deprio: {id}
  regex".*SOut*"
deprio: {id}
  regex".*SIn*"



heuristic: S





restriction OnlyOnceV:
  "∀ x #i #j. ((OnlyOnceV( x ) @ #i) ∧ (OnlyOnceV( x ) @ #j)) ⇒ (#i = #j)"
  // safety formula

restriction Equality:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

restriction Inequality:
  "∀ x #i. (Neq( x, x ) @ #i) ⇒ (⊥)"
  // safety formula

restriction InsecureChannel:
  "∀ ch_id #i. (InsecureChannel( ch_id ) @ #i) ⇒ (ch_id = 'MW-MS')"
  // safety formula

rule (modulo E) SecureChannelSendRecv[color=#f0f5e5]:
   [ SOut( ch_id, ~session, $src, $dst, msg ) ]
  --[ Neq( $src, $dst ) ]->
   [ SIn( ch_id, ~session, $src, $dst, msg ) ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) breakChannelConfidentiality[color=#fccb16]:
   [ SOut( ch_id, ~session, $src, $dst, msg ) ]
  --[
  OnlyOnceV( <$src, $dst, msg> ), BreakChannelCon( ch_id ),
  InsecureChannel( ch_id ),
  SOURCE_IN_FACT_BkChaCon( ch_id, ~session, $src, $dst, msg )
  ]->
   [ SOut( ch_id, ~session, $src, $dst, msg ), Out( <$src, $dst, msg> ) ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) breakChannelIntegrity[color=#f25a47]:
   [ In( <ch_id, ~session, $src, $dst, msg> ) ]
  --[
  BreakChannelInt( ch_id ), InsecureChannel( ch_id ),
  SOURCE_OUT_FACT_BkChaInt( ch_id, ~session, $src, $dst, msg )
  ]->
   [ SIn( ch_id, ~session, $src, $dst, msg ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) OrderCreateOracle[color=#f9d27d]:
   [
   Fr( ~out_trade_no ), In( <total_amount, subject> ),
   !MerchantCreated( <$ms_id, ~app_id, $notify_url, ~m_sk> )
   ]
  -->
   [
   Out( <~app_id, <~out_trade_no, total_amount, subject>, $notify_url, 
         sign(<~app_id, <~out_trade_no, total_amount, subject>, $notify_url>,
              ~m_sk)
        >
   ),
   !MS_Database( $ms_id, $attacker, <~out_trade_no, total_amount, subject>,
                 ~out_trade_no
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) PaymentQueryOracle[color=#f9d27d]:
   [
   In( <~out_trade_no, total_amount, subject> ),
   !APS_Database( $aps_id, <~out_trade_no, total_amount, subject>,
                  ~out_trade_no
   )
   ]
  -->
   [ Out( <total_amount, subject> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) CreateAPS[color=#d3c3f3]:
   [ Fr( ~a_sk ) ]
  --[ OnlyOnceV( 'APS' ) ]->
   [ !APS_PriKey( ~a_sk ), !APS_PubKey( pk(~a_sk) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) CreateAPA[color=#c4c3f3]:
   [ ]
  --[ OnlyOnceV( <'APA', $apa_id> ) ]->
   [ APA_State( 'created', 'null', $apa_id ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) CreateMW[color=#f3c3c7]:
   [ ]
  --[ OnlyOnceV( <'MW', $mw_id> ) ]->
   [ MW_State( 'created', 'null', $mw_id ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) CreateU[color=#c5f3c3]:
   [ Fr( ~password ) ]
  --[ OnlyOnceV( 'U' ) ]->
   [
   !UserRegistered( <$u_id, h(~password)> ),
   !UserPassword( <$u_id, ~password> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) CreateMS[color=#f3ccc3]:
   [ Fr( ~app_id ), Fr( ~m_sk ) ]
  --[ OnlyOnceV( <'MS', $ms_id> ) ]->
   [
   !MerchantRegistered( <$ms_id, ~app_id, pk(~m_sk)> ),
   !MerchantCreated( <$ms_id, ~app_id, $notify_url, ~m_sk> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) NewPaymentSession[color=#d0deaa]:
   [
   Fr( ~session ), !APS_PriKey( ~a_sk ),
   !UserPassword( <$u_id, ~password> ),
   !MerchantCreated( <$ms_id, ~app_id, $notify_url, ~m_sk> ),
   MW_State( 'created', 'null', $mw_id ),
   APA_State( 'created', 'null', $apa_id )
   ]
  --[ Start( ~session, $u_id, $mw_id, $ms_id, $apa_id, $aps_id ) ]->
   [
   U_State( 'init', ~session,
            <$u_id, $mw_id, $ms_id, $apa_id, $aps_id, ~password>
   ),
   MW_State( 'init', ~session, <$mw_id, $u_id, $ms_id, $apa_id> ),
   MS_State( 'init', ~session,
             <$ms_id, $mw_id, $aps_id, $u_id, $notify_url, ~app_id, ~m_sk>
   ),
   APA_State( 'init', ~session, <$apa_id, $u_id, $mw_id, $aps_id> ),
   APS_State( 'init', ~session, <$aps_id, $apa_id, $ms_id, ~a_sk> ),
   Out( ~session )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) UOpenAndOrderMW[role="U"]:
   [
   Fr( ~goods ),
   U_State( 'init', ~session,
            <$u_id, $mw_id, $ms_id, $apa_id, $aps_id, ~password>
   )
   ]
  -->
   [
   U_State( 'ordered', ~session,
            <$u_id, $mw_id, $ms_id, $apa_id, $aps_id, ~password, ~goods>
   ),
   SOut( 'U-MW', ~session, $u_id, $mw_id, <'OpenAppAndOrder', ~goods> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) MWOrderMS[role="MW"]:
   [
   SIn( 'U-MW', ~session, $u_id, $mw_id, <'OpenAppAndOrder', ~goods> ),
   MW_State( 'init', ~session, <$mw_id, $u_id, $ms_id, $apa_id> )
   ]
  --[ SOURCE_OUT_FACT_BkChaCon( 'MW-MS', ~session, $mw_id, $ms_id, ~goods )
  ]->
   [
   SOut( 'MW-MS', ~session, $mw_id, $ms_id, ~goods ),
   MW_State( 'ordered', ~session, <$mw_id, $u_id, $ms_id, $apa_id> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) MSProcessOrderMW[role="MS"]:
   [
   SIn( 'MW-MS', ~session, $mw_id, $ms_id, ~goods ),
   MS_State( 'init', ~session,
             <$ms_id, $mw_id, $aps_id, $u_id, $notify_url, ~app_id, ~m_sk>
   ),
   Fr( ~out_trade_no )
   ]
  --[
  SOURCE_OUT_FACT_BkChaCon( 'MW-MS', ~session, $ms_id, $mw_id,
                            <~app_id, <~out_trade_no, calc_amt(~goods), gen_desc(~goods)>, 
                             $notify_url, 
                             sign(<~app_id, <~out_trade_no, calc_amt(~goods), gen_desc(~goods)>, 
                                   $notify_url>,
                                  ~m_sk)
                            >
  ),
  SOURCE_OUT_FACT_M_SIGN( 'MW-MS', ~session, $ms_id, $mw_id,
                          <~app_id, <~out_trade_no, calc_amt(~goods), gen_desc(~goods)>, 
                           $notify_url, 
                           sign(<~app_id, <~out_trade_no, calc_amt(~goods), gen_desc(~goods)>, 
                                 $notify_url>,
                                ~m_sk)
                          >
  ),
  MS_Running( 'PSAuthMS', $ms_id, $aps_id,
              <~app_id, <~out_trade_no, calc_amt(~goods), gen_desc(~goods)>, 
               $notify_url, 
               sign(<~app_id, <~out_trade_no, calc_amt(~goods), gen_desc(~goods)>, 
                     $notify_url>,
                    ~m_sk)
              >
  ),
  MS_Running( 'UAuthMS', $ms_id, $u_id, ~out_trade_no )
  ]->
   [
   SOut( 'MW-MS', ~session, $ms_id, $mw_id,
         <~app_id, <~out_trade_no, calc_amt(~goods), gen_desc(~goods)>, 
          $notify_url, 
          sign(<~app_id, <~out_trade_no, calc_amt(~goods), gen_desc(~goods)>, 
                $notify_url>,
               ~m_sk)
         >
   ),
   !MS_Database( $ms_id, $u_id,
                 <~out_trade_no, calc_amt(~goods), gen_desc(~goods)>, ~out_trade_no
   ),
   MS_State( 'OrderProcessed', ~session,
             <$ms_id, $mw_id, $aps_id, $u_id, $notify_url, ~app_id, ~m_sk>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) MWCallAPA[role="MW"]:
   [
   SIn( 'MW-MS', ~session, $ms_id, $mw_id,
        <~app_id, <~out_trade_no, total_amount, subject>, $notify_url, m_sig>
   ),
   MW_State( 'ordered', ~session, <$mw_id, $u_id, $ms_id, $apa_id> )
   ]
  --[
  Finish( 'MW', ~session, $mw_id ),
  SOURCE_OUT_FACT_BkChaCon( 'MW-APA', ~session, $mw_id, $apa_id,
                            <~app_id, <~out_trade_no, total_amount, subject>, $notify_url, m_sig>
  ),
  SOURCE_IN_FACT_M_SIGN( 'MW-MS', ~session, $ms_id, $mw_id,
                         <~app_id, <~out_trade_no, total_amount, subject>, $notify_url, m_sig>
  )
  ]->
   [
   SOut( 'MW-APA', ~session, $mw_id, $apa_id,
         <~app_id, <~out_trade_no, total_amount, subject>, $notify_url, m_sig>
   ),
   MW_State( 'called', ~session,
             <$mw_id, $u_id, $ms_id, $apa_id, ~app_id, 
              <~out_trade_no, total_amount, subject>, $notify_url, m_sig>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) APASendPaymentAPS[role="APA"]:
   [
   SIn( 'MW-APA', ~session, $mw_id, $apa_id,
        <~app_id, <~out_trade_no, total_amount, subject>, $notify_url, m_sig>
   ),
   APA_State( 'init', ~session, <$apa_id, $u_id, $mw_id, $aps_id> )
   ]
  -->
   [
   SOut( 'APA-APS', ~session, $apa_id, $aps_id,
         <~app_id, <~out_trade_no, total_amount, subject>, $notify_url, m_sig>
   ),
   APA_State( 'paying', ~session,
              <$apa_id, $u_id, $mw_id, $aps_id, ~app_id, 
               <~out_trade_no, total_amount, subject>, $notify_url, m_sig>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) APSVerifyPaymentAPA[role="APS"]:
   [
   SIn( 'APA-APS', ~session, $apa_id, $aps_id,
        <~app_id, <~out_trade_no, total_amount, subject>, $notify_url, m_sig>
   ),
   APS_State( 'init', ~session, <$aps_id, $apa_id, $ms_id, ~a_sk> ),
   !MerchantRegistered( <$ms_id, ~app_id, m_pk> )
   ]
  --[
  Eq( verify(m_sig,
             <~app_id, <~out_trade_no, total_amount, subject>, $notify_url>, m_pk),
      true
  ),
  PS_Commit( 'PSAuthMS', $aps_id, $ms_id,
             <~app_id, <~out_trade_no, total_amount, subject>, $notify_url, m_sig>
  )
  ]->
   [
   SOut( 'APA-APS', ~session, $aps_id, $apa_id,
         <'SReqPwd', total_amount, subject>
   ),
   !APS_Database( $aps_id, <~out_trade_no, total_amount, subject>,
                  ~out_trade_no
   ),
   APS_State( 'waitpwd', ~session,
              <$aps_id, $apa_id, $ms_id, $u_id, ~a_sk, ~app_id, 
               <~out_trade_no, total_amount, subject>, $notify_url, m_sig>
   )
   ]

  /*
  rule (modulo AC) APSVerifyPaymentAPA[role="APS"]:
     [
     SIn( 'APA-APS', ~session, $apa_id, $aps_id,
          <~app_id, <~out_trade_no, total_amount, subject>, $notify_url, m_sig>
     ),
     APS_State( 'init', ~session, <$aps_id, $apa_id, $ms_id, ~a_sk> ),
     !MerchantRegistered( <$ms_id, ~app_id, m_pk> )
     ]
    --[
    Eq( z, true ),
    PS_Commit( 'PSAuthMS', $aps_id, $ms_id,
               <~app_id, <~out_trade_no, total_amount, subject>, $notify_url, m_sig>
    )
    ]->
     [
     SOut( 'APA-APS', ~session, $aps_id, $apa_id,
           <'SReqPwd', total_amount, subject>
     ),
     !APS_Database( $aps_id, <~out_trade_no, total_amount, subject>,
                    ~out_trade_no
     ),
     APS_State( 'waitpwd', ~session,
                <$aps_id, $apa_id, $ms_id, $u_id, ~a_sk, ~app_id, 
                 <~out_trade_no, total_amount, subject>, $notify_url, m_sig>
     )
     ]
    variants (modulo AC)
    1. $notify_url
             = $notify_url.29
       ~app_id
             = ~app_id.32
       ~out_trade_no
             = ~out_trade_no.33
       m_pk  = m_pk.35
       m_sig = m_sig.36
       subject
             = subject.37
       total_amount
             = total_amount.38
       z     = verify(m_sig.36,
                      <~app_id.32, <~out_trade_no.33, total_amount.38, subject.37>, 
                       $notify_url.29>,
                      m_pk.35)
    
    2. $notify_url
             = $notify_url.90
       ~app_id
             = ~app_id.93
       ~out_trade_no
             = ~out_trade_no.94
       m_pk  = pk(x.175)
       m_sig = sign(<~app_id.93, 
                     <~out_trade_no.94, total_amount.99, subject.98>, $notify_url.90>,
                    x.175)
       subject
             = subject.98
       total_amount
             = total_amount.99
       z     = true
  */

rule (modulo E) APARequestUserPassword[role="APA"]:
   [
   SIn( 'APA-APS', ~session, $aps_id, $apa_id,
        <'SReqPwd', total_amount, subject>
   ),
   APA_State( 'paying', ~session,
              <$apa_id, $u_id, $mw_id, $aps_id, ~app_id, 
               <~out_trade_no, total_amount, subject>, $notify_url, m_sig>
   )
   ]
  -->
   [
   SOut( 'U-APA', ~session, $apa_id, $u_id,
         <'AReqPwd', total_amount, subject, ~out_trade_no>
   ),
   APA_State( 'waitpwd', ~session,
              <$apa_id, $u_id, $mw_id, $aps_id, ~app_id, 
               <~out_trade_no, total_amount, subject>, $notify_url, m_sig>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) USubmitPasswordAPA[role="U"]:
   [
   U_State( 'ordered', ~session,
            <$u_id, $mw_id, $ms_id, $apa_id, $aps_id, ~password, ~goods>
   ),
   SIn( 'U-APA', ~session, $apa_id, $u_id,
        <'AReqPwd', calc_amt(~goods), gen_desc(~goods), ~out_trade_no>
   )
   ]
  --[
  UserInputPwd( $u_id, ~password, ~session ),
  U_Commit( 'UAuthMS', $u_id, $ms_id, ~out_trade_no )
  ]->
   [
   SOut( 'U-APA', ~session, $u_id, $apa_id, ~password ),
   U_State( 'pwdsubmitted', ~session,
            <$u_id, $mw_id, $ms_id, $apa_id, $aps_id, ~password, ~goods>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) APASubmitPasswordAPS[role="APA"]:
   [
   SIn( 'U-APA', ~session, $u_id, $apa_id, ~password ),
   APA_State( 'waitpwd', ~session, <$apa_id, $u_id, $mw_id, $aps_id, form> )
   ]
  -->
   [
   SOut( 'APA-APS', ~session, $apa_id, $aps_id, h(~password) ),
   APA_State( 'pwdsubmitted', ~session,
              <$apa_id, $u_id, $mw_id, $aps_id, form>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) APSVerifyPasswordAndConfirmAPAMS[role="APS"]:
   [
   Fr( ~trade_no ), SIn( 'APA-APS', ~session, $apa_id, $aps_id, pwd_hash ),
   APS_State( 'waitpwd', ~session,
              <$aps_id, $apa_id, $ms_id, $u_id, ~a_sk, ~app_id, 
               <~out_trade_no, total_amount, subject>, $notify_url, m_sig>
   ),
   !UserRegistered( <$u_id, pwd_hash> )
   ]
  --[
  Finish( 'APS', ~session, $aps_id ),
  SOURCE_OUT_FACT_RES_SIGN( sign(<~app_id, ~out_trade_no, ~trade_no, 
                                  total_amount>,
                                 ~a_sk)
  ),
  PS_Running( 'MSAuthPS', $aps_id, $ms_id,
              <~app_id, ~out_trade_no, ~trade_no, total_amount>
  ),
  PS_Running( 'UAuthPS', $aps_id, $u_id, <total_amount, subject> ),
  PaymentComplete( $u_id, pwd_hash, ~session )
  ]->
   [
   SOut( 'MS-APS', ~session, $aps_id, $notify_url,
         <<~app_id, ~out_trade_no, ~trade_no, total_amount>, 
          sign(<~app_id, ~out_trade_no, ~trade_no, total_amount>, ~a_sk)>
   ),
   SOut( 'APA-APS', ~session, $aps_id, $apa_id,
         <<~app_id, ~out_trade_no, ~trade_no, total_amount>, 
          sign(<~app_id, ~out_trade_no, ~trade_no, total_amount>, ~a_sk)>
   ),
   APS_State( 'confirmed', ~session,
              <$aps_id, $apa_id, $ms_id, ~app_id, 
               <~out_trade_no, total_amount, subject>, $notify_url, m_sig>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) MSReceiveNotification[role="MS"]:
   [
   !APS_PubKey( a_pk ),
   SIn( 'MS-APS', ~session, $aps_id, $notify_url,
        <<~app_id, ~out_trade_no, ~trade_no, total_amount>, res_sign>
   ),
   !MS_Database( $ms_id, $user, <~out_trade_no, total_amount, subject>,
                 ~out_trade_no
   ),
   MS_State( 'OrderProcessed', ~session,
             <$ms_id, $mw_id, $aps_id, $u_id, $notify_url, ~app_id, ~m_sk>
   )
   ]
  --[
  Eq( verify(res_sign, <~app_id, ~out_trade_no, ~trade_no, total_amount>,
             a_pk),
      true
  ),
  Finish( 'MS', ~session, $ms_id ), SOURCE_IN_FACT_RES_SIGN( res_sign ),
  MS_Commit( 'MSAuthPS', $ms_id, $aps_id,
             <~app_id, ~out_trade_no, ~trade_no, total_amount>
  )
  ]->
   [
   MS_State( 'completed', ~session,
             <$ms_id, $mw_id, $aps_id, $u_id, $notify_url, ~app_id, ~m_sk>
   )
   ]


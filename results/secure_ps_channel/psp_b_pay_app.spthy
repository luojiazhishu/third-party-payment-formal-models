lemma PS_MS_Order_Injective_Agreement [heuristic={default}]:
  all-traces
  "∀ ps ms o #i.
    (PS_Commit( 'PSAuthMS', ps, ms, o ) @ #i) ⇒
    (∃ #j.
      ((MS_Running( 'PSAuthMS', ms, ps, o ) @ #j) ∧ (#j < #i)) ∧
      (¬(∃ ps2 ms2 #i2.
          (PS_Commit( 'PSAuthMS', ps2, ms2, o ) @ #i2) ∧ (¬(#i2 = #i)))))"
/*
guarded formula characterizing all counter-examples:
"∃ ps ms o #i.
  (PS_Commit( 'PSAuthMS', ps, ms, o ) @ #i)
 ∧
  ∀ #j.
   (MS_Running( 'PSAuthMS', ms, ps, o ) @ #j)
  ⇒
   ((¬(#j < #i)) ∨
    (∃ ps2 ms2 #i2.
      (PS_Commit( 'PSAuthMS', ps2, ms2, o ) @ #i2) ∧ ¬(#i2 = #i)))"
*/
simplify
solve( BPS_State( 'init', ~session,
                  <$bps_id, $u_id, $ma_id, $ms_id, ~w_sk>
       ) ▶₁ #i )
  case NewPaymentSession
  solve( SIn( 'MS-BPS', ~session, $ms_id, $bps_id,
              <
               <~mch_id, ~nonce, 
                sign(<~nonce, ~app_id, ~mch_id, description, ~out_trade_no, $notify_url, 
                      amount>,
                     x)
               >, 
               ~app_id, ~mch_id, description, ~out_trade_no, $notify_url, amount>
         ) ▶₀ #i )
    case SecureChannelSendRecv
    solve( SOut( 'MS-BPS', ~session, $ms_id, $bps_id,
                 <
                  <~mch_id, ~nonce, 
                   sign(<~nonce, ~app_id, ~mch_id, description, ~out_trade_no, $notify_url, 
                         amount>,
                        x)
                  >, 
                  ~app_id, ~mch_id, description, ~out_trade_no, $notify_url, amount>
           ) ▶₀ #vr.5 )
      case MSProcessOrderBPS_case_1
      solve( !MerchantRegistered( <$ms_id, ~app_id, ~mch_id, pk(~m_sk)>
             ) ▶₂ #i )
        case CreateMS
        solve( BPS_State( 'init', ~session.1,
                          <$bps_id.1, $u_id.1, $ma_id.1, $ms_id.1, ~w_sk.1>
               ) ▶₁ #i2 )
          case NewPaymentSession
          solve( SIn( 'MS-BPS', ~session.1, $ms_id.1, $bps_id.1,
                      <
                       <~mch_id, ~nonce.1, 
                        sign(<~nonce.1, ~app_id, ~mch_id, gen_desc(~goods), ~out_trade_no, 
                              $notify_url, calc_amt(~goods)>,
                             x)
                       >, 
                       ~app_id, ~mch_id, gen_desc(~goods), ~out_trade_no, $notify_url, 
                       calc_amt(~goods)>
                 ) ▶₀ #i2 )
            case SecureChannelSendRecv
            solve( SOut( 'MS-BPS', ~session.1, $ms_id.1, $bps_id.1,
                         <
                          <~mch_id, ~nonce.1, 
                           sign(<~nonce.1, ~app_id, ~mch_id, gen_desc(~goods), ~out_trade_no, 
                                 $notify_url, calc_amt(~goods)>,
                                x)
                          >, 
                          ~app_id, ~mch_id, gen_desc(~goods), ~out_trade_no, $notify_url, 
                          calc_amt(~goods)>
                   ) ▶₀ #vr.11 )
              case MSProcessOrderBPS
              by contradiction /* from formulas */
            qed
          qed
        qed
      qed
    next
      case MSProcessOrderBPS_case_2
      solve( !MerchantRegistered( <$ms_id, ~app_id, ~mch_id, pk(~m_sk)>
             ) ▶₂ #i )
        case CreateMS
        solve( BPS_State( 'init', ~session.1,
                          <$bps_id.1, $u_id.1, $ma_id.1, $ms_id.1, ~w_sk.1>
               ) ▶₁ #i2 )
          case NewPaymentSession
          solve( SIn( 'MS-BPS', ~session.1, $ms_id.1, $bps_id.1,
                      <
                       <~mch_id, ~nonce.1, 
                        sign(<~nonce.1, ~app_id, ~mch_id, gen_desc(~goods), ~out_trade_no, 
                              $notify_url, calc_amt(~goods)>,
                             x)
                       >, 
                       ~app_id, ~mch_id, gen_desc(~goods), ~out_trade_no, $notify_url, 
                       calc_amt(~goods)>
                 ) ▶₀ #i2 )
            case SecureChannelSendRecv
            solve( SOut( 'MS-BPS', ~session.1, $ms_id.1, $bps_id.1,
                         <
                          <~mch_id, ~nonce.1, 
                           sign(<~nonce.1, ~app_id, ~mch_id, gen_desc(~goods), ~out_trade_no, 
                                 $notify_url, calc_amt(~goods)>,
                                x)
                          >, 
                          ~app_id, ~mch_id, gen_desc(~goods), ~out_trade_no, $notify_url, 
                          calc_amt(~goods)>
                   ) ▶₀ #vr.11 )
              case MSProcessOrderBPS
              by contradiction /* from formulas */
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma U_MS_Order_Injective_Agreement [heuristic={default}]:
  all-traces
  "∀ u ms o #i.
    (U_Commit( 'UAuthMS', u, ms, o ) @ #i) ⇒
    (∃ #j.
      ((MS_Running( 'UAuthMS', ms, u, o ) @ #j) ∧ (#j < #i)) ∧
      (¬(∃ u2 ms2 #i2.
          (U_Commit( 'UAuthMS', u2, ms2, o ) @ #i2) ∧ (¬(#i2 = #i)))))"
/*
guarded formula characterizing all counter-examples:
"∃ u ms o #i.
  (U_Commit( 'UAuthMS', u, ms, o ) @ #i)
 ∧
  ∀ #j.
   (MS_Running( 'UAuthMS', ms, u, o ) @ #j)
  ⇒
   ((¬(#j < #i)) ∨
    (∃ u2 ms2 #i2. (U_Commit( 'UAuthMS', u2, ms2, o ) @ #i2) ∧ ¬(#i2 = #i)))"
*/
simplify
solve( U_Commit( 'UAuthMS', u, ms, o ) @ #i )
  case USubmitPasswordBPS
  solve( U_State( 'ordered', ~session,
                  <$u_id, $ma_id, $bps_id, $ms_id, ~password, ~goods>
         ) ▶₀ #i )
    case UOpenAndOrderMA
    solve( SIn( 'U-BPS', ~session, $bps_id, $u_id,
                <'SReqPwd', calc_amt(~goods), gen_desc(~goods), ~prepay_id>
           ) ▶₁ #i )
      case SecureChannelSendRecv
      solve( SOut( 'U-BPS', ~session, $bps_id, $u_id,
                   <'SReqPwd', calc_amt(~goods), gen_desc(~goods), ~prepay_id>
             ) ▶₀ #vr.6 )
        case BPSVerifyPaymentMA_case_1
        solve( SOut( 'MA-BPS', ~session, $ma_id, $bps_id,
                     <~app_id, ~mch_id, ~prepay_id, ~nonce, 
                      sign(<~app_id, ~nonce, ~prepay_id>, ~m_sk)>
               ) ▶₀ #vr.8 )
          case MACallBPS_case_2
          solve( !KU( sign(<~app_id, ~nonce, ~prepay_id>, ~m_sk) ) @ #vk.21 )
            case OrderCreateOracle
            solve( SOut( 'MS-BPS', ~session, $ms_id, $bps_id,
                         <
                          <~mch_id, ~nonce.1, 
                           sign(<~nonce.1, ~app_id, ~mch_id, description, ~out_trade_no.1, 
                                 $notify_url.1, amount>,
                                ~m_sk)
                          >, 
                          ~app_id, ~mch_id, description, ~out_trade_no.1, $notify_url.1, amount>
                   ) ▶₀ #vr.11 )
              case MSProcessOrderBPS_case_1
              solve( SOut( 'U-MA', ~session, $u_id, $ma_id,
                           <'OpenAppAndOrder', ~goods.2>
                     ) ▶₀ #vr.15 )
                case UOpenAndOrderMA
                solve( !UserPassword( <$u_id, ~password> ) ▶₂ #i )
                  case CreateU
                  solve( SOut( 'MA-MS', ~session, $ma_id, $ms_id, ~goods.1 ) ▶₀ #vr.22 )
                    case MAOrderMS
                    solve( !KU( ~out_trade_no.2 ) @ #vk.17 )
                      case NewPaymentSession
                      solve( !KU( calc_amt(~goods) ) @ #vk.8 )
                        case PaymentQueryOracle_case_1
                        solve( SOut( 'MS-BPS', ~session.1, $ms_id.2, $bps_id.2,
                                     <
                                      <~mch_id.2, ~nonce.2, 
                                       sign(<~nonce.2, ~app_id.2, ~mch_id.2, gen_desc(~goods), 
                                             ~out_trade_no.3, $notify_url.2, calc_amt(~goods)>,
                                            ~m_sk.2)
                                      >, 
                                      ~app_id.2, ~mch_id.2, gen_desc(~goods), ~out_trade_no.3, $notify_url.2, 
                                      calc_amt(~goods)>
                               ) ▶₀ #vr.29 )
                          case MSProcessOrderBPS
                          solve( SOut( 'MA-MS', ~session.1, $ma_id.1, $ms_id.1, ~goods
                                 ) ▶₀ #vr.33 )
                            case MAOrderMS
                            solve( SOut( 'U-MA', ~session.1, $u_id, $ma_id.1,
                                         <'OpenAppAndOrder', ~goods>
                                   ) ▶₀ #vr.35 )
                              case UOpenAndOrderMA
                              solve( !KU( ~prepay_id.1 ) @ #vk.22 )
                                case breakChannelConfidentiality_case_2
                                solve( SOut( 'MA-MS', ~session.1, $src, $dst,
                                             <~out_trade_no.3, ~app_id.2, ~mch_id.2, ~prepay_id.1, ~nonce.2, 
                                              sign(<~app_id.2, ~nonce.2, ~prepay_id.1>, ~m_sk.2)>
                                       ) ▶₀ #vr.27 )
                                  case MSSendPrepayidMA
                                  solve( SOut( 'MS-BPS', ~session.1, $bps_id.1, $src, ~prepay_id.1
                                         ) ▶₀ #vr.34 )
                                    case BPSSendPrepayidMS
                                    solve( !KU( ~session ) @ #vk.16 )
                                      case NewPaymentSession
                                      solve( !KU( ~app_id ) @ #vk.19 )
                                        case OrderCreateOracle
                                        solve( !KU( ~mch_id ) @ #vk.20 )
                                          case OrderCreateOracle
                                          solve( !KU( ~prepay_id ) @ #vk.21 )
                                            case OrderCreateOracle
                                            solve( !KU( ~nonce.1 ) @ #vk.22 )
                                              case OrderCreateOracle
                                              solve( !KU( gen_desc(~goods) ) @ #vk.19 )
                                                case PaymentQueryOracle
                                                SOLVED // trace found
                                              qed
                                            qed
                                          qed
                                        qed
                                      qed
                                    qed
                                  qed
                                qed
                              qed
                            qed
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed


theory Pay_Repair_Model_Regular_Order begin

// Function signature and definition of the equational theory E

functions: calc_amt/1, fst/1, gen_desc/1, h/1, pair/2, pk/1, sign/2,
           snd/1, true/0, verify/3
equations:
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true

tactic: default
presort: S
prio: {id}
  regex".*Commit.*"
prio: {id}
  regex".*_State.*"
prio: {id}
  regex".*!KU\(.*_sk.*"
prio: {id}
  regex".*_sk.*"
prio: {id}
  regex".*sign.*"
prio: {id}
  regex".*PS_PubKey.*"
prio: {id}
  regex".*SOut\(.*U-.*"
prio: {id}
  regex".*SOut\(.*-PS.*"
prio: {id}
  regex".*SIn\(.*U-.*"
prio: {id}
  regex".*SIn\(.*-PS.*"


tactic: typing
presort: S
prio: {id}
  regex".*!KU\(\s*sign.*"
prio: {id}
  regex".*SOURCE_.*"
prio: {id}
  regex".*PS_PubKey.*"
prio: {id}
  regex".*SOut\(.*U-.*"
prio: {id}
  regex".*SOut\(.*-PS.*"
prio: {id}
  regex".*SIn\(.*U-.*"
prio: {id}
  regex".*SIn\(.*-PS.*"
prio: {id}
  regex".*_State.*"
deprio: {id}
  regex".*SOut*"
deprio: {id}
  regex".*SIn*"



heuristic: S





restriction OnlyOnceV:
  "∀ x #i #j. ((OnlyOnceV( x ) @ #i) ∧ (OnlyOnceV( x ) @ #j)) ⇒ (#i = #j)"
  // safety formula

restriction Equality:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

restriction Inequality:
  "∀ x #i. (Neq( x, x ) @ #i) ⇒ (⊥)"
  // safety formula

restriction InsecureChannel:
  "∀ ch_id #i.
    (InsecureChannel( ch_id ) @ #i) ⇒
    ((ch_id = 'MF-MS') ∨ (ch_id = 'MF-PS'))"
  // safety formula

rule (modulo E) SecureChannelSendRecv[color=#f0f5e5]:
   [ SOut( ch_id, ~session, $src, $dst, msg ) ]
  --[ Neq( $src, $dst ) ]->
   [ SIn( ch_id, ~session, $src, $dst, msg ) ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) breakChannelConfidentiality[color=#fccb16]:
   [ SOut( ch_id, ~session, $src, $dst, msg ) ]
  --[
  OnlyOnceV( <$src, $dst, msg> ), BreakChannelCon( ch_id ),
  InsecureChannel( ch_id ),
  SOURCE_IN_FACT_BkChaCon( ch_id, ~session, $src, $dst, msg )
  ]->
   [ SOut( ch_id, ~session, $src, $dst, msg ), Out( <$src, $dst, msg> ) ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) breakChannelIntegrity[color=#f25a47]:
   [ In( <ch_id, ~session, $src, $dst, msg> ) ]
  --[
  BreakChannelInt( ch_id ), InsecureChannel( ch_id ),
  SOURCE_OUT_FACT_BkChaInt( ch_id, ~session, $src, $dst, msg )
  ]->
   [ SIn( ch_id, ~session, $src, $dst, msg ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) OrderCreateOracle[color=#f9d27d]:
   [
   Fr( ~prepay_id ), Fr( ~order_id ), In( <amount, description> ),
   !MerchantCreated( <$ms_id, ~m_sk> )
   ]
  -->
   [
   Out( <~prepay_id, $ms_id, sign(<~prepay_id, $ms_id>, ~m_sk)> ),
   !MS_Database( $ms_id, $attacker, ~prepay_id, amount, description,
                 ~order_id
   ),
   !PS_Database( $ps_id, ~prepay_id, amount, description, ~order_id )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) PaymentQueryOracle[color=#f9d27d]:
   [
   In( ~prepay_id ),
   !PS_Database( $ps_id, ~prepay_id, amount, description, ~order_id )
   ]
  -->
   [ Out( <amount, description> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) CreatePS[color=#d3c3f3]:
   [ Fr( ~p_sk ) ]
  --[ OnlyOnceV( 'PS' ) ]->
   [ !PS_PriKey( ~p_sk ), !PS_PubKey( pk(~p_sk) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) CreateMF[color=#f3c3c7]:
   [ ]
  --[ OnlyOnceV( <'MF', $mf_id> ) ]->
   [ MF_State( 'created', 'null', $mf_id ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) CreateU[color=#c5f3c3]:
   [ Fr( ~password ) ]
  --[ OnlyOnceV( 'U' ) ]->
   [
   !UserRegistered( <$u_id, h(~password)> ),
   !UserPassword( <$u_id, ~password> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) CreateMS[color=#f3ccc3]:
   [ Fr( ~m_sk ), Fr( ~ua_sk ) ]
  --[ OnlyOnceV( <'MS', $ms_id> ) ]->
   [
   !MerchantRegistered( <$ms_id, pk(~m_sk)> ),
   !MerchantCreated( <$ms_id, ~m_sk> ),
   !UserRegisteredSecretKey( <$u_id, $ms_id, ~ua_sk> ),
   !UserRegisteredPublicKey( <$u_id, $ms_id, pk(~ua_sk)> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) NewPaymentSession[color=#d0deaa]:
   [
   Fr( ~session ), !PS_PriKey( ~p_sk ), !UserPassword( <$u_id, ~password> ),
   !MerchantCreated( <$ms_id, ~m_sk> ),
   MF_State( 'created', 'null', $mf_id )
   ]
  --[ Start( ~session, $u_id, $mf_id, $ms_id, $ps_id ) ]->
   [
   U_State( 'init', ~session, <$u_id, $mf_id, $ms_id, $ps_id, ~password> ),
   MF_State( 'init', ~session, <$mf_id, $u_id, $ms_id, $ps_id> ),
   MS_State( 'init', ~session, <$ms_id, $mf_id, $ps_id, $u_id, ~m_sk> ),
   PS_State( 'init', ~session, <$ps_id, $u_id, $mf_id, $ms_id, ~p_sk> ),
   Out( ~session )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) UOpenAndOrderMF[role="U"]:
   [
   Fr( ~goods ),
   U_State( 'init', ~session, <$u_id, $mf_id, $ms_id, $ps_id, ~password> )
   ]
  -->
   [
   U_State( 'ordered', ~session,
            <$u_id, $mf_id, $ms_id, $ps_id, ~password, ~goods>
   ),
   SOut( 'U-MF', ~session, $u_id, $mf_id, <'OpenAppAndOrder', ~goods> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) MFOrderMS[role="MF"]:
   [
   SIn( 'U-MF', ~session, $u_id, $mf_id, <'OpenAppAndOrder', ~goods> ),
   MF_State( 'init', ~session, <$mf_id, $u_id, $ms_id, $ps_id> )
   ]
  --[
  SOURCE_OUT_FACT_BkChaCon( 'MF-MS', ~session, $mf_id, $ms_id,
                            <$u_id, ~goods>
  )
  ]->
   [
   SOut( 'MF-MS', ~session, $mf_id, $ms_id, <$u_id, ~goods> ),
   MF_State( 'ordered', ~session, <$mf_id, $u_id, $ms_id, $ps_id> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) MSProcessOrderMF[role="MS"]:
   [
   SIn( 'MF-MS', ~session, $mf_id, $ms_id, <$u_id, ~goods> ),
   MS_State( 'init', ~session, <$ms_id, $mf_id, $ps_id, $u_id, ~m_sk> ),
   !UserRegisteredPublicKey( <$u_id, $ms_id, ua_pk> ), Fr( ~order_id )
   ]
  --[
  SOURCE_OUT_FACT_BkChaCon( 'MS-PS', ~session, $ms_id, $ps_id,
                            <ua_pk, $ms_id, ~order_id, calc_amt(~goods), gen_desc(~goods), 
                             sign(<$ms_id, ~order_id, calc_amt(~goods), gen_desc(~goods)>, ~m_sk)>
  ),
  SOURCE_OUT_FACT_M_SIGN_2( 'MS-PS', ~session, $ms_id, $ps_id,
                            <ua_pk, $ms_id, ~order_id, calc_amt(~goods), gen_desc(~goods), 
                             sign(<$ms_id, ~order_id, calc_amt(~goods), gen_desc(~goods)>, ~m_sk)>
  ),
  MS_Running( 'PSAuthMS', $ms_id, $ps_id,
              <~order_id, calc_amt(~goods), gen_desc(~goods)>
  ),
  MS_Running( 'UAuthMS', $ms_id, $u_id, ~goods )
  ]->
   [
   SOut( 'MS-PS', ~session, $ms_id, $ps_id,
         <ua_pk, $ms_id, ~order_id, calc_amt(~goods), gen_desc(~goods), 
          sign(<$ms_id, ~order_id, calc_amt(~goods), gen_desc(~goods)>, ~m_sk)>
   ),
   MS_State( 'Sendupk', ~session,
             <$ms_id, $mf_id, $ps_id, $u_id, ~m_sk, ~order_id, ~goods>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) PSReceiveOrderMS[role="PS"]:
   [
   SIn( 'MS-PS', ~session, $ms_id, $ps_id,
        <ua_pk, $ms_id, ~order_id, amount, description, m_sig>
   ),
   PS_State( 'init', ~session, <$ps_id, $u_id, $mf_id, $ms_id, ~p_sk> ),
   !MerchantRegistered( <$ms_id, m_pk> ), Fr( ~prepay_id )
   ]
  --[
  Eq( verify(m_sig, <$ms_id, ~order_id, amount, description>, m_pk), true
  ),
  PS_Commit( 'PSAuthMS', $ps_id, $ms_id, <~order_id, amount, description>
  ),
  SOURCE_IN_FACT_M_SIGN_2( 'MS-PS', ~session, $ms_id, $ps_id,
                           <ua_pk, $ms_id, ~order_id, amount, description, m_sig>
  )
  ]->
   [
   SOut( 'MS-PS', ~session, $ps_id, $ms_id, ~prepay_id ),
   !PS_Database( $ps_id, ~prepay_id, amount, description, ~order_id ),
   PS_State( 'sendprepayid', ~session,
             <$ps_id, $u_id, $mf_id, $ms_id, ~p_sk, ua_pk>
   )
   ]

  /*
  rule (modulo AC) PSReceiveOrderMS[role="PS"]:
     [
     SIn( 'MS-PS', ~session, $ms_id, $ps_id,
          <ua_pk, $ms_id, ~order_id, amount, description, m_sig>
     ),
     PS_State( 'init', ~session, <$ps_id, $u_id, $mf_id, $ms_id, ~p_sk> ),
     !MerchantRegistered( <$ms_id, m_pk> ), Fr( ~prepay_id )
     ]
    --[
    Eq( z, true ),
    PS_Commit( 'PSAuthMS', $ps_id, $ms_id, <~order_id, amount, description>
    ),
    SOURCE_IN_FACT_M_SIGN_2( 'MS-PS', ~session, $ms_id, $ps_id,
                             <ua_pk, $ms_id, ~order_id, amount, description, m_sig>
    )
    ]->
     [
     SOut( 'MS-PS', ~session, $ps_id, $ms_id, ~prepay_id ),
     !PS_Database( $ps_id, ~prepay_id, amount, description, ~order_id ),
     PS_State( 'sendprepayid', ~session,
               <$ps_id, $u_id, $mf_id, $ms_id, ~p_sk, ua_pk>
     )
     ]
    variants (modulo AC)
    1. $ms_id
             = $ms_id.29
       ~order_id
             = ~order_id.32
       amount
             = amount.36
       description
             = description.37
       m_pk  = m_pk.38
       m_sig = m_sig.39
       z     = verify(m_sig.39,
                      <$ms_id.29, ~order_id.32, amount.36, description.37>, m_pk.38)
    
    2. $ms_id
             = $ms_id.79
       ~order_id
             = ~order_id.82
       amount
             = amount.86
       description
             = description.87
       m_pk  = pk(x.155)
       m_sig = sign(<$ms_id.79, ~order_id.82, amount.86, description.87>, x.155)
       z     = true
  */

rule (modulo E) MSSendPrepayidMF[role="MS"]:
   [
   SIn( 'MS-PS', ~session, $ps_id, $ms_id, ~prepay_id ),
   MS_State( 'Sendupk', ~session,
             <$ms_id, $mf_id, $ps_id, $u_id, ~m_sk, ~order_id, ~goods>
   ),
   !UserRegisteredSecretKey( <$u_id, $ms_id, ~ua_sk> )
   ]
  --[
  SOURCE_OUT_FACT_BkChaCon( 'MF-MS', ~session, $ms_id, $mf_id,
                            <~prepay_id, $ms_id, sign(<~prepay_id, $ms_id>, ~m_sk), 
                             sign(<~prepay_id, $ms_id>, ~ua_sk)>
  ),
  SOURCE_OUT_FACT_M_SIGN( 'MF-MS', ~session, $ms_id, $mf_id,
                          <~prepay_id, $ms_id, sign(<~prepay_id, $ms_id>, ~m_sk), 
                           sign(<~prepay_id, $ms_id>, ~ua_sk)>
  )
  ]->
   [
   SOut( 'MF-MS', ~session, $ms_id, $mf_id,
         <~prepay_id, $ms_id, sign(<~prepay_id, $ms_id>, ~m_sk), 
          sign(<~prepay_id, $ms_id>, ~ua_sk)>
   ),
   !MS_Database( $ms_id, $u_id, ~prepay_id, calc_amt(~goods),
                 gen_desc(~goods), ~order_id
   ),
   MS_State( 'sendprepayid', ~session,
             <$ms_id, $mf_id, $ps_id, $u_id, ~m_sk>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) MFCallPS[role="MF"]:
   [
   SIn( 'MF-MS', ~session, $ms_id, $mf_id,
        <~prepay_id, $ms_id, m_sig, u_sig>
   ),
   MF_State( 'ordered', ~session, <$mf_id, $u_id, $ms_id, $ps_id> )
   ]
  --[
  Finish( 'MF', ~session, $mf_id ),
  SOURCE_OUT_FACT_BkChaCon( 'MF-PS', ~session, $mf_id, $ps_id,
                            <~prepay_id, $ms_id, m_sig, u_sig>
  ),
  SOURCE_IN_FACT_M_SIGN( 'MF-MS', ~session, $ms_id, $mf_id,
                         <~prepay_id, $ms_id, m_sig, u_sig>
  )
  ]->
   [
   SOut( 'MF-PS', ~session, $mf_id, $ps_id,
         <~prepay_id, $ms_id, m_sig, u_sig>
   ),
   MF_State( 'called', ~session, <$mf_id, $u_id, $ms_id, $ps_id> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) PSVerifyPaymentMF[role="PS"]:
   [
   SIn( 'MF-PS', ~session, $mf_id, $ps_id,
        <~prepay_id, $ms_id, m_sig, u_sig>
   ),
   !PS_Database( $ps_id, ~prepay_id, amount, description, ~order_id ),
   PS_State( 'sendprepayid', ~session,
             <$ps_id, $u_id, $mf_id, $ms_id, ~p_sk, ua_pk>
   ),
   !MerchantRegistered( <$ms_id, m_pk> )
   ]
  --[
  Eq( verify(m_sig, <~prepay_id, $ms_id>, m_pk), true ),
  Eq( verify(u_sig, <~prepay_id, $ms_id>, ua_pk), true )
  ]->
   [
   SOut( 'U-PS', ~session, $ps_id, $u_id,
         <'SReqPwd and Trust', amount, description>
   ),
   PS_State( 'waitpwd', ~session,
             <$ps_id, $u_id, $mf_id, $ms_id, ~p_sk, ua_pk, ~prepay_id, ~order_id, 
              amount, description>
   )
   ]

  /*
  rule (modulo AC) PSVerifyPaymentMF[role="PS"]:
     [
     SIn( 'MF-PS', ~session, $mf_id, $ps_id,
          <~prepay_id, $ms_id, m_sig, u_sig>
     ),
     !PS_Database( $ps_id, ~prepay_id, amount, description, ~order_id ),
     PS_State( 'sendprepayid', ~session,
               <$ps_id, $u_id, $mf_id, $ms_id, ~p_sk, ua_pk>
     ),
     !MerchantRegistered( <$ms_id, m_pk> )
     ]
    --[ Eq( z, true ), Eq( z.1, true ) ]->
     [
     SOut( 'U-PS', ~session, $ps_id, $u_id,
           <'SReqPwd and Trust', amount, description>
     ),
     PS_State( 'waitpwd', ~session,
               <$ps_id, $u_id, $mf_id, $ms_id, ~p_sk, ua_pk, ~prepay_id, ~order_id, 
                amount, description>
     )
     ]
    variants (modulo AC)
    1. $ms_id
             = $ms_id.35
       ~prepay_id
             = ~prepay_id.40
       m_pk  = m_pk.44
       m_sig = m_sig.45
       u_sig = u_sig.46
       ua_pk = ua_pk.47
       z     = verify(m_sig.45, <~prepay_id.40, $ms_id.35>, m_pk.44)
       z.1   = verify(u_sig.46, <~prepay_id.40, $ms_id.35>, ua_pk.47)
    
    2. $ms_id
             = $ms_id.112
       ~prepay_id
             = ~prepay_id.117
       m_pk  = pk(x.221)
       m_sig = sign(<~prepay_id.117, $ms_id.112>, x.221)
       u_sig = u_sig.123
       ua_pk = ua_pk.124
       z     = true
       z.1   = verify(u_sig.123, <~prepay_id.117, $ms_id.112>, ua_pk.124)
    
    3. $ms_id
             = $ms_id.113
       ~prepay_id
             = ~prepay_id.118
       m_pk  = pk(x.222)
       m_sig = sign(<~prepay_id.118, $ms_id.113>, x.222)
       u_sig = sign(<~prepay_id.118, $ms_id.113>, x.223)
       ua_pk = pk(x.223)
       z     = true
       z.1   = true
    
    4. $ms_id
             = $ms_id.114
       ~prepay_id
             = ~prepay_id.119
       m_pk  = m_pk.123
       m_sig = m_sig.124
       u_sig = sign(<~prepay_id.119, $ms_id.114>, x.225)
       ua_pk = pk(x.225)
       z     = verify(m_sig.124, <~prepay_id.119, $ms_id.114>, m_pk.123)
       z.1   = true
  */

rule (modulo E) USubmitPasswordPS[role="U"]:
   [
   U_State( 'ordered', ~session,
            <$u_id, $mf_id, $ms_id, $ps_id, ~password, ~goods>
   ),
   SIn( 'U-PS', ~session, $ps_id, $u_id,
        <'SReqPwd and Trust', calc_amt(~goods), gen_desc(~goods)>
   ),
   !UserPassword( <$u_id, ~password> )
   ]
  --[
  UserInputPwd( $u_id, ~password, ~session ),
  U_Commit( 'UAuthMS', $u_id, $ms_id, ~goods )
  ]->
   [
   SOut( 'U-PS', ~session, $u_id, $ps_id, ~password ),
   U_State( 'pwdsubmitted', ~session,
            <$u_id, $mf_id, $ms_id, $ps_id, ~password, ~goods>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) PSVerifyPasswordAndConfirmUMS[role="PS"]:
   [
   SIn( 'U-PS', ~session, $u_id, $ps_id, ~password ),
   PS_State( 'waitpwd', ~session,
             <$ps_id, $u_id, $mf_id, $ms_id, ~p_sk, ua_pk, ~prepay_id, ~order_id, 
              amount, description>
   ),
   !UserRegistered( <$u_id, h(~password)> ), Fr( ~trade_id )
   ]
  --[
  PS_Running( 'MSAuthPS', $ps_id, $ms_id, <~order_id, ~trade_id, amount> ),
  PS_Running( 'UAuthPS', $ps_id, $u_id, <amount, description> ),
  PaymentComplete( $u_id, h(~password), ~session ),
  Finish( 'PS', ~session, $ps_id )
  ]->
   [
   SOut( 'U-PS', ~session, $ps_id, $u_id,
         <'Successful', amount, description>
   ),
   SOut( 'MS-PS', ~session, $ps_id, $ms_id,
         <<~order_id, ~trade_id, amount>, 
          sign(<~order_id, ~trade_id, amount>, ~p_sk)>
   ),
   PS_State( 'paysuccess', ~session, <$ps_id, $u_id, $mf_id, $ms_id, ~p_sk>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) MSReceiveNotification[role="MS"]:
   [
   !PS_PubKey( p_pk ),
   SIn( 'MS-PS', ~session, $ps_id, $ms_id,
        <<~order_id, ~trade_id, amount>, res_sign>
   ),
   !MS_Database( $ms_id, $user, ~prepay_id, amount, description, ~order_id
   ),
   MS_State( 'sendprepayid', ~session,
             <$ms_id, $mf_id, $ps_id, $u_id, ~m_sk>
   )
   ]
  --[
  Eq( verify(res_sign, <~order_id, ~trade_id, amount>, p_pk), true ),
  Finish( 'MS', ~session, $ms_id ),
  MS_Commit( 'MSAuthPS', $ms_id, $ps_id, <~order_id, ~trade_id, amount> )
  ]->
   [
   MS_State( 'completed', ~session, <$ms_id, $mf_id, $ps_id, $u_id, ~m_sk> )
   ]

  /*
  rule (modulo AC) MSReceiveNotification[role="MS"]:
     [
     !PS_PubKey( p_pk ),
     SIn( 'MS-PS', ~session, $ps_id, $ms_id,
          <<~order_id, ~trade_id, amount>, res_sign>
     ),
     !MS_Database( $ms_id, $user, ~prepay_id, amount, description, ~order_id
     ),
     MS_State( 'sendprepayid', ~session,
               <$ms_id, $mf_id, $ps_id, $u_id, ~m_sk>
     )
     ]
    --[
    Eq( z, true ), Finish( 'MS', ~session, $ms_id ),
    MS_Commit( 'MSAuthPS', $ms_id, $ps_id, <~order_id, ~trade_id, amount> )
    ]->
     [
     MS_State( 'completed', ~session, <$ms_id, $mf_id, $ps_id, $u_id, ~m_sk> )
     ]
    variants (modulo AC)
    1. ~order_id
             = ~order_id.27
       ~trade_id
             = ~trade_id.30
       amount
             = amount.31
       p_pk  = p_pk.33
       res_sign
             = res_sign.34
       z     = verify(res_sign.34, <~order_id.27, ~trade_id.30, amount.31>,
                      p_pk.33)
    
    2. ~order_id
             = ~order_id.82
       ~trade_id
             = ~trade_id.85
       amount
             = amount.86
       p_pk  = pk(x.156)
       res_sign
             = sign(<~order_id.82, ~trade_id.85, amount.86>, x.156)
       z     = true
  */

rule (modulo E) UReceiveNotification[role="U"]:
   [
   SIn( 'U-PS', ~session, $ps_id, $u_id,
        <'Successful', calc_amt(~goods), gen_desc(~goods)>
   ),
   U_State( 'pwdsubmitted', ~session,
            <$u_id, $mf_id, $ms_id, $ps_id, ~password, ~goods>
   )
   ]
  --[
  Finish( 'U', ~session, $u_id ),
  U_Commit( 'UAuthPS', $u_id, $ps_id, <calc_amt(~goods), gen_desc(~goods)>
  )
  ]->
   [
   U_State( 'completed', ~session,
            <$u_id, $mf_id, $ms_id, $ps_id, ~password, ~goods>
   )
   ]

  /* has exactly the trivial AC variant */

lemma typing [sources, heuristic={typing}]:
  all-traces
  "((∀ m1 m2 m3 m4 m5 #i.
      (SOURCE_IN_FACT_BkChaCon( m1, m2, m3, m4, m5 ) @ #i) ⇒
      (∃ #j.
        (SOURCE_OUT_FACT_BkChaCon( m1, m2, m3, m4, m5 ) @ #j) ∧ (#j < #i))) ∧
    (∀ m1 m2 m3 m4 m5 #i.
      (SOURCE_IN_FACT_M_SIGN( m1, m2, m3, m4, m5 ) @ #i) ⇒
      ((∃ #j.
         (SOURCE_OUT_FACT_M_SIGN( m1, m2, m3, m4, m5 ) @ #j) ∧ (#j < #i)) ∨
       (∃ #j.
         (SOURCE_OUT_FACT_BkChaInt( m1, m2, m3, m4, m5 ) @ #j) ∧ (#j < #i))))) ∧
   (∀ m1 m2 m3 m4 m5 #i.
     (SOURCE_IN_FACT_M_SIGN_2( m1, m2, m3, m4, m5 ) @ #i) ⇒
     ((∃ #j.
        (SOURCE_OUT_FACT_M_SIGN_2( m1, m2, m3, m4, m5 ) @ #j) ∧ (#j < #i)) ∨
      (∃ #j.
        (SOURCE_OUT_FACT_BkChaInt( m1, m2, m3, m4, m5 ) @ #j) ∧ (#j < #i))))"
/*
guarded formula characterizing all counter-examples:
"((∃ m1 m2 m3 m4 m5 #i.
    (SOURCE_IN_FACT_BkChaCon( m1, m2, m3, m4, m5 ) @ #i)
   ∧
    ∀ #j.
     (SOURCE_OUT_FACT_BkChaCon( m1, m2, m3, m4, m5 ) @ #j) ⇒ ¬(#j < #i)) ∨
  (∃ m1 m2 m3 m4 m5 #i.
    (SOURCE_IN_FACT_M_SIGN( m1, m2, m3, m4, m5 ) @ #i)
   ∧
    (∀ #j.
      (SOURCE_OUT_FACT_M_SIGN( m1, m2, m3, m4, m5 ) @ #j) ⇒ ¬(#j < #i)) ∧
    (∀ #j.
      (SOURCE_OUT_FACT_BkChaInt( m1, m2, m3, m4, m5 ) @ #j) ⇒ ¬(#j < #i))) ∨
  (∃ m1 m2 m3 m4 m5 #i.
    (SOURCE_IN_FACT_M_SIGN_2( m1, m2, m3, m4, m5 ) @ #i)
   ∧
    (∀ #j.
      (SOURCE_OUT_FACT_M_SIGN_2( m1, m2, m3, m4, m5 ) @ #j) ⇒ ¬(#j < #i)) ∧
    (∀ #j.
      (SOURCE_OUT_FACT_BkChaInt( m1, m2, m3, m4, m5 ) @ #j) ⇒ ¬(#j < #i))))"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  simplify
  solve( (∃ m1 m2 m3 m4 m5 #i.
           (SOURCE_IN_FACT_BkChaCon( m1, m2, m3, m4, m5 ) @ #i)
          ∧
           ∀ #j.
            (SOURCE_OUT_FACT_BkChaCon( m1, m2, m3, m4, m5 ) @ #j) ⇒ ¬(#j < #i))  ∥
         (∃ m1 m2 m3 m4 m5 #i.
           (SOURCE_IN_FACT_M_SIGN( m1, m2, m3, m4, m5 ) @ #i)
          ∧
           (∀ #j.
             (SOURCE_OUT_FACT_M_SIGN( m1, m2, m3, m4, m5 ) @ #j) ⇒ ¬(#j < #i)) ∧
           (∀ #j.
             (SOURCE_OUT_FACT_BkChaInt( m1, m2, m3, m4, m5 ) @ #j) ⇒ ¬(#j < #i)))  ∥
         (∃ m1 m2 m3 m4 m5 #i.
           (SOURCE_IN_FACT_M_SIGN_2( m1, m2, m3, m4, m5 ) @ #i)
          ∧
           (∀ #j.
             (SOURCE_OUT_FACT_M_SIGN_2( m1, m2, m3, m4, m5 ) @ #j) ⇒ ¬(#j < #i)) ∧
           (∀ #j.
             (SOURCE_OUT_FACT_BkChaInt( m1, m2, m3, m4, m5 ) @ #j) ⇒ ¬(#j < #i))) )
    case case_1
    solve( (last(#i))  ∥
           (∃ #j.
             (SOURCE_OUT_FACT_BkChaCon( m1, ~session, $src, $dst, m5 ) @ #j)
            ∧
             (¬(last(#j))) ∧ (#j < #i)) )
      case case_1
      solve( (m1 = 'MF-MS')  ∥ (m1 = 'MF-PS') )
        case case_1
        solve( SOut( 'MF-MS', ~session, $src, $dst, m5 ) ▶₀ #i )
          case MFOrderMS
          by contradiction /* from formulas */
        next
          case MSSendPrepayidMF_case_1
          by contradiction /* from formulas */
        next
          case MSSendPrepayidMF_case_2
          by contradiction /* from formulas */
        next
          case breakChannelConfidentiality
          by contradiction /* cyclic */
        qed
      next
        case case_2
        solve( SOut( 'MF-PS', ~session, $src, $dst, m5 ) ▶₀ #i )
          case MFCallPS_case_1
          by contradiction /* from formulas */
        next
          case MFCallPS_case_2
          by contradiction /* from formulas */
        next
          case breakChannelConfidentiality
          by contradiction /* cyclic */
        qed
      qed
    next
      case case_2
      by contradiction /* from formulas */
    qed
  next
    case case_2
    solve( (last(#i))  ∥
           (∃ #j.
             (SOURCE_OUT_FACT_M_SIGN( 'MF-MS', ~session, $ms_id, $mf_id,
                                      <~prepay_id, $ms_id, m_sig, u_sig>
              ) @ #j)
            ∧
             (¬(last(#j))) ∧ (#j < #i))  ∥
           (∃ #j.
             (SOURCE_OUT_FACT_BkChaInt( 'MF-MS', ~session, $ms_id, $mf_id,
                                        <~prepay_id, $ms_id, m_sig, u_sig>
              ) @ #j)
            ∧
             (¬(last(#j))) ∧ (#j < #i)) )
      case case_1
      solve( MF_State( 'ordered', ~session, <$mf_id, $u_id, $ms_id, $ps_id>
             ) ▶₁ #i )
        case MFOrderMS
        solve( SOut( 'U-MF', ~session, $u_id, $mf_id, <'OpenAppAndOrder', ~goods>
               ) ▶₀ #vr.1 )
          case UOpenAndOrderMF
          solve( SIn( 'MF-MS', ~session, $ms_id, $mf_id,
                      <~prepay_id, $ms_id, m_sig, u_sig>
                 ) ▶₀ #i )
            case SecureChannelSendRecv
            solve( SOut( 'MF-MS', ~session, $ms_id, $mf_id,
                         <~prepay_id, $ms_id, m_sig, u_sig>
                   ) ▶₀ #vr.8 )
              case MSSendPrepayidMF_case_1
              by contradiction /* from formulas */
            next
              case MSSendPrepayidMF_case_2
              by contradiction /* from formulas */
            next
              case breakChannelConfidentiality
              solve( SOURCE_OUT_FACT_BkChaCon( 'MF-MS', ~session, $ms_id, $mf_id,
                                               <~prepay_id, $ms_id, m_sig, u_sig>
                     ) @ #j )
                case MSSendPrepayidMF
                by contradiction /* from formulas */
              qed
            qed
          next
            case breakChannelIntegrity
            by contradiction /* from formulas */
          qed
        next
          case breakChannelConfidentiality
          by contradiction /* from formulas */
        qed
      qed
    next
      case case_2
      by contradiction /* from formulas */
    next
      case case_3
      by contradiction /* from formulas */
    qed
  next
    case case_3
    solve( (last(#i))  ∥
           (∃ #j.
             (SOURCE_OUT_FACT_M_SIGN_2( 'MS-PS', ~session, $ms_id, $ps_id,
                                        <ua_pk, $ms_id, ~order_id, amount, description, 
                                         sign(<$ms_id, ~order_id, amount, description>, x)>
              ) @ #j)
            ∧
             (¬(last(#j))) ∧ (#j < #i))  ∥
           (∃ #j.
             (SOURCE_OUT_FACT_BkChaInt( 'MS-PS', ~session, $ms_id, $ps_id,
                                        <ua_pk, $ms_id, ~order_id, amount, description, 
                                         sign(<$ms_id, ~order_id, amount, description>, x)>
              ) @ #j)
            ∧
             (¬(last(#j))) ∧ (#j < #i)) )
      case case_1
      solve( SIn( 'MS-PS', ~session, $ms_id, $ps_id,
                  <ua_pk, $ms_id, ~order_id, amount, description, 
                   sign(<$ms_id, ~order_id, amount, description>, x)>
             ) ▶₀ #i )
        case SecureChannelSendRecv
        solve( SOut( 'MS-PS', ~session, $ms_id, $ps_id,
                     <ua_pk, $ms_id, ~order_id, amount, description, 
                      sign(<$ms_id, ~order_id, amount, description>, x)>
               ) ▶₀ #vr )
          case MSProcessOrderMF_case_1
          by contradiction /* from formulas */
        next
          case MSProcessOrderMF_case_2
          by contradiction /* from formulas */
        next
          case breakChannelConfidentiality
          by contradiction /* from formulas */
        qed
      next
        case breakChannelIntegrity
        by contradiction /* from formulas */
      qed
    next
      case case_2
      by contradiction /* from formulas */
    next
      case case_3
      by contradiction /* from formulas */
    qed
  qed
qed

lemma executable [heuristic={default}]:
  exists-trace
  "∃ session u_id mf_id ms_id ps_id #i #j #k #l #m.
    ((((Start( session, u_id, mf_id, ms_id, ps_id ) @ #m) ∧
       (Finish( 'U', session, u_id ) @ #i)) ∧
      (Finish( 'MF', session, mf_id ) @ #j)) ∧
     (Finish( 'MS', session, ms_id ) @ #k)) ∧
    (Finish( 'PS', session, ps_id ) @ #l)"
/*
guarded formula characterizing all satisfying traces:
"∃ session u_id mf_id ms_id ps_id #i #j #k #l #m.
  (Start( session, u_id, mf_id, ms_id, ps_id ) @ #m) ∧
  (Finish( 'U', session, u_id ) @ #i) ∧
  (Finish( 'MF', session, mf_id ) @ #j) ∧
  (Finish( 'MS', session, ms_id ) @ #k) ∧
  (Finish( 'PS', session, ps_id ) @ #l)"
*/
simplify
solve( MF_State( 'created', 'null', $mf_id ) ▶₄ #m )
  case CreateMF
  solve( !PS_PriKey( ~p_sk ) ▶₁ #m )
    case CreatePS
    solve( !MerchantCreated( <$ms_id, ~m_sk> ) ▶₃ #m )
      case CreateMS
      solve( !UserPassword( <$u_id, ~password> ) ▶₂ #m )
        case CreateU
        solve( Finish( 'U', ~session, $u_id ) @ #i )
          case UReceiveNotification
          solve( U_State( 'pwdsubmitted', ~session,
                          <$u_id, $mf_id, $ms_id, $ps_id, ~password, ~goods>
                 ) ▶₁ #i )
            case USubmitPasswordPS
            solve( SOut( 'U-PS', ~session, $ps_id, $u_id,
                         <'SReqPwd and Trust', calc_amt(~goods), gen_desc(~goods)>
                   ) ▶₀ #vr.6 )
              case PSVerifyPaymentMF_case_2
              solve( SOut( 'MF-PS', ~session, $mf_id, $ps_id,
                           <~prepay_id, $ms_id, sign(<~prepay_id, $ms_id>, ~m_sk), 
                            sign(<~prepay_id, $ms_id>, x)>
                     ) ▶₀ #vr.8 )
                case MFCallPS_case_1
                solve( SOut( 'MS-PS', ~session.1, $ms_id.1, $ps_id,
                             <ua_pk, $ms_id.1, ~order_id, calc_amt(~goods), gen_desc(~goods), 
                              sign(<$ms_id.1, ~order_id, calc_amt(~goods), gen_desc(~goods)>, ~m_sk.1)>
                       ) ▶₀ #vr.11 )
                  case MSProcessOrderMF_case_1
                  solve( SOut( 'MS-PS', ~session, $ms_id, $ps_id,
                               <pk(x), $ms_id, ~order_id.1, amount, description, 
                                sign(<$ms_id, ~order_id.1, amount, description>, ~m_sk)>
                         ) ▶₀ #vr.14 )
                    case MSProcessOrderMF_case_1
                    solve( SOut( 'MF-MS', ~session, $ms_id, $mf_id,
                                 <~prepay_id, $ms_id, sign(<~prepay_id, $ms_id>, ~m_sk), 
                                  sign(<~prepay_id, $ms_id>, ~ua_sk)>
                           ) ▶₀ #vr.17 )
                      case MSSendPrepayidMF
                      solve( SOut( 'U-MF', ~session, $u_id, $mf_id,
                                   <'OpenAppAndOrder', ~goods.2>
                             ) ▶₀ #vr.19 )
                        case UOpenAndOrderMF
                        solve( SOut( 'MS-PS', ~session, $ps_id, $ms_id, ~prepay_id ) ▶₀ #vr.25 )
                          case PSReceiveOrderMS
                          solve( SIn( 'U-PS', ~session, $ps_id, $u_id,
                                      <'Successful', calc_amt(~goods), gen_desc(~goods)>
                                 ) ▶₀ #i )
                            case SecureChannelSendRecv
                            solve( SOut( 'U-PS', ~session, $ps_id, $u_id,
                                         <'Successful', calc_amt(~goods), gen_desc(~goods)>
                                   ) ▶₀ #vr.19 )
                              case PSVerifyPasswordAndConfirmUMS
                              solve( SOut( 'U-PS', ~session, $u_id, $ps_id, ~password ) ▶₀ #vr.21 )
                                case USubmitPasswordPS
                                solve( Finish( 'MF', ~session, $mf_id ) @ #j )
                                  case MFCallPS
                                  solve( MF_State( 'ordered', ~session,
                                                   <$mf_id, $u_id.1, $ms_id.1, $ps_id.1>
                                         ) ▶₁ #j )
                                    case MFOrderMS
                                    solve( Finish( 'MS', ~session, $ms_id ) @ #k )
                                      case MSReceiveNotification
                                      solve( MS_State( 'sendprepayid', ~session,
                                                       <$ms_id, $mf_id.1, $ps_id.1, $u_id.1, ~m_sk.1>
                                             ) ▶₃ #k )
                                        case MSSendPrepayidMF
                                        solve( SIn( 'MS-PS', ~session, $ps_id, $ms_id,
                                                    <<~order_id, ~trade_id, amount>, 
                                                     sign(<~order_id, ~trade_id, amount>, x)>
                                               ) ▶₁ #k )
                                          case SecureChannelSendRecv
                                          solve( SOut( 'MS-PS', ~session, $ps_id, $ms_id,
                                                       <<~order_id, ~trade_id, amount>, 
                                                        sign(<~order_id, ~trade_id, amount>, x)>
                                                 ) ▶₀ #vr.21 )
                                            case PSVerifyPasswordAndConfirmUMS
                                            solve( !PS_PubKey( pk(~p_sk) ) ▶₀ #k )
                                              case CreatePS
                                              solve( !MS_Database( $ms_id, $user, ~prepay_id.1,
                                                                   calc_amt(~goods), description, ~order_id
                                                     ) ▶₂ #k )
                                                case MSSendPrepayidMF
                                                solve( Finish( 'PS', ~session, $ps_id ) @ #l )
                                                  case PSVerifyPasswordAndConfirmUMS
                                                  solve( PS_State( 'waitpwd', ~session,
                                                                   <$ps_id, $u_id.1, $mf_id.1, $ms_id.1, 
                                                                    ~p_sk.1, ua_pk, ~prepay_id.1, 
                                                                    ~order_id.1, amount, description>
                                                         ) ▶₁ #l )
                                                    case PSVerifyPaymentMF
                                                    solve( SOut( 'MF-MS', ~session, $mf_id, $ms_id,
                                                                 <$u_id, ~goods>
                                                           ) ▶₀ #vr.15 )
                                                      case MFOrderMS
                                                      SOLVED // trace found
                                                    qed
                                                  qed
                                                qed
                                              qed
                                            qed
                                          qed
                                        qed
                                      qed
                                    qed
                                  qed
                                qed
                              qed
                            qed
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma PS_MS_Order_Injective_Agreement [heuristic={default}]:
  all-traces
  "∀ ps ms o #i.
    (PS_Commit( 'PSAuthMS', ps, ms, o ) @ #i) ⇒
    (∃ #j.
      ((MS_Running( 'PSAuthMS', ms, ps, o ) @ #j) ∧ (#j < #i)) ∧
      (¬(∃ ps2 ms2 #i2.
          (PS_Commit( 'PSAuthMS', ps2, ms2, o ) @ #i2) ∧ (¬(#i2 = #i)))))"
/*
guarded formula characterizing all counter-examples:
"∃ ps ms o #i.
  (PS_Commit( 'PSAuthMS', ps, ms, o ) @ #i)
 ∧
  ∀ #j.
   (MS_Running( 'PSAuthMS', ms, ps, o ) @ #j)
  ⇒
   ((¬(#j < #i)) ∨
    (∃ ps2 ms2 #i2.
      (PS_Commit( 'PSAuthMS', ps2, ms2, o ) @ #i2) ∧ ¬(#i2 = #i)))"
*/
simplify
solve( PS_State( 'init', ~session, <$ps_id, $u_id, $mf_id, $ms_id, ~p_sk>
       ) ▶₁ #i )
  case NewPaymentSession
  solve( SIn( 'MS-PS', ~session, $ms_id, $ps_id,
              <ua_pk, $ms_id, ~order_id, amount, description, 
               sign(<$ms_id, ~order_id, amount, description>, x)>
         ) ▶₀ #i )
    case SecureChannelSendRecv
    solve( SOut( 'MS-PS', ~session, $ms_id, $ps_id,
                 <ua_pk, $ms_id, ~order_id, amount, description, 
                  sign(<$ms_id, ~order_id, amount, description>, x)>
           ) ▶₀ #vr.5 )
      case MSProcessOrderMF_case_1
      solve( PS_State( 'init', ~session.1,
                       <$ps_id.1, $u_id.1, $mf_id.1, $ms_id.1, ~p_sk.1>
             ) ▶₁ #i2 )
        case NewPaymentSession
        solve( !MerchantRegistered( <$ms_id, pk(~m_sk)> ) ▶₂ #i )
          case CreateMS
          solve( SIn( 'MS-PS', ~session.1, $ms_id.1, $ps_id.1,
                      <ua_pk, $ms_id.1, ~order_id, calc_amt(~goods), gen_desc(~goods), 
                       sign(<$ms_id.1, ~order_id, calc_amt(~goods), gen_desc(~goods)>, x)>
                 ) ▶₀ #i2 )
            case SecureChannelSendRecv
            solve( SOut( 'MS-PS', ~session.1, $ms_id.1, $ps_id.1,
                         <ua_pk, $ms_id.1, ~order_id, calc_amt(~goods), gen_desc(~goods), 
                          sign(<$ms_id.1, ~order_id, calc_amt(~goods), gen_desc(~goods)>, x)>
                   ) ▶₀ #vr.11 )
              case MSProcessOrderMF
              by contradiction /* from formulas */
            qed
          next
            case breakChannelIntegrity
            by contradiction /* from formulas */
          qed
        qed
      qed
    next
      case MSProcessOrderMF_case_2
      solve( PS_State( 'init', ~session.1,
                       <$ps_id.1, $u_id.1, $mf_id.1, $ms_id.1, ~p_sk.1>
             ) ▶₁ #i2 )
        case NewPaymentSession
        solve( !MerchantRegistered( <$ms_id, pk(~m_sk)> ) ▶₂ #i )
          case CreateMS
          solve( SIn( 'MS-PS', ~session.1, $ms_id.1, $ps_id.1,
                      <ua_pk, $ms_id.1, ~order_id, calc_amt(~goods), gen_desc(~goods), 
                       sign(<$ms_id.1, ~order_id, calc_amt(~goods), gen_desc(~goods)>, x)>
                 ) ▶₀ #i2 )
            case SecureChannelSendRecv
            solve( SOut( 'MS-PS', ~session.1, $ms_id.1, $ps_id.1,
                         <ua_pk, $ms_id.1, ~order_id, calc_amt(~goods), gen_desc(~goods), 
                          sign(<$ms_id.1, ~order_id, calc_amt(~goods), gen_desc(~goods)>, x)>
                   ) ▶₀ #vr.11 )
              case MSProcessOrderMF
              by contradiction /* from formulas */
            qed
          next
            case breakChannelIntegrity
            by contradiction /* from formulas */
          qed
        qed
      qed
    qed
  next
    case breakChannelIntegrity
    by contradiction /* from formulas */
  qed
qed

lemma U_MS_Order_Injective_Agreement [heuristic={default}]:
  all-traces
  "∀ u ms o #i.
    (U_Commit( 'UAuthMS', u, ms, o ) @ #i) ⇒
    (∃ #j.
      ((MS_Running( 'UAuthMS', ms, u, o ) @ #j) ∧ (#j < #i)) ∧
      (¬(∃ u2 ms2 #i2.
          (U_Commit( 'UAuthMS', u2, ms2, o ) @ #i2) ∧ (¬(#i2 = #i)))))"
/*
guarded formula characterizing all counter-examples:
"∃ u ms o #i.
  (U_Commit( 'UAuthMS', u, ms, o ) @ #i)
 ∧
  ∀ #j.
   (MS_Running( 'UAuthMS', ms, u, o ) @ #j)
  ⇒
   ((¬(#j < #i)) ∨
    (∃ u2 ms2 #i2. (U_Commit( 'UAuthMS', u2, ms2, o ) @ #i2) ∧ ¬(#i2 = #i)))"
*/
simplify
solve( U_Commit( 'UAuthMS', u, ms, o ) @ #i )
  case USubmitPasswordPS
  solve( U_State( 'ordered', ~session,
                  <$u_id, $mf_id, $ms_id, $ps_id, ~password, ~goods>
         ) ▶₀ #i )
    case UOpenAndOrderMF
    solve( SIn( 'U-PS', ~session, $ps_id, $u_id,
                <'SReqPwd and Trust', calc_amt(~goods), gen_desc(~goods)>
           ) ▶₁ #i )
      case SecureChannelSendRecv
      solve( SOut( 'U-PS', ~session, $ps_id, $u_id,
                   <'SReqPwd and Trust', calc_amt(~goods), gen_desc(~goods)>
             ) ▶₀ #vr.6 )
        case PSVerifyPaymentMF_case_1
        solve( SOut( 'MF-PS', ~session, $mf_id, $ps_id,
                     <~prepay_id, $ms_id, sign(<~prepay_id, $ms_id>, ~m_sk), 
                      sign(<~prepay_id, $ms_id>, x)>
               ) ▶₀ #vr.8 )
          case MFCallPS_case_1
          solve( SOut( 'MS-PS', ~session, $ms_id, $ps_id,
                       <pk(x), $ms_id, ~order_id.1, amount, description, 
                        sign(<$ms_id, ~order_id.1, amount, description>, ~m_sk)>
                 ) ▶₀ #vr.12 )
            case MSProcessOrderMF_case_1
            solve( SOut( 'MF-MS', ~session, $ms_id, $mf_id,
                         <~prepay_id, $ms_id, sign(<~prepay_id, $ms_id>, ~m_sk), 
                          sign(<~prepay_id, $ms_id>, ~ua_sk)>
                   ) ▶₀ #vr.14 )

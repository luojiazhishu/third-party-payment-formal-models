lemma MS_PS_Response_Injective_Agreement [heuristic={default}]:
  all-traces
  "∀ ms ps o #i.
    (MS_Commit( 'MSAuthPS', ms, ps, o ) @ #i) ⇒
    (∃ #j.
      ((PS_Running( 'MSAuthPS', ps, ms, o ) @ #j) ∧ (#j < #i)) ∧
      (¬(∃ ms2 ps2 #i2.
          (MS_Commit( 'MSAuthPS', ms2, ps2, o ) @ #i2) ∧ (¬(#i2 = #i)))))"
/*
guarded formula characterizing all counter-examples:
"∃ ms ps o #i.
  (MS_Commit( 'MSAuthPS', ms, ps, o ) @ #i)
 ∧
  ∀ #j.
   (PS_Running( 'MSAuthPS', ps, ms, o ) @ #j)
  ⇒
   ((¬(#j < #i)) ∨
    (∃ ms2 ps2 #i2.
      (MS_Commit( 'MSAuthPS', ms2, ps2, o ) @ #i2) ∧ ¬(#i2 = #i)))"
*/
simplify
solve( MS_State( 'sendcodeurl', ~session,
                 <$ms_id, $pw_id, $u_id, $bps_id, $notify_url, ~app_id, ~mch_id, ~m_sk, 
                  ~out_trade_no>
       ) ▶₀ #i )
  case MSSendCodeurlPW
  solve( SIn( 'MS-BPS', ~session, $bps_id, $notify_url,
              <
               <~id, 
                senc(<~app_id, ~mch_id, ~out_trade_no, ~transaction_id, amount, 
                      ~nonce_enc>,
                     ~key_APIv3), 
                ~nonce_enc, ~summary>, 
               sign(<
                     <~id, 
                      senc(<~app_id, ~mch_id, ~out_trade_no, ~transaction_id, amount, 
                            ~nonce_enc>,
                           ~key_APIv3), 
                      ~nonce_enc, ~summary>, 
                     ~nonce_sig>,
                    x), 
               ~nonce_sig>
         ) ▶₂ #i )
    case SecureChannelSendRecv
    solve( SOut( 'MS-BPS', ~session, $bps_id, $notify_url,
                 <
                  <~id, 
                   senc(<~app_id, ~mch_id, ~out_trade_no, ~transaction_id, amount, 
                         ~nonce_enc>,
                        ~key_APIv3), 
                   ~nonce_enc, ~summary>, 
                  sign(<
                        <~id, 
                         senc(<~app_id, ~mch_id, ~out_trade_no, ~transaction_id, amount, 
                               ~nonce_enc>,
                              ~key_APIv3), 
                         ~nonce_enc, ~summary>, 
                        ~nonce_sig>,
                       x), 
                  ~nonce_sig>
           ) ▶₀ #vr.9 )
      case BPSVerifyPasswordAndConfirmUMS_case_1
      solve( MS_State( 'sendcodeurl', ~session.2,
                       <$ms_id.2, $pw_id.2, $u_id.2, $bps_id.1, $notify_url.4, ~app_id, 
                        ~mch_id, ~m_sk.2, ~out_trade_no>
             ) ▶₀ #i2 )
        case MSSendCodeurlPW
        by contradiction /* from formulas */
      qed
    next
      case BPSVerifyPasswordAndConfirmUMS_case_2
      solve( MS_State( 'sendcodeurl', ~session.2,
                       <$ms_id.2, $pw_id.2, $u_id.2, $bps_id.1, $notify_url.4, ~app_id, 
                        ~mch_id, ~m_sk.2, ~out_trade_no>
             ) ▶₀ #i2 )
        case MSSendCodeurlPW
        by contradiction /* from formulas */
      qed
    qed
  qed
qed


  rule (modulo AC) MSReceiveNotification[role="MS"]:
     [
     !APS_PubKey( a_pk ),
     SIn( 'MS-APS', ~session, $aps_id, $notify_url,
          <<~app_id, ~out_trade_no, ~trade_no, total_amount>, res_sign>
     ),
     !MS_Database( $ms_id, $uesr, <~out_trade_no, total_amount, subject>,
                   ~out_trade_no
     ),
     MS_State( 'OrderProcessed', ~session,
               <$ms_id, $notify_url, $ma_id, $u_id, $apa_id, $aps_id, ~app_id, ~m_sk>
     )
     ]
    --[
    Eq( z, true ), Finish( 'MS', ~session, $ms_id ),
    SOURCE_IN_FACT_RES_SIGN( res_sign ),
    MS_Commit( 'MSAuthPS', $ms_id, $aps_id,
               <~app_id, ~out_trade_no, ~trade_no, total_amount>
    )
    ]->
     [
     MS_State( 'completed', ~session,
               <$ms_id, $notify_url, $ma_id, $u_id, $apa_id, $aps_id, ~app_id, ~m_sk>
     )
     ]
    variants (modulo AC)
    1. ~app_id
             = ~app_id.30
       ~out_trade_no
             = ~out_trade_no.32
       ~trade_no
             = ~trade_no.34
       a_pk  = a_pk.35
       res_sign
             = res_sign.36
       total_amount
             = total_amount.38
       z     = verify(res_sign.36,
                      <~app_id.30, ~out_trade_no.32, ~trade_no.34, total_amount.38>, a_pk.35)
    
    2. ~app_id
             = ~app_id.87
       ~out_trade_no
             = ~out_trade_no.89
       ~trade_no

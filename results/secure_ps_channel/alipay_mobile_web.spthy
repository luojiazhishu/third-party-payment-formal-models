  rule (modulo AC) MSReceiveNotification[role="MS"]:
     [
     !APS_PubKey( a_pk ),
     SIn( 'MS-APS', ~session, $aps_id, $notify_url,
          <<~app_id, ~out_trade_no, ~trade_no, total_amount>, res_sign>
     ),
     !MS_Database( $ms_id, $user, <~out_trade_no, total_amount, subject>,
                   ~out_trade_no
     ),
     MS_State( 'OrderProcessed', ~session,
               <$ms_id, $mw_id, $aps_id, $u_id, $notify_url, ~app_id, ~m_sk>
     )
     ]
    --[
    Eq( z, true ), Finish( 'MS', ~session, $ms_id ),
    SOURCE_IN_FACT_RES_SIGN( res_sign ),
    MS_Commit( 'MSAuthPS', $ms_id, $aps_id,
               <~app_id, ~out_trade_no, ~trade_no, total_amount>
    )
    ]->
     [
     MS_State( 'completed', ~session,
               <$ms_id, $mw_id, $aps_id, $u_id, $notify_url, ~app_id, ~m_sk>
     )
     ]
    variants (modulo AC)
    1. ~app_id
             = ~app_id.29
       ~out_trade_no
             = ~out_trade_no.31
       ~trade_no
             = ~trade_no.33
       a_pk  = a_pk.34
       res_sign
             = res_sign.35
       total_amount
             = total_amount.37
       z     = verify(res_sign.35,
                      <~app_id.29, ~out_trade_no.31, ~trade_no.33, total_amount.37>, a_pk.34)
    
    2. ~app_id
             = ~app_id.86

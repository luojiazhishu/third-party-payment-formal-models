                                   <~app_id, <~out_trade_no, calc_amt(~goods), subject>, $notify_url, 
                                    sign(<~app_id, <~out_trade_no, calc_amt(~goods), subject>, $notify_url>,
                                         ~m_sk)
                                   >
                             ) ▶₀ #vr.33 )
                        case MWCallAPA_case_1
                        solve( SOut( 'MW-MS', ~session.1, $ms_id, $mw_id.1,
                                     <~app_id, <~out_trade_no, calc_amt(~goods), subject>, $notify_url, 
                                      sign(<~app_id, <~out_trade_no, calc_amt(~goods), subject>, $notify_url>,
                                           ~m_sk)
                                     >
                               ) ▶₀ #vr.35 )
                          case MSProcessOrderMW
                          solve( U_Commit( 'UAuthPS', u2, ps2, <calc_amt(~goods), gen_desc(~goods)>
                                 ) @ #i2 )

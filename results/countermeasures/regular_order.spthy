lemma U_PS_Response_Injective_Agreement [heuristic={default}]:
  all-traces
  "∀ u ps r #i.
    (U_Commit( 'UAuthPS', u, ps, r ) @ #i) ⇒
    (∃ #j.
      ((PS_Running( 'UAuthPS', ps, u, r ) @ #j) ∧ (#j < #i)) ∧
      (¬(∃ u2 ps2 #i2.
          (U_Commit( 'UAuthPS', u2, ps2, r ) @ #i2) ∧ (¬(#i2 = #i)))))"
/*
guarded formula characterizing all counter-examples:
"∃ u ps r #i.
  (U_Commit( 'UAuthPS', u, ps, r ) @ #i)
 ∧
  ∀ #j.
   (PS_Running( 'UAuthPS', ps, u, r ) @ #j)
  ⇒
   ((¬(#j < #i)) ∨
    (∃ u2 ps2 #i2. (U_Commit( 'UAuthPS', u2, ps2, r ) @ #i2) ∧ ¬(#i2 = #i)))"
*/
simplify
solve( U_Commit( 'UAuthPS', u, ps, r ) @ #i )
  case UReceiveNotification
  solve( U_State( 'pwdsubmitted', ~session,
                  <$u_id, $mf_id, $ms_id, $ps_id, ~password, ~goods>
         ) ▶₁ #i )
    case USubmitPasswordPS
    solve( SOut( 'U-PS', ~session, $ps_id, $u_id,
                 <'SReqPwd and Trust', calc_amt(~goods), gen_desc(~goods)>
           ) ▶₀ #vr.2 )
      case PSVerifyPaymentMF_case_1
      solve( SOut( 'MF-PS', ~session, $mf_id, $ps_id,
                   <~prepay_id, $ms_id, sign(<~prepay_id, $ms_id>, ~m_sk), 
                    sign(<~prepay_id, $ms_id>, x)>
             ) ▶₀ #vr.9 )
        case MFCallPS_case_1
        solve( SOut( 'MS-PS', ~session, $ms_id, $ps_id,
                     <pk(x), $ms_id, ~order_id.1, amount, description, 
                      sign(<$ms_id, ~order_id.1, amount, description>, ~m_sk)>
               ) ▶₀ #vr.13 )
          case MSProcessOrderMF_case_1
          solve( SOut( 'MF-MS', ~session, $ms_id, $mf_id,
                       <~prepay_id, $ms_id, sign(<~prepay_id, $ms_id>, ~m_sk), 
                        sign(<~prepay_id, $ms_id>, ~ua_sk)>
                 ) ▶₀ #vr.15 )
            case MSSendPrepayidMF
            solve( SOut( 'U-MF', ~session, $u_id, $mf_id,
                         <'OpenAppAndOrder', ~goods.2>
                   ) ▶₀ #vr.17 )
              case UOpenAndOrderMF
              by solve( SOut( 'MS-PS', ~session, $ps_id, $ms_id, ~prepay_id
                        ) ▶₀ #vr.21 )
            qed
          next
            case breakChannelConfidentiality
            solve( SOut( 'MF-MS', ~session, $ms_id, $mf_id,
                         <~prepay_id, $ms_id, sign(<~prepay_id, $ms_id>, ~m_sk), 
                          sign(<~prepay_id, $ms_id>, ~ua_sk)>
                   ) ▶₀ #vr.20 )
              case MSSendPrepayidMF
              solve( SOut( 'U-MF', ~session, $u_id, $mf_id,
                           <'OpenAppAndOrder', ~goods.2>
                     ) ▶₀ #vr.17 )
                case UOpenAndOrderMF
                by solve( SOut( 'MS-PS', ~session, $ps_id, $ms_id, ~prepay_id
                          ) ▶₀ #vr.21 )
              qed
            qed
          qed
        next
          case MSProcessOrderMF_case_2
          solve( SOut( 'MF-MS', ~session, $ms_id, $mf_id,
                       <~prepay_id, $ms_id, sign(<~prepay_id, $ms_id>, ~m_sk), 
                        sign(<~prepay_id, $ms_id>, ~ua_sk)>
                 ) ▶₀ #vr.15 )
            case MSSendPrepayidMF
            solve( SOut( 'U-MF', ~session, $u_id, $mf_id,
                         <'OpenAppAndOrder', ~goods.2>
                   ) ▶₀ #vr.17 )
              case UOpenAndOrderMF
              by solve( SOut( 'MS-PS', ~session, $ps_id, $ms_id, ~prepay_id
                        ) ▶₀ #vr.21 )
            qed
          next
            case breakChannelConfidentiality
            solve( SOut( 'MF-MS', ~session, $ms_id, $mf_id,
                         <~prepay_id, $ms_id, sign(<~prepay_id, $ms_id>, ~m_sk), 
                          sign(<~prepay_id, $ms_id>, ~ua_sk)>
                   ) ▶₀ #vr.20 )
              case MSSendPrepayidMF
              solve( SOut( 'U-MF', ~session, $u_id, $mf_id,
                           <'OpenAppAndOrder', ~goods.2>
                     ) ▶₀ #vr.17 )
                case UOpenAndOrderMF
                by solve( SOut( 'MS-PS', ~session, $ps_id, $ms_id, ~prepay_id
                          ) ▶₀ #vr.21 )
              qed
            qed
          qed
        qed
      next
        case MFCallPS_case_2
        solve( !KU( sign(<~prepay_id, $ms_id>, ~m_sk) ) @ #vk.15 )
          case OrderCreateOracle
          solve( SOut( 'MS-PS', ~session, $ms_id, $ps_id,
                       <pk(x), $ms_id, ~order_id.1, amount, description, 

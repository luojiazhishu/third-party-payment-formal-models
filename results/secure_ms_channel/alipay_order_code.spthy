theory Alipay_Order_Code_Model begin

// Function signature and definition of the equational theory E

functions: calc_amt/1, fst/1, gen_desc/1, h/1, pair/2, pk/1, sign/2,
           snd/1, true/0, verify/3
equations:
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true

tactic: default
presort: S
prio: {id}
  regex".*Commit.*"
prio: {id}
  regex".*!KU\(.*m_sk.*"
prio: {id}
  regex".*m_sk.*"
prio: {id}
  regex".*_State.*"
prio: {id}
  regex".*sign.*"
prio: {id}
  regex".*APS_PubKey.*"
prio: {id}
  regex".*SOut\(.*U-.*"
prio: {id}
  regex".*SOut\(.*-APS.*"
prio: {id}
  regex".*SIn\(.*U-.*"
prio: {id}
  regex".*SIn\(.*-APS.*"


tactic: typing
presort: S
prio: {id}
  regex".*!KU\(\s*sign.*"
prio: {id}
  regex".*SOURCE_.*"
prio: {id}
  regex".*APS_PubKey.*"
prio: {id}
  regex".*SOut\(.*U-.*"
prio: {id}
  regex".*SOut\(.*-APS.*"
prio: {id}
  regex".*SIn\(.*U-.*"
prio: {id}
  regex".*SIn\(.*-APS.*"
prio: {id}
  regex".*_State.*"
deprio: {id}
  regex".*SOut*"
deprio: {id}
  regex".*SIn*"



heuristic: S





restriction OnlyOnceV:
  "∀ x #i #j. ((OnlyOnceV( x ) @ #i) ∧ (OnlyOnceV( x ) @ #j)) ⇒ (#i = #j)"
  // safety formula

restriction Equality:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

restriction Inequality:
  "∀ x #i. (Neq( x, x ) @ #i) ⇒ (⊥)"
  // safety formula

restriction InsecureChannel:
  "∀ ch_id #i. (InsecureChannel( ch_id ) @ #i) ⇒ (ch_id = 'PW-APA')"
  // safety formula

rule (modulo E) SecureChannelSendRecv[color=#f0f5e5]:
   [ SOut( ch_id, ~session, $src, $dst, msg ) ]
  --[ Neq( $src, $dst ) ]->
   [ SIn( ch_id, ~session, $src, $dst, msg ) ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) breakChannelConfidentiality[color=#fccb16]:
   [ SOut( ch_id, ~session, $src, $dst, msg ) ]
  --[
  OnlyOnceV( <$src, $dst, msg> ), BreakChannelCon( ch_id ),
  InsecureChannel( ch_id ),
  SOURCE_IN_FACT_BkChaCon( ch_id, ~session, $src, $dst, msg )
  ]->
   [ SOut( ch_id, ~session, $src, $dst, msg ), Out( <$src, $dst, msg> ) ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) breakChannelIntegrity[color=#f25a47]:
   [ In( <ch_id, ~session, $src, $dst, msg> ) ]
  --[
  BreakChannelInt( ch_id ), InsecureChannel( ch_id ),
  SOURCE_OUT_FACT_BkChaInt( ch_id, ~session, $src, $dst, msg ),
  SOURCE_OUT_FACT_APA_QRCODE( msg )
  ]->
   [ SIn( ch_id, ~session, $src, $dst, msg ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) OrderCreateOracle[color=#f9d27d]:
   [
   Fr( ~trade_no ), Fr( ~out_trade_no ), In( <total_amount, subject> ),
   !APS_PubKey( $aps_id, a_pk ),
   !MerchantRegistered( <$ms_id, ~app_id, m_pk> )
   ]
  --[ SOURCE_OUT_FACT_MS_QRCODE( <total_amount, subject, ~trade_no> ) ]->
   [
   Out( <total_amount, subject, ~trade_no> ),
   !MS_Database( $ms_id, $attacker, <total_amount, subject, ~trade_no>,
                 ~out_trade_no
   ),
   !APS_Database( $aps_id, <total_amount, subject, ~trade_no>, ~out_trade_no
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) PaymentQueryOracle[color=#f9d27d]:
   [
   In( <total_amount, subject, ~trade_no> ),
   !APS_Database( $aps_id, <total_amount, subject, ~trade_no>, ~out_trade_no
   )
   ]
  -->
   [ Out( <total_amount, subject> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) CreateAPS[color=#d3c3f3]:
   [ Fr( ~a_sk ) ]
  --[ OnlyOnceV( 'APS' ) ]->
   [ !APS_PriKey( $aps_id, ~a_sk ), !APS_PubKey( $aps_id, pk(~a_sk) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) CreateAPA[color=#c4c3f3]:
   [ ]
  --[ OnlyOnceV( <'APA', $apa_id> ) ]->
   [ APA_State( 'created', 'null', $apa_id ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) CreatePW[color=#f3c3c7]:
   [ ]
  --[ OnlyOnceV( <'PW', $pw_id> ) ]->
   [ PW_State( 'created', 'null', $pw_id ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) CreateU[color=#c5f3c3]:
   [ Fr( ~password ) ]
  --[ OnlyOnceV( 'U' ) ]->
   [
   !UserRegistered( <$u_id, h(~password)> ),
   !UserPassword( <$u_id, ~password> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) CreateMS[color=#f3ccc3]:
   [ Fr( ~app_id ), Fr( ~m_sk ) ]
  --[ OnlyOnceV( <'MS', $ms_id> ) ]->
   [
   !MerchantRegistered( <$ms_id, ~app_id, pk(~m_sk)> ),
   !MerchantCreated( <$ms_id, ~app_id, $notify_url, ~m_sk> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) NewPaymentSession[color=#d0deaa]:
   [
   Fr( ~session ), !APS_PriKey( $aps_id, ~a_sk ),
   !UserPassword( <$u_id, ~password> ),
   !MerchantCreated( <$ms_id, ~app_id, $notify_url, ~m_sk> ),
   PW_State( 'created', 'null', $pw_id ),
   APA_State( 'created', 'null', $apa_id )
   ]
  --[
  Start( ~session, $u_id, $pw_id, $ms_id, $apa_id, $aps_id ),
  OnlyOnceV( <$u_id, $pw_id, $ms_id, $apa_id, $aps_id> )
  ]->
   [
   U_State( 'init', ~session,
            <$u_id, $pw_id, $apa_id, $aps_id, $ms_id, ~password>
   ),
   PW_State( 'init', ~session, <$pw_id, $u_id, $ms_id, $apa_id> ),
   MS_State( 'init', ~session,
             <$ms_id, $pw_id, $aps_id, $u_id, ~app_id, ~m_sk>
   ),
   APA_State( 'init', ~session, <$apa_id, $u_id, $pw_id, $aps_id> ),
   APS_State( 'init', ~session, <$aps_id, $apa_id, $ms_id, $u_id, ~a_sk> ),
   Out( ~session )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) UOpenAndOrderPW[role="U"]:
   [
   Fr( ~goods ),
   U_State( 'init', ~session,
            <$u_id, $pw_id, $apa_id, $aps_id, $ms_id, ~password>
   )
   ]
  -->
   [
   U_State( 'ordered', ~session,
            <$u_id, $pw_id, $apa_id, $aps_id, $ms_id, ~password, ~goods>
   ),
   SOut( 'U-PW', ~session, $u_id, $pw_id, <'OpenAppAndOrder', ~goods> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) PWOrderMS[role="PW"]:
   [
   SIn( 'U-PW', ~session, $u_id, $pw_id, <'OpenAppAndOrder', ~goods> ),
   PW_State( 'init', ~session, <$pw_id, $u_id, $ms_id, $apa_id> )
   ]
  --[
  Finish( 'PW', ~session, $pw_id ),
  SOURCE_OUT_FACT_BkChaCon( 'PW-MS', ~session, $pw_id, $ms_id, ~goods )
  ]->
   [
   SOut( 'PW-MS', ~session, $pw_id, $ms_id, ~goods ),
   PW_State( 'ordered', ~session, <$pw_id, $u_id, $ms_id, $apa_id> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) MSPrecreateAPS[role="MS"]:
   [
   SIn( 'PW-MS', ~session, $pw_id, $ms_id, ~goods ),
   MS_State( 'init', ~session,
             <$ms_id, $pw_id, $aps_id, $u_id, ~app_id, ~m_sk>
   ),
   Fr( ~out_trade_no )
   ]
  --[
  SOURCE_OUT_FACT_BkChaCon( 'MS-APS', ~session, $ms_id, $aps_id,
                            <~app_id, 
                             <~out_trade_no, calc_amt(~goods), gen_desc(~goods), 'QR_CODE_OFFLINE'>, 
                             sign(<~app_id, ~out_trade_no, calc_amt(~goods), gen_desc(~goods), 
                                   'QR_CODE_OFFLINE'>,
                                  ~m_sk)
                            >
  ),
  SOURCE_OUT_FACT_M_SIGN( 'MS-APS', ~session, $ms_id, $aps_id,
                          <~app_id, 
                           <~out_trade_no, calc_amt(~goods), gen_desc(~goods), 'QR_CODE_OFFLINE'>, 
                           sign(<~app_id, ~out_trade_no, calc_amt(~goods), gen_desc(~goods), 
                                 'QR_CODE_OFFLINE'>,
                                ~m_sk)
                          >
  ),
  MS_Running( 'PSAuthMS', $ms_id, $aps_id,
              <~app_id, 
               <~out_trade_no, calc_amt(~goods), gen_desc(~goods), 'QR_CODE_OFFLINE'>, 
               sign(<~app_id, ~out_trade_no, calc_amt(~goods), gen_desc(~goods), 
                     'QR_CODE_OFFLINE'>,
                    ~m_sk)
              >
  )
  ]->
   [
   SOut( 'MS-APS', ~session, $ms_id, $aps_id,
         <~app_id, 
          <~out_trade_no, calc_amt(~goods), gen_desc(~goods), 'QR_CODE_OFFLINE'>, 
          sign(<~app_id, ~out_trade_no, calc_amt(~goods), gen_desc(~goods), 
                'QR_CODE_OFFLINE'>,
               ~m_sk)
         >
   ),
   MS_State( 'precreating', ~session,
             <$ms_id, $pw_id, $aps_id, $u_id, ~app_id, ~m_sk, ~out_trade_no>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) APSGenerateQRCodeMS[role="APS"]:
   [
   SIn( 'MS-APS', ~session, $ms_id, $aps_id,
        <~app_id, <~out_trade_no, total_amount, subject, 'QR_CODE_OFFLINE'>, 
         m_sig>
   ),
   APS_State( 'init', ~session, <$aps_id, $apa_id, $ms_id, $u_id, ~a_sk> ),
   !MerchantRegistered( <$ms_id, ~app_id, m_pk> ), Fr( ~trade_no )
   ]
  --[
  Eq( verify(m_sig,
             <~app_id, ~out_trade_no, total_amount, subject, 'QR_CODE_OFFLINE'>,
             m_pk),
      true
  ),
  SOURCE_IN_FACT_M_SIGN( 'MS-APS', ~session, $ms_id, $aps_id,
                         <~app_id, <~out_trade_no, total_amount, subject, 'QR_CODE_OFFLINE'>, 
                          m_sig>
  ),
  SOURCE_OUT_FACT_MS_QRCODE( <total_amount, subject, ~trade_no> ),
  PS_Commit( 'PSAuthMS', $aps_id, $ms_id,
             <~app_id, <~out_trade_no, total_amount, subject, 'QR_CODE_OFFLINE'>, 
              m_sig>
  )
  ]->
   [
   SOut( 'MS-APS', ~session, $aps_id, $ms_id,
         <total_amount, subject, ~trade_no>
   ),
   !APS_Database( $aps_id, <total_amount, subject, ~trade_no>, ~out_trade_no
   ),
   APS_State( 'precreated', ~session,
              <$aps_id, $apa_id, $ms_id, $u_id, ~a_sk>
   )
   ]

  /*
  rule (modulo AC) APSGenerateQRCodeMS[role="APS"]:
     [
     SIn( 'MS-APS', ~session, $ms_id, $aps_id,
          <~app_id, <~out_trade_no, total_amount, subject, 'QR_CODE_OFFLINE'>, 
           m_sig>
     ),
     APS_State( 'init', ~session, <$aps_id, $apa_id, $ms_id, $u_id, ~a_sk> ),
     !MerchantRegistered( <$ms_id, ~app_id, m_pk> ), Fr( ~trade_no )
     ]
    --[
    Eq( z, true ),
    SOURCE_IN_FACT_M_SIGN( 'MS-APS', ~session, $ms_id, $aps_id,
                           <~app_id, <~out_trade_no, total_amount, subject, 'QR_CODE_OFFLINE'>, 
                            m_sig>
    ),
    SOURCE_OUT_FACT_MS_QRCODE( <total_amount, subject, ~trade_no> ),
    PS_Commit( 'PSAuthMS', $aps_id, $ms_id,
               <~app_id, <~out_trade_no, total_amount, subject, 'QR_CODE_OFFLINE'>, 
                m_sig>
    )
    ]->
     [
     SOut( 'MS-APS', ~session, $aps_id, $ms_id,
           <total_amount, subject, ~trade_no>
     ),
     !APS_Database( $aps_id, <total_amount, subject, ~trade_no>, ~out_trade_no
     ),
     APS_State( 'precreated', ~session,
                <$aps_id, $apa_id, $ms_id, $u_id, ~a_sk>
     )
     ]
    variants (modulo AC)
    1. ~app_id
             = ~app_id.27
       ~out_trade_no
             = ~out_trade_no.28
       m_pk  = m_pk.31
       m_sig = m_sig.32
       subject
             = subject.33
       total_amount
             = total_amount.34
       z     = verify(m_sig.32,
                      <~app_id.27, ~out_trade_no.28, total_amount.34, subject.33, 
                       'QR_CODE_OFFLINE'>,
                      m_pk.31)
    
    2. ~app_id
             = ~app_id.80
       ~out_trade_no
             = ~out_trade_no.81
       m_pk  = pk(x.153)
       m_sig = sign(<~app_id.80, ~out_trade_no.81, total_amount.87, subject.86, 
                     'QR_CODE_OFFLINE'>,
                    x.153)
       subject
             = subject.86
       total_amount
             = total_amount.87
       z     = true
  */

rule (modulo E) MSSendQRCodePW[role="MS"]:
   [
   SIn( 'MS-APS', ~session, $aps_id, $ms_id,
        <total_amount, subject, ~trade_no>
   ),
   MS_State( 'precreating', ~session,
             <$ms_id, $pw_id, $aps_id, $u_id, ~app_id, ~m_sk, ~out_trade_no>
   )
   ]
  --[
  SOURCE_OUT_FACT_BkChaCon( 'PW-MS', ~session, $ms_id, $pw_id,
                            <total_amount, subject, ~trade_no>
  ),
  SOURCE_IN_FACT_MS_QRCODE( <total_amount, subject, ~trade_no> ),
  SOURCE_OUT_FACT_APA_QRCODE( <total_amount, subject, ~trade_no> ),
  MS_Running( 'UAuthMS', $ms_id, $u_id, ~trade_no )
  ]->
   [
   SOut( 'PW-MS', ~session, $ms_id, $pw_id,
         <total_amount, subject, ~trade_no>
   ),
   !MS_Database( $ms_id, $u_id, <total_amount, subject, ~trade_no>,
                 ~out_trade_no
   ),
   MS_State( 'qrcodesent', ~session,
             <$ms_id, $pw_id, $aps_id, $u_id, ~app_id, ~m_sk>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) PWShowQRCodeAPA[role="PW"]:
   [
   SIn( 'PW-MS', ~session, $ms_id, $pw_id,
        <total_amount, subject, ~trade_no>
   ),
   PW_State( 'ordered', ~session, <$pw_id, $u_id, $ms_id, $apa_id> )
   ]
  --[
  SOURCE_OUT_FACT_BkChaCon( 'PW-APA', ~session, $pw_id, $apa_id,
                            <total_amount, subject, ~trade_no>
  ),
  SOURCE_IN_FACT_APA_QRCODE( <total_amount, subject, ~trade_no> )
  ]->
   [
   SOut( 'PW-APA', ~session, $pw_id, $apa_id,
         <total_amount, subject, ~trade_no>
   ),
   PW_State( 'qrcodeshown', ~session, <$pw_id, $u_id, $ms_id, $apa_id> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) APAScanAndReqPwdU[role="APA"]:
   [
   SIn( 'PW-APA', ~session, $pw_id, $apa_id,
        <total_amount, subject, ~trade_no>
   ),
   APA_State( 'init', ~session, <$apa_id, $u_id, $pw_id, $aps_id> )
   ]
  -->
   [
   SOut( 'U-APA', ~session, $apa_id, $u_id,
         <'AReqPwd', total_amount, subject, ~trade_no>
   ),
   APA_State( 'waitpwd', ~session,
              <$apa_id, $u_id, $pw_id, $aps_id, total_amount, subject, ~trade_no>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) USubmitPasswordAPA[role="U"]:
   [
   SIn( 'U-APA', ~session, $apa_id, $u_id,
        <'AReqPwd', calc_amt(~goods), gen_desc(~goods), ~trade_no>
   ),
   U_State( 'ordered', ~session,
            <$u_id, $pw_id, $apa_id, $aps_id, $ms_id, ~password, ~goods>
   )
   ]
  --[
  UserInputPwd( $u_id, ~password, ~session ),
  U_Commit( 'UAuthMS', $u_id, $ms_id, ~trade_no )
  ]->
   [
   SOut( 'U-APA', ~session, $u_id, $apa_id, ~password ),
   U_State( 'pwdsubmitted', ~session,
            <$u_id, $pw_id, $apa_id, $aps_id, $ms_id, ~password, ~goods>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) APASubmitPasswordAPS[role="APA"]:
   [
   SIn( 'U-APA', ~session, $u_id, $apa_id, ~password ),
   APA_State( 'waitpwd', ~session,
              <$apa_id, $u_id, $pw_id, $aps_id, qr_code>
   )
   ]
  -->
   [
   SOut( 'APA-APS', ~session, $apa_id, $aps_id, <qr_code, h(~password)> ),
   APA_State( 'pwdsubmitted', ~session,
              <$apa_id, $u_id, $pw_id, $aps_id, qr_code>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) APSVerifyPasswordAndConfirmAPAMS[role="APS"]:
   [
   !UserRegistered( <$u_id, pwd_hash> ),
   !MerchantRegistered( <$ms_id, ~app_id, m_pk> ),
   SIn( 'APA-APS', ~session, $apa_id, $aps_id,
        <<total_amount, subject, ~trade_no>, pwd_hash>
   ),
   !APS_Database( $aps_id, <total_amount, subject, ~trade_no>, ~out_trade_no
   ),
   APS_State( 'precreated', ~session,
              <$aps_id, $apa_id, $ms_id, $u_id, ~a_sk>
   )
   ]
  --[
  Finish( 'APS', ~session, $aps_id ),
  SOURCE_OUT_FACT_RES_SIGN( sign(<~app_id, ~out_trade_no, ~trade_no, 
                                  total_amount>,
                                 ~a_sk)
  ),
  PS_Running( 'MSAuthPS', $aps_id, $ms_id,
              <~app_id, ~out_trade_no, ~trade_no, total_amount>
  ),
  PS_Running( 'UAuthPS', $aps_id, $u_id, <total_amount, subject> ),
  PaymentComplete( $u_id, pwd_hash, ~session )
  ]->
   [
   SOut( 'MS-APS', ~session, $aps_id, $ms_id,
         <<~app_id, ~out_trade_no, ~trade_no, total_amount>, 
          sign(<~app_id, ~out_trade_no, ~trade_no, total_amount>, ~a_sk)>
   ),
   SOut( 'APA-APS', ~session, $aps_id, $apa_id,
         <<~app_id, ~out_trade_no, ~trade_no, total_amount>, 
          sign(<~app_id, ~out_trade_no, ~trade_no, total_amount>, ~a_sk)>
   ),
   APS_State( 'confirmed', ~session,
              <$aps_id, $apa_id, $ms_id, $u_id, ~a_sk>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) MSReceiveNotification[role="MS"]:
   [
   !APS_PubKey( $aps_id, a_pk ),
   SIn( 'MS-APS', ~session, $aps_id, $ms_id,
        <<~app_id, ~out_trade_no, ~trade_no, total_amount>, res_sign>
   ),
   !MS_Database( $ms_id, $user, <total_amount, subject, ~trade_no>,
                 ~out_trade_no
   ),
   MS_State( 'qrcodesent', ~session,
             <$ms_id, $pw_id, $aps_id, $u_id, ~app_id, ~m_sk>
   )
   ]
  --[
  Eq( verify(res_sign, <~app_id, ~out_trade_no, ~trade_no, total_amount>,
             a_pk),
      true
  ),
  Finish( 'MS', ~session, $ms_id ), SOURCE_IN_FACT_RES_SIGN( res_sign ),
  MS_Commit( 'MSAuthPS', $ms_id, $aps_id,
             <~app_id, ~out_trade_no, ~trade_no, total_amount>
  )
  ]->
   [
   MS_State( 'completed', ~session,
             <$ms_id, $pw_id, $aps_id, $u_id, ~app_id, ~m_sk>
   )
   ]

  /*
  rule (modulo AC) MSReceiveNotification[role="MS"]:
     [
     !APS_PubKey( $aps_id, a_pk ),
     SIn( 'MS-APS', ~session, $aps_id, $ms_id,
          <<~app_id, ~out_trade_no, ~trade_no, total_amount>, res_sign>
     ),
     !MS_Database( $ms_id, $user, <total_amount, subject, ~trade_no>,
                   ~out_trade_no
     ),
     MS_State( 'qrcodesent', ~session,
               <$ms_id, $pw_id, $aps_id, $u_id, ~app_id, ~m_sk>
     )
     ]
    --[
    Eq( z, true ), Finish( 'MS', ~session, $ms_id ),
    SOURCE_IN_FACT_RES_SIGN( res_sign ),
    MS_Commit( 'MSAuthPS', $ms_id, $aps_id,
               <~app_id, ~out_trade_no, ~trade_no, total_amount>
    )
    ]->
     [
     MS_State( 'completed', ~session,
               <$ms_id, $pw_id, $aps_id, $u_id, ~app_id, ~m_sk>
     )
     ]
    variants (modulo AC)
    1. ~app_id
             = ~app_id.28
       ~out_trade_no
             = ~out_trade_no.30
       ~trade_no
             = ~trade_no.32
       a_pk  = a_pk.33
       res_sign
             = res_sign.34
       total_amount
             = total_amount.36
       z     = verify(res_sign.34,
                      <~app_id.28, ~out_trade_no.30, ~trade_no.32, total_amount.36>, a_pk.33)
    
    2. ~app_id
             = ~app_id.85
       ~out_trade_no
             = ~out_trade_no.87
       ~trade_no
             = ~trade_no.89
       a_pk  = pk(x.163)
       res_sign
             = sign(<~app_id.85, ~out_trade_no.87, ~trade_no.89, total_amount.93>,
                    x.163)
       total_amount
             = total_amount.93
       z     = true
  */

rule (modulo E) APAReceiveConfirmationAndNotifyU[role="APA"]:
   [
   !APS_PubKey( $aps_id, a_pk ),
   SIn( 'APA-APS', ~session, $aps_id, $apa_id,
        <<~app_id, ~out_trade_no, ~trade_no, total_amount>, res_sign>
   ),
   APA_State( 'pwdsubmitted', ~session,
              <$apa_id, $u_id, $pw_id, $aps_id, total_amount, subject, ~trade_no>
   )
   ]
  --[
  Eq( verify(res_sign, <~app_id, ~out_trade_no, ~trade_no, total_amount>,
             a_pk),
      true
  ),
  Finish( 'APA', ~session, $apa_id ), SOURCE_IN_FACT_RES_SIGN( res_sign )
  ]->
   [
   SOut( 'U-APA', ~session, $apa_id, $u_id,
         <'PaymentSuccessful', total_amount, subject>
   ),
   APA_State( 'completed', ~session,
              <$apa_id, $u_id, $pw_id, $aps_id, total_amount, subject, ~trade_no>
   )
   ]

  /*
  rule (modulo AC) APAReceiveConfirmationAndNotifyU[role="APA"]:
     [
     !APS_PubKey( $aps_id, a_pk ),
     SIn( 'APA-APS', ~session, $aps_id, $apa_id,
          <<~app_id, ~out_trade_no, ~trade_no, total_amount>, res_sign>
     ),
     APA_State( 'pwdsubmitted', ~session,
                <$apa_id, $u_id, $pw_id, $aps_id, total_amount, subject, ~trade_no>
     )
     ]
    --[
    Eq( z, true ), Finish( 'APA', ~session, $apa_id ),
    SOURCE_IN_FACT_RES_SIGN( res_sign )
    ]->
     [
     SOut( 'U-APA', ~session, $apa_id, $u_id,
           <'PaymentSuccessful', total_amount, subject>
     ),
     APA_State( 'completed', ~session,
                <$apa_id, $u_id, $pw_id, $aps_id, total_amount, subject, ~trade_no>
     )
     ]
    variants (modulo AC)
    1. ~app_id
             = ~app_id.27
       ~out_trade_no
             = ~out_trade_no.28
       ~trade_no
             = ~trade_no.30
       a_pk  = a_pk.31
       res_sign
             = res_sign.32
       total_amount
             = total_amount.34
       z     = verify(res_sign.32,
                      <~app_id.27, ~out_trade_no.28, ~trade_no.30, total_amount.34>, a_pk.31)
    
    2. ~app_id
             = ~app_id.99
       ~out_trade_no
             = ~out_trade_no.100
       ~trade_no
             = ~trade_no.102
       a_pk  = pk(x.192)
       res_sign
             = sign(<~app_id.99, ~out_trade_no.100, ~trade_no.102, total_amount.106>,
                    x.192)
       total_amount
             = total_amount.106
       z     = true
  */

rule (modulo E) UReceiveNotification[role="U"]:
   [
   SIn( 'U-APA', ~session, $apa_id, $u_id,
        <'PaymentSuccessful', calc_amt(~goods), gen_desc(~goods)>
   ),
   U_State( 'pwdsubmitted', ~session,
            <$u_id, $pw_id, $apa_id, $aps_id, $ms_id, ~password, ~goods>
   )
   ]
  --[
  Finish( 'U', ~session, $u_id ),
  U_Commit( 'UAuthPS', $u_id, $aps_id, <calc_amt(~goods), gen_desc(~goods)>
  )
  ]->
   [
   U_State( 'completed', ~session,
            <$u_id, $pw_id, $apa_id, $aps_id, $ms_id, ~password, ~goods>
   )
   ]

  /* has exactly the trivial AC variant */

lemma typing [sources, heuristic={typing}]:
  all-traces
  "((((∀ m1 m2 m3 m4 m5 #i.
        (SOURCE_IN_FACT_BkChaCon( m1, m2, m3, m4, m5 ) @ #i) ⇒
        (∃ #j.
          (SOURCE_OUT_FACT_BkChaCon( m1, m2, m3, m4, m5 ) @ #j) ∧ (#j < #i))) ∧
      (∀ m1 m2 m3 m4 m5 #i.
        (SOURCE_IN_FACT_M_SIGN( m1, m2, m3, m4, m5 ) @ #i) ⇒
        (∃ #j.
          (SOURCE_OUT_FACT_M_SIGN( m1, m2, m3, m4, m5 ) @ #j) ∧ (#j < #i)))) ∧
     (∀ m1 #i.
       (SOURCE_IN_FACT_RES_SIGN( m1 ) @ #i) ⇒
       (∃ #j. (SOURCE_OUT_FACT_RES_SIGN( m1 ) @ #j) ∧ (#j < #i)))) ∧
    (∀ m1 #i.
      (SOURCE_IN_FACT_MS_QRCODE( m1 ) @ #i) ⇒
      (∃ #j. (SOURCE_OUT_FACT_MS_QRCODE( m1 ) @ #j) ∧ (#j < #i)))) ∧
   (∀ m1 #i.
     (SOURCE_IN_FACT_APA_QRCODE( m1 ) @ #i) ⇒
     (∃ #j. (SOURCE_OUT_FACT_APA_QRCODE( m1 ) @ #j) ∧ (#j < #i)))"
/*
guarded formula characterizing all counter-examples:
"((∃ m1 m2 m3 m4 m5 #i.
    (SOURCE_IN_FACT_BkChaCon( m1, m2, m3, m4, m5 ) @ #i)
   ∧
    ∀ #j.
     (SOURCE_OUT_FACT_BkChaCon( m1, m2, m3, m4, m5 ) @ #j) ⇒ ¬(#j < #i)) ∨
  (∃ m1 m2 m3 m4 m5 #i.
    (SOURCE_IN_FACT_M_SIGN( m1, m2, m3, m4, m5 ) @ #i)
   ∧
    ∀ #j. (SOURCE_OUT_FACT_M_SIGN( m1, m2, m3, m4, m5 ) @ #j) ⇒ ¬(#j < #i)) ∨
  (∃ m1 #i.
    (SOURCE_IN_FACT_RES_SIGN( m1 ) @ #i)
   ∧
    ∀ #j. (SOURCE_OUT_FACT_RES_SIGN( m1 ) @ #j) ⇒ ¬(#j < #i)) ∨
  (∃ m1 #i.
    (SOURCE_IN_FACT_MS_QRCODE( m1 ) @ #i)
   ∧
    ∀ #j. (SOURCE_OUT_FACT_MS_QRCODE( m1 ) @ #j) ⇒ ¬(#j < #i)) ∨
  (∃ m1 #i.
    (SOURCE_IN_FACT_APA_QRCODE( m1 ) @ #i)
   ∧
    ∀ #j. (SOURCE_OUT_FACT_APA_QRCODE( m1 ) @ #j) ⇒ ¬(#j < #i)))"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  simplify
  solve( (∃ m1 m2 m3 m4 m5 #i.
           (SOURCE_IN_FACT_BkChaCon( m1, m2, m3, m4, m5 ) @ #i)
          ∧
           ∀ #j.
            (SOURCE_OUT_FACT_BkChaCon( m1, m2, m3, m4, m5 ) @ #j) ⇒ ¬(#j < #i))  ∥
         (∃ m1 m2 m3 m4 m5 #i.
           (SOURCE_IN_FACT_M_SIGN( m1, m2, m3, m4, m5 ) @ #i)
          ∧
           ∀ #j.
            (SOURCE_OUT_FACT_M_SIGN( m1, m2, m3, m4, m5 ) @ #j) ⇒ ¬(#j < #i))  ∥
         (∃ m1 #i.
           (SOURCE_IN_FACT_RES_SIGN( m1 ) @ #i)
          ∧
           ∀ #j. (SOURCE_OUT_FACT_RES_SIGN( m1 ) @ #j) ⇒ ¬(#j < #i))  ∥
         (∃ m1 #i.
           (SOURCE_IN_FACT_MS_QRCODE( m1 ) @ #i)
          ∧
           ∀ #j. (SOURCE_OUT_FACT_MS_QRCODE( m1 ) @ #j) ⇒ ¬(#j < #i))  ∥
         (∃ m1 #i.
           (SOURCE_IN_FACT_APA_QRCODE( m1 ) @ #i)
          ∧
           ∀ #j. (SOURCE_OUT_FACT_APA_QRCODE( m1 ) @ #j) ⇒ ¬(#j < #i)) )
    case case_1
    solve( (last(#i))  ∥
           (∃ #j.
             (SOURCE_OUT_FACT_BkChaCon( 'PW-APA', ~session, $src, $dst, m5 ) @ #j)
            ∧
             (¬(last(#j))) ∧ (#j < #i)) )
      case case_1
      solve( SOut( 'PW-APA', ~session, $src, $dst, m5 ) ▶₀ #i )
        case PWShowQRCodeAPA
        by contradiction /* from formulas */
      next
        case breakChannelConfidentiality
        by contradiction /* cyclic */
      qed
    next
      case case_2
      by contradiction /* from formulas */
    qed
  next
    case case_2
    solve( (last(#i))  ∥
           (∃ #j.
             (SOURCE_OUT_FACT_M_SIGN( 'MS-APS', ~session, $ms_id, $aps_id,
                                      <~app_id, <~out_trade_no, total_amount, subject, 'QR_CODE_OFFLINE'>, 
                                       sign(<~app_id, ~out_trade_no, total_amount, subject, 'QR_CODE_OFFLINE'
                                            >,
                                            x)
                                      >
              ) @ #j)
            ∧
             (¬(last(#j))) ∧ (#j < #i)) )
      case case_1
      solve( SIn( 'MS-APS', ~session, $ms_id, $aps_id,
                  <~app_id, <~out_trade_no, total_amount, subject, 'QR_CODE_OFFLINE'>, 
                   sign(<~app_id, ~out_trade_no, total_amount, subject, 'QR_CODE_OFFLINE'>,
                        x)
                  >
             ) ▶₀ #i )
        case SecureChannelSendRecv
        solve( SOut( 'MS-APS', ~session, $ms_id, $aps_id,
                     <~app_id, <~out_trade_no, total_amount, subject, 'QR_CODE_OFFLINE'>, 
                      sign(<~app_id, ~out_trade_no, total_amount, subject, 'QR_CODE_OFFLINE'>,
                           x)
                     >
               ) ▶₀ #vr )
          case MSPrecreateAPS
          by contradiction /* from formulas */
        qed
      qed
    next
      case case_2
      by contradiction /* from formulas */
    qed
  next
    case case_3
    solve( (last(#i))  ∥
           (∃ #j.
             (SOURCE_OUT_FACT_RES_SIGN( m1 ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #i)) )
      case case_1
      solve( SOURCE_IN_FACT_RES_SIGN( m1 ) @ #i )
        case APAReceiveConfirmationAndNotifyU
        solve( !APS_PubKey( $aps_id, pk(x) ) ▶₀ #i )
          case CreateAPS
          solve( SIn( 'APA-APS', ~session, $aps_id, $apa_id,
                      <<~app_id, ~out_trade_no, ~trade_no, total_amount>, 
                       sign(<~app_id, ~out_trade_no, ~trade_no, total_amount>, ~a_sk)>
                 ) ▶₁ #i )
            case SecureChannelSendRecv
            solve( SOut( 'APA-APS', ~session, $aps_id, $apa_id,
                         <<~app_id, ~out_trade_no, ~trade_no, total_amount>, 
                          sign(<~app_id, ~out_trade_no, ~trade_no, total_amount>, ~a_sk)>
                   ) ▶₀ #vr.1 )
              case APSVerifyPasswordAndConfirmAPAMS_case_1
              by contradiction /* from formulas */
            next
              case APSVerifyPasswordAndConfirmAPAMS_case_2
              by contradiction /* from formulas */
            qed
          qed
        qed
      next
        case MSReceiveNotification
        solve( !APS_PubKey( $aps_id, pk(x) ) ▶₀ #i )
          case CreateAPS
          solve( SIn( 'MS-APS', ~session, $aps_id, $ms_id,
                      <<~app_id, ~out_trade_no, ~trade_no, total_amount>, 
                       sign(<~app_id, ~out_trade_no, ~trade_no, total_amount>, ~a_sk)>
                 ) ▶₁ #i )
            case SecureChannelSendRecv
            solve( SOut( 'MS-APS', ~session, $aps_id, $ms_id,
                         <<~app_id, ~out_trade_no, ~trade_no, total_amount>, 
                          sign(<~app_id, ~out_trade_no, ~trade_no, total_amount>, ~a_sk)>
                   ) ▶₀ #vr.1 )
              case APSVerifyPasswordAndConfirmAPAMS_case_1
              by contradiction /* from formulas */
            next
              case APSVerifyPasswordAndConfirmAPAMS_case_2
              by contradiction /* from formulas */
            qed
          qed
        qed
      qed
    next
      case case_2
      by contradiction /* from formulas */
    qed
  next
    case case_4
    solve( (last(#i))  ∥
           (∃ #j.
             (SOURCE_OUT_FACT_MS_QRCODE( <total_amount, subject, ~trade_no> ) @ #j)
            ∧
             (¬(last(#j))) ∧ (#j < #i)) )
      case case_1
      solve( SIn( 'MS-APS', ~session, $aps_id, $ms_id,
                  <total_amount, subject, ~trade_no>
             ) ▶₀ #i )
        case SecureChannelSendRecv
        solve( SOut( 'MS-APS', ~session, $aps_id, $ms_id,
                     <total_amount, subject, ~trade_no>
               ) ▶₀ #vr )
          case APSGenerateQRCodeMS
          by contradiction /* from formulas */
        qed
      qed
    next
      case case_2
      by contradiction /* from formulas */
    qed
  next
    case case_5
    solve( (last(#i))  ∥
           (∃ #j.
             (SOURCE_OUT_FACT_APA_QRCODE( <total_amount, subject, ~trade_no> ) @ #j)
            ∧
             (¬(last(#j))) ∧ (#j < #i)) )
      case case_1
      solve( PW_State( 'ordered', ~session, <$pw_id, $u_id, $ms_id, $apa_id>
             ) ▶₁ #i )
        case PWOrderMS
        solve( SOut( 'U-PW', ~session, $u_id, $pw_id, <'OpenAppAndOrder', ~goods>
               ) ▶₀ #vr.1 )
          case UOpenAndOrderPW
          solve( SIn( 'PW-MS', ~session, $ms_id, $pw_id,
                      <total_amount, subject, ~trade_no>
                 ) ▶₀ #i )
            case SecureChannelSendRecv
            solve( SOut( 'PW-MS', ~session, $ms_id, $pw_id,
                         <total_amount, subject, ~trade_no>
                   ) ▶₀ #vr.9 )
              case MSSendQRCodePW
              by contradiction /* from formulas */
            qed
          qed
        qed
      qed
    next
      case case_2
      by contradiction /* from formulas */
    qed
  qed
qed

lemma executable [heuristic={default}]:
  exists-trace
  "∃ session u_id pw_id ms_id apa_id aps_id #i #j #k #l #m #n.
    (((((Start( session, u_id, pw_id, ms_id, apa_id, aps_id ) @ #n) ∧
        (Finish( 'U', session, u_id ) @ #i)) ∧
       (Finish( 'PW', session, pw_id ) @ #j)) ∧
      (Finish( 'MS', session, ms_id ) @ #k)) ∧
     (Finish( 'APA', session, apa_id ) @ #l)) ∧
    (Finish( 'APS', session, aps_id ) @ #m)"
/*
guarded formula characterizing all satisfying traces:
"∃ session u_id pw_id ms_id apa_id aps_id #i #j #k #l #m #n.
  (Start( session, u_id, pw_id, ms_id, apa_id, aps_id ) @ #n) ∧
  (Finish( 'U', session, u_id ) @ #i) ∧
  (Finish( 'PW', session, pw_id ) @ #j) ∧
  (Finish( 'MS', session, ms_id ) @ #k) ∧
  (Finish( 'APA', session, apa_id ) @ #l) ∧
  (Finish( 'APS', session, aps_id ) @ #m)"
*/
simplify
solve( !MerchantCreated( <$ms_id, ~app_id, $notify_url, ~m_sk> ) ▶₃ #n )
  case CreateMS
  solve( PW_State( 'created', 'null', $pw_id ) ▶₄ #n )
    case CreatePW
    solve( APA_State( 'created', 'null', $apa_id ) ▶₅ #n )
      case CreateAPA
      solve( !APS_PriKey( $aps_id, ~a_sk ) ▶₁ #n )
        case CreateAPS
        solve( !UserPassword( <$u_id, ~password> ) ▶₂ #n )
          case CreateU
          solve( Finish( 'U', ~session, $u_id ) @ #i )
            case UReceiveNotification
            solve( U_State( 'pwdsubmitted', ~session,
                            <$u_id, $pw_id, $apa_id, $aps_id, $ms_id, ~password, ~goods>
                   ) ▶₁ #i )
              case USubmitPasswordAPA
              solve( SOut( 'U-APA', ~session, $apa_id, $u_id,
                           <'AReqPwd', calc_amt(~goods), gen_desc(~goods), ~trade_no>
                     ) ▶₀ #vr.6 )
                case APAScanAndReqPwdU_case_1
                solve( SIn( 'U-APA', ~session, $apa_id, $u_id,
                            <'PaymentSuccessful', calc_amt(~goods), gen_desc(~goods)>
                       ) ▶₀ #i )
                  case SecureChannelSendRecv
                  solve( SOut( 'U-APA', ~session, $apa_id, $u_id,
                               <'PaymentSuccessful', calc_amt(~goods), gen_desc(~goods)>
                         ) ▶₀ #vr.10 )
                    case APAReceiveConfirmationAndNotifyU_case_2
                    solve( SOut( 'MS-APS', ~session.2, $ms_id.2, $aps_id,
                                 <~app_id.2, 
                                  <~out_trade_no, calc_amt(~goods), gen_desc(~goods), 'QR_CODE_OFFLINE'>, 
                                  sign(<~app_id.2, ~out_trade_no, calc_amt(~goods), gen_desc(~goods), 
                                        'QR_CODE_OFFLINE'>,
                                       ~m_sk.2)
                                 >
                           ) ▶₀ #vr.19 )
                      case MSPrecreateAPS
                      solve( SOut( 'MS-APS', ~session.1, $ms_id.1, $aps_id,
                                   <~app_id, 
                                    <~out_trade_no.1, calc_amt(~goods.1), gen_desc(~goods.1), 
                                     'QR_CODE_OFFLINE'>, 
                                    sign(<~app_id, ~out_trade_no.1, calc_amt(~goods.1), gen_desc(~goods.1), 
                                          'QR_CODE_OFFLINE'>,
                                         ~m_sk)
                                   >
                             ) ▶₀ #vr.23 )
                        case MSPrecreateAPS
                        solve( SOut( 'APA-APS', ~session, $aps_id, $apa_id,
                                     <<~app_id, ~out_trade_no, ~trade_no, calc_amt(~goods)>, 
                                      sign(<~app_id, ~out_trade_no, ~trade_no, calc_amt(~goods)>, ~a_sk)>
                               ) ▶₀ #vr.12 )
                          case APSVerifyPasswordAndConfirmAPAMS
                          solve( SOut( 'MS-APS', ~session, $ms_id, $aps_id,
                                       <~app_id, 
                                        <~out_trade_no.2, calc_amt(~goods.2), gen_desc(~goods.2), 
                                         'QR_CODE_OFFLINE'>, 
                                        sign(<~app_id, ~out_trade_no.2, calc_amt(~goods.2), 
                                              gen_desc(~goods.2), 'QR_CODE_OFFLINE'>,
                                             ~m_sk)
                                       >
                                 ) ▶₀ #vr.32 )
                            case MSPrecreateAPS
                            solve( SOut( 'U-APA', ~session, $u_id, $apa_id, ~password.1 ) ▶₀ #vr.14 )
                              case USubmitPasswordAPA
                              solve( SOut( 'APA-APS', ~session.1, $apa_id.1, $aps_id,
                                           <<calc_amt(~goods), gen_desc(~goods), ~trade_no>, h(~password)>
                                     ) ▶₀ #vr.15 )
                                case APASubmitPasswordAPS_case_1
                                solve( SOut( 'U-APA', ~session.1, $u_id, $apa_id.1, ~password
                                       ) ▶₀ #vr.35 )
                                  case USubmitPasswordAPA
                                  solve( SOut( 'U-APA', ~session.1, $apa_id.1, $u_id,
                                               <'AReqPwd', calc_amt(~goods.3), gen_desc(~goods.3), ~trade_no.3
                                               >
                                         ) ▶₀ #vr.39 )
                                    case APAScanAndReqPwdU
                                    solve( Finish( 'PW', ~session, $pw_id ) @ #j.3 )
                                      case PWOrderMS
                                      solve( PW_State( 'init', ~session,
                                                       <$pw_id, $u_id.1, $ms_id.2, $apa_id.1>
                                             ) ▶₁ #j.3 )
                                        case NewPaymentSession
                                        solve( SIn( 'U-PW', ~session, $u_id, $pw_id,
                                                    <'OpenAppAndOrder', ~goods.2>
                                               ) ▶₀ #j.3 )
                                          case SecureChannelSendRecv
                                          solve( SOut( 'U-PW', ~session, $u_id, $pw_id,
                                                       <'OpenAppAndOrder', ~goods.2>
                                                 ) ▶₀ #vr.26 )
                                            case UOpenAndOrderPW
                                            solve( Finish( 'MS', ~session, $ms_id ) @ #k )
                                              case MSReceiveNotification
                                              solve( MS_State( 'qrcodesent', ~session,
                                                               <$ms_id, $pw_id.1, $aps_id.1, $u_id.1, 
                                                                ~app_id.1, ~m_sk.1>
                                                     ) ▶₃ #k )
                                                case MSSendQRCodePW_case_2
                                                solve( SOut( 'MS-APS', ~session.2, $ms_id.2, $aps_id,
                                                             <~app_id.2, 
                                                              <~out_trade_no.3, calc_amt(~goods.2), 
                                                               gen_desc(~goods.2), 'QR_CODE_OFFLINE'>, 
                                                              sign(<~app_id.2, ~out_trade_no.3, 
                                                                    calc_amt(~goods.2), gen_desc(~goods.2), 
                                                                    'QR_CODE_OFFLINE'>,
                                                                   ~m_sk.2)
                                                             >
                                                       ) ▶₀ #vr.29 )
                                                  case MSPrecreateAPS
                                                  solve( SIn( 'MS-APS', ~session, $aps_id, $ms_id,
                                                              <
                                                               <~app_id, ~out_trade_no.1, ~trade_no.1, 
                                                                total_amount>, 
                                                               sign(<~app_id, ~out_trade_no.1, ~trade_no.1, 
                                                                     total_amount>,
                                                                    x)
                                                              >
                                                         ) ▶₁ #k )
                                                    case SecureChannelSendRecv
                                                    solve( SOut( 'MS-APS', ~session, $aps_id, $ms_id,
                                                                 <
                                                                  <~app_id, ~out_trade_no.1, ~trade_no.1, 
                                                                   total_amount>, 
                                                                  sign(<~app_id, ~out_trade_no.1, 
                                                                        ~trade_no.1, total_amount>,
                                                                       x)
                                                                 >
                                                           ) ▶₀ #vr.35 )
                                                      case APSVerifyPasswordAndConfirmAPAMS
                                                      solve( !APS_PubKey( $aps_id, pk(~a_sk) ) ▶₀ #k )
                                                        case CreateAPS
                                                        solve( SOut( 'MS-APS', ~session, $aps_id, $ms_id,
                                                                     <calc_amt(~goods.2), gen_desc(~goods.2), 
                                                                      ~trade_no.1>
                                                               ) ▶₀ #vr.28 )
                                                          case APSGenerateQRCodeMS
                                                          solve( !MS_Database( $ms_id, $user,
                                                                               <calc_amt(~goods), subject, 
                                                                                ~trade_no>,
                                                                               ~out_trade_no
                                                                 ) ▶₂ #k )
                                                            case MSSendQRCodePW
                                                            solve( SOut( 'MS-APS', ~session.1, $aps_id,
                                                                         $ms_id,
                                                                         <calc_amt(~goods), gen_desc(~goods), 
                                                                          ~trade_no>
                                                                   ) ▶₀ #vr.29 )
                                                              case APSGenerateQRCodeMS
                                                              solve( Finish( 'APA', ~session, $apa_id ) @ #l )
                                                                case APAReceiveConfirmationAndNotifyU
                                                                solve( APA_State( 'pwdsubmitted', ~session,
                                                                                  <$apa_id, $u_id.1, 
                                                                                   $pw_id.1, $aps_id.1, 
                                                                                   total_amount, subject, 
                                                                                   ~trade_no.1>
                                                                       ) ▶₂ #l )
                                                                  case APASubmitPasswordAPS
                                                                  solve( Finish( 'APS', ~session, $aps_id
                                                                         ) @ #m )
                                                                    case APSVerifyPasswordAndConfirmAPAMS
                                                                    solve( APS_State( 'precreated', ~session,
                                                                                      <$aps_id, $apa_id.1, 
                                                                                       $ms_id.1, $u_id.1, 
                                                                                       ~a_sk.1>
                                                                           ) ▶₄ #m )
                                                                      case APSGenerateQRCodeMS
                                                                      solve( SOut( 'PW-APA', ~session, $pw_id,
                                                                                   $apa_id,
                                                                                   <calc_amt(~goods), 
                                                                                    gen_desc(~goods), 
                                                                                    ~trade_no>
                                                                             ) ▶₀ #vr.9 )
                                                                        case PWShowQRCodeAPA_case_2
                                                                        solve( SOut( 'MS-APS', ~session.2,
                                                                                     $aps_id, $ms_id.1,
                                                                                     <calc_amt(~goods), 
                                                                                      gen_desc(~goods), 
                                                                                      ~trade_no>
                                                                               ) ▶₀ #vr.31 )
                                                                          case APSGenerateQRCodeMS
                                                                          solve( SOut( 'PW-MS', ~session.1,
                                                                                       $pw_id.1, $ms_id,
                                                                                       ~goods
                                                                                 ) ▶₀ #vr.18 )
                                                                            case PWOrderMS
                                                                            solve( SOut( 'U-PW', ~session.1,
                                                                                         $u_id, $pw_id.1,
                                                                                         <'OpenAppAndOrder', 
                                                                                          ~goods>
                                                                                   ) ▶₀ #vr.31 )
                                                                              case UOpenAndOrderPW
                                                                              solve( SOut( 'PW-MS', ~session,
                                                                                           $ms_id, $pw_id,
                                                                                           <calc_amt(~goods), 
                                                                                            gen_desc(~goods), 
                                                                                            ~trade_no>
                                                                                     ) ▶₀ #vr.21 )
                                                                                case MSSendQRCodePW
                                                                                SOLVED // trace found
                                                                              qed
                                                                            qed
                                                                          qed
                                                                        qed
                                                                      qed
                                                                    qed
                                                                  qed
                                                                qed
                                                              qed
                                                            qed
                                                          qed
                                                        qed
                                                      qed
                                                    qed
                                                  qed
                                                qed
                                              qed
                                            qed
                                          qed
                                        qed
                                      qed
                                    qed
                                  qed
                                qed
                              qed
                            qed
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma PS_MS_Order_Injective_Agreement [heuristic={default}]:
  all-traces
  "∀ ps ms o #i.
    (PS_Commit( 'PSAuthMS', ps, ms, o ) @ #i) ⇒
    (∃ #j.
      ((MS_Running( 'PSAuthMS', ms, ps, o ) @ #j) ∧ (#j < #i)) ∧
      (¬(∃ ps2 ms2 #i2.
          (PS_Commit( 'PSAuthMS', ps2, ms2, o ) @ #i2) ∧ (¬(#i2 = #i)))))"
/*
guarded formula characterizing all counter-examples:
"∃ ps ms o #i.
  (PS_Commit( 'PSAuthMS', ps, ms, o ) @ #i)
 ∧
  ∀ #j.
   (MS_Running( 'PSAuthMS', ms, ps, o ) @ #j)
  ⇒
   ((¬(#j < #i)) ∨
    (∃ ps2 ms2 #i2.
      (PS_Commit( 'PSAuthMS', ps2, ms2, o ) @ #i2) ∧ ¬(#i2 = #i)))"
*/
simplify
solve( APS_State( 'init', ~session,
                  <$aps_id, $apa_id, $ms_id, $u_id, ~a_sk>
       ) ▶₁ #i )
  case NewPaymentSession
  solve( SIn( 'MS-APS', ~session, $ms_id, $aps_id,
              <~app_id, <~out_trade_no, total_amount, subject, 'QR_CODE_OFFLINE'>, 
               sign(<~app_id, ~out_trade_no, total_amount, subject, 'QR_CODE_OFFLINE'>,
                    x)
              >
         ) ▶₀ #i )
    case SecureChannelSendRecv
    solve( SOut( 'MS-APS', ~session, $ms_id, $aps_id,
                 <~app_id, <~out_trade_no, total_amount, subject, 'QR_CODE_OFFLINE'>, 
                  sign(<~app_id, ~out_trade_no, total_amount, subject, 'QR_CODE_OFFLINE'>,
                       x)
                 >
           ) ▶₀ #vr.6 )
      case MSPrecreateAPS
      solve( !MerchantRegistered( <$ms_id, ~app_id, pk(~m_sk)> ) ▶₂ #i )
        case CreateMS
        solve( SIn( 'MS-APS', ~session.1, $ms_id.1, $aps_id.1,
                    <~app_id, 
                     <~out_trade_no, calc_amt(~goods), gen_desc(~goods), 'QR_CODE_OFFLINE'>, 
                     sign(<~app_id, ~out_trade_no, calc_amt(~goods), gen_desc(~goods), 
                           'QR_CODE_OFFLINE'>,
                          ~m_sk)
                    >
               ) ▶₀ #i2 )
          case SecureChannelSendRecv
          solve( !MerchantRegistered( <$ms_id.1, ~app_id, pk(~m_sk)> ) ▶₂ #i2 )
            case CreateMS
            solve( SOut( 'MS-APS', ~session.1, $ms_id, $aps_id.1,
                         <~app_id, 
                          <~out_trade_no, calc_amt(~goods), gen_desc(~goods), 'QR_CODE_OFFLINE'>, 
                          sign(<~app_id, ~out_trade_no, calc_amt(~goods), gen_desc(~goods), 
                                'QR_CODE_OFFLINE'>,
                               ~m_sk)
                         >
                   ) ▶₀ #vr.9 )
              case MSPrecreateAPS
              by contradiction /* from formulas */
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma U_MS_Order_Injective_Agreement [heuristic={default}]:
  all-traces
  "∀ u ms o #i.
    (U_Commit( 'UAuthMS', u, ms, o ) @ #i) ⇒
    (∃ #j.
      ((MS_Running( 'UAuthMS', ms, u, o ) @ #j) ∧ (#j < #i)) ∧
      (¬(∃ u2 ms2 #i2.
          (U_Commit( 'UAuthMS', u2, ms2, o ) @ #i2) ∧ (¬(#i2 = #i)))))"
/*
guarded formula characterizing all counter-examples:
"∃ u ms o #i.
  (U_Commit( 'UAuthMS', u, ms, o ) @ #i)
 ∧
  ∀ #j.
   (MS_Running( 'UAuthMS', ms, u, o ) @ #j)
  ⇒
   ((¬(#j < #i)) ∨
    (∃ u2 ms2 #i2. (U_Commit( 'UAuthMS', u2, ms2, o ) @ #i2) ∧ ¬(#i2 = #i)))"
*/
simplify
solve( U_Commit( 'UAuthMS', u, ms, o ) @ #i )
  case USubmitPasswordAPA
  solve( U_State( 'ordered', ~session,
                  <$u_id, $pw_id, $apa_id, $aps_id, $ms_id, ~password, ~goods>
         ) ▶₁ #i )
    case UOpenAndOrderPW
    solve( SIn( 'U-APA', ~session, $apa_id, $u_id,
                <'AReqPwd', calc_amt(~goods), gen_desc(~goods), ~trade_no>
           ) ▶₀ #i )
      case SecureChannelSendRecv
      solve( SOut( 'U-APA', ~session, $apa_id, $u_id,
                   <'AReqPwd', calc_amt(~goods), gen_desc(~goods), ~trade_no>
             ) ▶₀ #vr.7 )
        case APAScanAndReqPwdU_case_2
        solve( !KU( ~trade_no ) @ #vk.12 )
          case NewPaymentSession
          solve( !KU( calc_amt(~goods) ) @ #vk.10 )
            case breakChannelConfidentiality
            solve( SOut( 'MS-APS', ~session.3, $ms_id.4, $aps_id,
                         <~app_id.3, 
                          <~out_trade_no.1, calc_amt(~goods), gen_desc(~goods), 'QR_CODE_OFFLINE'
                          >, 
                          sign(<~app_id.3, ~out_trade_no.1, calc_amt(~goods), gen_desc(~goods), 
                                'QR_CODE_OFFLINE'>,
                               ~m_sk.3)
                         >
                   ) ▶₀ #vr.22 )
              case MSPrecreateAPS
              solve( SOut( 'U-PW', ~session.1, $u_id, $src,
                           <'OpenAppAndOrder', ~goods.1>
                     ) ▶₀ #vr.26 )
                case UOpenAndOrderPW
                solve( SOut( 'MS-APS', ~session.2, $aps_id, $ms_id.2,
                             <calc_amt(~goods), gen_desc(~goods), ~trade_no.1>
                       ) ▶₀ #vr.20 )
                  case APSGenerateQRCodeMS
                  solve( SOut( 'PW-APA', ~session.1, $src, $dst,
                               <calc_amt(~goods), gen_desc(~goods), ~trade_no.1>
                         ) ▶₀ #vr.14 )
                    case PWShowQRCodeAPA_case_2
                    solve( SOut( 'MS-APS', ~session.3, $aps_id, $ms_id.4,
                                 <calc_amt(~goods), gen_desc(~goods), ~trade_no.1>
                           ) ▶₀ #vr.33 )
                      case APSGenerateQRCodeMS
                      solve( SOut( 'PW-MS', ~session.1, $ms_id.1, $src,
                                   <calc_amt(~goods), gen_desc(~goods), ~trade_no.1>
                             ) ▶₀ #vr.18 )
                        case MSSendQRCodePW
                        solve( SOut( 'MS-APS', ~session.1, $aps_id, $ms_id.1,
                                     <calc_amt(~goods), gen_desc(~goods), ~trade_no.1>
                               ) ▶₀ #vr.34 )
                          case APSGenerateQRCodeMS
                          solve( SOut( 'PW-MS', ~session.1, $src, $ms_id.1, ~goods ) ▶₀ #vr.24 )
                            case PWOrderMS
                            solve( !KU( ~session ) @ #vk.9 )
                              case NewPaymentSession
                              solve( !KU( gen_desc(~goods) ) @ #vk.12 )
                                case breakChannelConfidentiality
                                solve( SOut( 'MS-APS', ~session.3, $ms_id.4, $aps_id,
                                             <~app_id.3, 
                                              <~out_trade_no.2, calc_amt(~goods), gen_desc(~goods), 
                                               'QR_CODE_OFFLINE'>, 
                                              sign(<~app_id.3, ~out_trade_no.2, calc_amt(~goods), 
                                                    gen_desc(~goods), 'QR_CODE_OFFLINE'>,
                                                   ~m_sk.3)
                                             >
                                       ) ▶₀ #vr.33 )
                                  case MSPrecreateAPS
                                  solve( SOut( 'U-PW', ~session.1, $u_id, $src,
                                               <'OpenAppAndOrder', ~goods.1>
                                         ) ▶₀ #vr.37 )
                                    case UOpenAndOrderPW
                                    solve( SOut( 'MS-APS', ~session.2, $aps_id, $ms_id.2,
                                                 <calc_amt(~goods), gen_desc(~goods), ~trade_no.2>
                                           ) ▶₀ #vr.31 )
                                      case APSGenerateQRCodeMS
                                      solve( SOut( 'PW-APA', ~session.1, $src, $dst,
                                                   <calc_amt(~goods), gen_desc(~goods), ~trade_no.2>
                                             ) ▶₀ #vr.24 )
                                        case PWShowQRCodeAPA_case_2
                                        solve( SOut( 'MS-APS', ~session.3, $aps_id, $ms_id.4,
                                                     <calc_amt(~goods), gen_desc(~goods), ~trade_no.2>
                                               ) ▶₀ #vr.44 )
                                          case APSGenerateQRCodeMS
                                          solve( SOut( 'PW-MS', ~session.1, $ms_id.1, $src,
                                                       <calc_amt(~goods), gen_desc(~goods), ~trade_no.2>
                                                 ) ▶₀ #vr.29 )
                                            case MSSendQRCodePW
                                            solve( SOut( 'MS-APS', ~session.1, $aps_id, $ms_id.1,
                                                         <calc_amt(~goods), gen_desc(~goods), ~trade_no.2>
                                                   ) ▶₀ #vr.45 )
                                              case APSGenerateQRCodeMS
                                              solve( SOut( 'PW-MS', ~session.1, $src, $ms_id.1, ~goods
                                                     ) ▶₀ #vr.35 )
                                                case PWOrderMS
                                                SOLVED // trace found
                                              qed
                                            qed
                                          qed
                                        qed
                                      qed
                                    qed
                                  qed
                                qed
                              qed
                            qed
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma MS_PS_Response_Injective_Agreement [heuristic={default}]:
  all-traces
  "∀ ms ps o #i.
    (MS_Commit( 'MSAuthPS', ms, ps, o ) @ #i) ⇒
    (∃ #j.
      ((PS_Running( 'MSAuthPS', ps, ms, o ) @ #j) ∧ (#j < #i)) ∧
      (¬(∃ ms2 ps2 #i2.
          (MS_Commit( 'MSAuthPS', ms2, ps2, o ) @ #i2) ∧ (¬(#i2 = #i)))))"
/*
guarded formula characterizing all counter-examples:
"∃ ms ps o #i.
  (MS_Commit( 'MSAuthPS', ms, ps, o ) @ #i)
 ∧
  ∀ #j.
   (PS_Running( 'MSAuthPS', ps, ms, o ) @ #j)
  ⇒
   ((¬(#j < #i)) ∨
    (∃ ms2 ps2 #i2.
      (MS_Commit( 'MSAuthPS', ms2, ps2, o ) @ #i2) ∧ ¬(#i2 = #i)))"
*/
simplify
solve( MS_State( 'qrcodesent', ~session,
                 <$ms_id, $pw_id, $aps_id, $u_id, ~app_id, ~m_sk>
       ) ▶₃ #i )
  case MSSendQRCodePW_case_1
  solve( SIn( 'MS-APS', ~session, $aps_id, $ms_id,
              <<~app_id, ~out_trade_no, ~trade_no, total_amount>, 
               sign(<~app_id, ~out_trade_no, ~trade_no, total_amount>, x)>
         ) ▶₁ #i )
    case SecureChannelSendRecv
    solve( SOut( 'MS-APS', ~session, $aps_id, $ms_id,
                 <<~app_id, ~out_trade_no, ~trade_no, total_amount>, 
                  sign(<~app_id, ~out_trade_no, ~trade_no, total_amount>, x)>
           ) ▶₀ #vr.11 )
      case APSVerifyPasswordAndConfirmAPAMS_case_1
      solve( MS_State( 'qrcodesent', ~session.1,
                       <$ms_id.3, $pw_id.1, $aps_id.1, $u_id.1, ~app_id, ~m_sk.3>
             ) ▶₃ #i2 )
        case MSSendQRCodePW_case_1
        solve( SOut( 'MS-APS', ~session, $ms_id, $aps_id,
                     <~app_id, 
                      <~out_trade_no.2, calc_amt(~goods), gen_desc(~goods), 'QR_CODE_OFFLINE'
                      >, 
                      sign(<~app_id, ~out_trade_no.2, calc_amt(~goods), gen_desc(~goods), 
                            'QR_CODE_OFFLINE'>,
                           ~m_sk)
                     >
               ) ▶₀ #vr.17 )
          case MSPrecreateAPS
          solve( SIn( 'MS-APS', ~session.1, $aps_id, $ms_id,
                      <<~app_id, ~out_trade_no, ~trade_no, total_amount>, 
                       sign(<~app_id, ~out_trade_no, ~trade_no, total_amount>, x)>
                 ) ▶₁ #i2 )
            case SecureChannelSendRecv
            solve( SOut( 'MS-APS', ~session.1, $aps_id, $ms_id,
                         <<~app_id, ~out_trade_no, ~trade_no, total_amount>, 
                          sign(<~app_id, ~out_trade_no, ~trade_no, total_amount>, x)>
                   ) ▶₀ #vr.26 )
              case APSVerifyPasswordAndConfirmAPAMS
              solve( (¬(#vr.27 < #i))  ∥
                     (∃ ms2 ps2 #i2.
                       (MS_Commit( 'MSAuthPS', ms2, ps2,
                                   <~app_id, ~out_trade_no, ~trade_no, total_amount>
                        ) @ #i2)
                      ∧
                       ¬(#i2 = #i)) )
                case case_1
                solve( SOut( 'MS-APS', ~session.1, $ms_id, $aps_id,
                             <~app_id, 
                              <~out_trade_no.4, calc_amt(~goods.1), gen_desc(~goods.1), 
                               'QR_CODE_OFFLINE'>, 
                              sign(<~app_id, ~out_trade_no.4, calc_amt(~goods.1), gen_desc(~goods.1), 
                                    'QR_CODE_OFFLINE'>,
                                   ~m_sk)
                             >
                       ) ▶₀ #vr.30 )
                  case MSPrecreateAPS
                  solve( !APS_PubKey( $aps_id, pk(~a_sk) ) ▶₀ #i )
                    case CreateAPS
                    solve( !APS_PubKey( $aps_id, pk(~a_sk) ) ▶₀ #i2 )
                      case CreateAPS
                      by solve( SOut( 'MS-APS', ~session, $aps_id, $ms_id,
                                      <total_amount.1, subject.2, ~trade_no.1>
                                ) ▶₀ #vr.1 )
                    qed
                  qed
                qed
              next
                case case_2
                solve( SOut( 'MS-APS', ~session.1, $ms_id, $aps_id,
                             <~app_id, 
                              <~out_trade_no.4, calc_amt(~goods.1), gen_desc(~goods.1), 
                               'QR_CODE_OFFLINE'>, 
                              sign(<~app_id, ~out_trade_no.4, calc_amt(~goods.1), gen_desc(~goods.1), 
                                    'QR_CODE_OFFLINE'>,
                                   ~m_sk)
                             >
                       ) ▶₀ #vr.30 )
                  case MSPrecreateAPS
                  solve( !APS_PubKey( $aps_id, pk(~a_sk) ) ▶₀ #i )
                    case CreateAPS
                    solve( !APS_PubKey( $aps_id, pk(~a_sk) ) ▶₀ #i2 )
                      case CreateAPS
                      by solve( SOut( 'MS-APS', ~session, $aps_id, $ms_id,
                                      <total_amount.1, subject.2, ~trade_no.1>
                                ) ▶₀ #vr.1 )
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      next
        case MSSendQRCodePW_case_2
        solve( SOut( 'MS-APS', ~session, $ms_id, $aps_id,
                     <~app_id, 
                      <~out_trade_no.2, calc_amt(~goods), gen_desc(~goods), 'QR_CODE_OFFLINE'
                      >, 
                      sign(<~app_id, ~out_trade_no.2, calc_amt(~goods), gen_desc(~goods), 
                            'QR_CODE_OFFLINE'>,
                           ~m_sk)
                     >
               ) ▶₀ #vr.17 )
          case MSPrecreateAPS
          solve( SOut( 'MS-APS', ~session.2, $ms_id.2, $aps_id,
                       <~app_id.2, 
                        <~out_trade_no.3, calc_amt(~goods), gen_desc(~goods), 'QR_CODE_OFFLINE'
                        >, 
                        sign(<~app_id.2, ~out_trade_no.3, calc_amt(~goods), gen_desc(~goods), 
                              'QR_CODE_OFFLINE'>,
                             ~m_sk.2)
                       >
                 ) ▶₀ #vr.25 )
            case MSPrecreateAPS
            solve( SIn( 'MS-APS', ~session.1, $aps_id, $ms_id,
                        <<~app_id, ~out_trade_no, ~trade_no, total_amount>, 
                         sign(<~app_id, ~out_trade_no, ~trade_no, total_amount>, x)>
                   ) ▶₁ #i2 )
              case SecureChannelSendRecv
              solve( SOut( 'MS-APS', ~session.1, $aps_id, $ms_id,
                           <<~app_id, ~out_trade_no, ~trade_no, total_amount>, 
                            sign(<~app_id, ~out_trade_no, ~trade_no, total_amount>, x)>
                     ) ▶₀ #vr.31 )
                case APSVerifyPasswordAndConfirmAPAMS
                solve( (¬(#vr.32 < #i))  ∥
                       (∃ ms2 ps2 #i2.
                         (MS_Commit( 'MSAuthPS', ms2, ps2,
                                     <~app_id, ~out_trade_no, ~trade_no, total_amount>
                          ) @ #i2)
                        ∧
                         ¬(#i2 = #i)) )
                  case case_1
                  solve( SOut( 'MS-APS', ~session.1, $ms_id, $aps_id,
                               <~app_id, 
                                <~out_trade_no.4, calc_amt(~goods.2), gen_desc(~goods.2), 

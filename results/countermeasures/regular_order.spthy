              case MSSendPrepayidMF
              solve( SOut( 'U-MF', ~session, $u_id, $mf_id,
                           <'OpenAppAndOrder', ~goods.2>
                     ) ▶₀ #vr.13 )
                case UOpenAndOrderMF
                solve( SOut( 'U-MF', ~session.1, $u_id, $src,
                             <'OpenAppAndOrder', ~goods.3>
                       ) ▶₀ #vr.26 )
                  case UOpenAndOrderMF
                  by solve( SOut( 'MS-PS', ~session.1, $dst, $ms_id, ~prepay_id
                            ) ▶₀ #vr.29 )
                qed
              qed
            next
              case breakChannelConfidentiality
              solve( SOut( 'MF-MS', ~session.1, $ms_id, $src,
